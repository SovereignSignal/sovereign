# connectors/harness/notion/mirror.env.example
# sov connect notion writes ~/.notion-mirror/mirror.env for you. This shows every key it understands.
NOTION_API_KEY=secret_paste_your_internal_integration_token_here
# BRAIN_ROOT=/path/to/your/vault        # written by the installer; only needed by hand when ~/.brain-root is not set
# NOTION_LANE=raw/tools/Notion
# NOTION_VERSION=2026-03-11
# NOTION_MIN_INTERVAL=0.34   # seconds between requests; raise it if Notion or its CDN starts challenging the address
# NOTION_FILES=fetch                    # fetch | skip
# NOTION_SHRINK_FLOOR=90                # refuse a run that would delete more than 10% of tracked items
# NOTION_ALLOW_SHRINK=0                 # 1 = override the floor once
# Secrets are redacted by shape in every page and CSV before writing (lib/brain_redact.py); nothing depends on a page's name.
# NOTION_EXCLUDE_TITLES=                # optional: never mirror a page or database whose title holds one of these whole-word phrases, nor anything
#                                       # under it; a one-line marker stands in. Start from: key management, credentials, creds, secrets, passwords, api keys
# NOTION_EXCLUDE_IDS=                   # optional: comma-separated page or database ids to keep out outright
# NOTION_SECRET_SCAN=                   # the vault's scanner, run after every run as the check (default: cron-wrappers/vault-secret-scan.sh beside the mirror's bin, when present; `off` disables)
