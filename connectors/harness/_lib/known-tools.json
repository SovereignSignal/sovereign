{
 "_": "Tools the status can recognize on a machine. `connector` names the harness folder when one exists. `detect` paths mean the tool is installed. Add a row when a new tool appears; a connector can follow later.",
 "tools": [
  {
   "id": "claude-code",
   "name": "Claude Code",
   "connector": "claude-code",
   "detect": [
    "~/.claude"
   ]
  },
  {
   "id": "codex",
   "name": "Codex",
   "connector": "codex",
   "detect": [
    "~/.codex"
   ]
  },
  {
   "id": "cursor",
   "name": "Cursor",
   "connector": "cursor",
   "detect": [
    "~/.cursor",
    "~/Library/Application Support/Cursor"
   ]
  },
  {
   "id": "cowork",
   "name": "Cowork (Claude Desktop)",
   "connector": "cowork",
   "detect": [
    "~/Library/Application Support/Claude/local-agent-mode-sessions"
   ]
  },
  {
   "id": "hermes",
   "name": "Hermes agent",
   "connector": "hermes",
   "detect": [
    "~/.hermes/config.yaml"
   ],
   "note": "a pre_llm_call hook injects the pack on the first turn of a conversation; MEMORY.md and USER.md are mirrored"
  },
  {
   "id": "hermes-desktop",
   "name": "Hermes desktop app",
   "connector": "hermes",
   "detect": [
    "~/.hermes/hermes-agent/apps/desktop",
    "/Applications/Hermes.app"
   ],
   "note": "same install as the Hermes agent; the desktop app is a window onto it"
  },
  {
   "id": "gemini-cli",
   "name": "Gemini CLI",
   "connector": null,
   "detect": [
    "~/.gemini"
   ]
  },
  {
   "id": "opencode",
   "name": "OpenCode",
   "connector": null,
   "detect": [
    "~/.config/opencode",
    "~/.opencode"
   ]
  },
  {
   "id": "aider",
   "name": "Aider",
   "connector": null,
   "detect": [
    "~/.aider.conf.yml",
    "~/.aider"
   ]
  },
  {
   "id": "continue",
   "name": "Continue",
   "connector": null,
   "detect": [
    "~/.continue"
   ]
  },
  {
   "id": "windsurf",
   "name": "Windsurf",
   "connector": "windsurf",
   "detect": [
    "~/.codeium/windsurf",
    "~/Library/Application Support/Windsurf"
   ]
  },
  {
   "id": "zed",
   "name": "Zed",
   "connector": null,
   "detect": [
    "~/.config/zed"
   ]
  },
  {
   "id": "copilot-cli",
   "name": "GitHub Copilot CLI",
   "connector": null,
   "detect": [
    "~/.copilot"
   ]
  },
  {
   "id": "vscode",
   "name": "VS Code",
   "connector": null,
   "detect": [
    "~/Library/Application Support/Code",
    "~/.config/Code"
   ]
  },
  {
   "id": "chatgpt-desktop",
   "name": "ChatGPT desktop",
   "connector": null,
   "detect": [
    "~/Library/Application Support/com.openai.chat"
   ],
   "note": "keeps no memory on disk (conversations live in the cloud); the Codex it bundles is the connectable part and is already a connector"
  },
  {
   "id": "obsidian",
   "name": "Obsidian",
   "connector": null,
   "detect": [
    "~/Library/Application Support/obsidian",
    "~/.config/obsidian"
   ],
   "note": "the vault's own reader; the console uses its CLI for sync state and Open in Obsidian, nothing to mirror"
  },
  {
   "id": "notion",
   "name": "Notion",
   "connector": "notion",
   "detect": []
  }
 ]
}