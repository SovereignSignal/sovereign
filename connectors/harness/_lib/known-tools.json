{
 "_": "Known tools and producer connectors. Detection is evidence of local software or saved configuration, not an active connection. Discovery never opens session or configuration contents.",
 "tools": [
  {
   "id": "claude-code",
   "name": "Claude Code",
   "connector": "claude-code",
   "detect": [
    "~/.claude"
   ],
   "commands": [
    "claude"
   ]
  },
  {
   "id": "codex",
   "name": "Codex",
   "connector": "codex",
   "detect": [
    "~/.codex"
   ],
   "apps": [
    "Codex.app"
   ],
   "commands": [
    "codex"
   ]
  },
  {
   "id": "cursor",
   "name": "Cursor",
   "connector": "cursor",
   "detect": [
    "~/.cursor",
    "~/Library/Application Support/Cursor"
   ],
   "apps": [
    "Cursor.app"
   ],
   "commands": [
    "cursor"
   ]
  },
  {
   "id": "cowork",
   "name": "Cowork (Claude Desktop)",
   "connector": "cowork",
   "detect": [
    "~/Library/Application Support/Claude/local-agent-mode-sessions"
   ],
   "apps": [
    "Claude.app"
   ]
  },
  {
   "id": "hermes",
   "name": "Hermes agent",
   "connector": "hermes",
   "detect": [
    "~/.hermes/config.yaml"
   ],
   "note": "a pre_llm_call hook injects the pack on the first turn of a conversation; MEMORY.md and USER.md are mirrored",
   "commands": [
    "hermes"
   ]
  },
  {
   "id": "hermes-desktop",
   "name": "Hermes desktop app",
   "connector": "hermes",
   "detect": [
    "~/.hermes/hermes-agent/apps/desktop",
    "/Applications/Hermes.app"
   ],
   "note": "same install as the Hermes agent; the desktop app is a window onto it",
   "apps": [
    "Hermes.app"
   ]
  },
  {
   "id": "gemini-cli",
   "name": "Gemini CLI",
   "connector": null,
   "detect": [
    "~/.gemini"
   ],
   "commands": [
    "gemini"
   ]
  },
  {
   "id": "opencode",
   "name": "OpenCode",
   "connector": null,
   "detect": [
    "~/.config/opencode",
    "~/.opencode"
   ],
   "commands": [
    "opencode"
   ]
  },
  {
   "id": "aider",
   "name": "Aider",
   "connector": null,
   "detect": [
    "~/.aider.conf.yml",
    "~/.aider"
   ],
   "commands": [
    "aider"
   ]
  },
  {
   "id": "continue",
   "name": "Continue",
   "connector": null,
   "detect": [
    "~/.continue"
   ]
  },
  {
   "id": "windsurf",
   "name": "Windsurf",
   "connector": "windsurf",
   "detect": [
    "~/.codeium/windsurf",
    "~/Library/Application Support/Windsurf"
   ],
   "apps": [
    "Windsurf.app"
   ],
   "commands": [
    "windsurf"
   ]
  },
  {
   "id": "zed",
   "name": "Zed",
   "connector": null,
   "detect": [
    "~/.config/zed"
   ],
   "apps": [
    "Zed.app"
   ],
   "commands": [
    "zed"
   ]
  },
  {
   "id": "copilot-cli",
   "name": "GitHub Copilot CLI",
   "connector": null,
   "detect": [
    "~/.copilot"
   ],
   "commands": [
    "copilot"
   ]
  },
  {
   "id": "vscode",
   "name": "VS Code",
   "connector": null,
   "detect": [
    "~/Library/Application Support/Code",
    "~/.config/Code"
   ],
   "apps": [
    "Visual Studio Code.app"
   ],
   "commands": [
    "code"
   ]
  },
  {
   "id": "chatgpt-desktop",
   "name": "ChatGPT desktop",
   "connector": null,
   "detect": [
    "~/Library/Application Support/com.openai.chat"
   ],
   "note": "keeps no memory on disk (conversations live in the cloud); the Codex it bundles is the connectable part and is already a connector",
   "apps": [
    "ChatGPT.app"
   ]
  },
  {
   "id": "obsidian",
   "name": "Obsidian",
   "connector": null,
   "detect": [
    "~/Library/Application Support/obsidian",
    "~/.config/obsidian"
   ],
   "note": "the vault's own reader; the console uses its CLI for sync state and Open in Obsidian, nothing to mirror",
   "apps": [
    "Obsidian.app"
   ]
  },
  {
   "id": "notion",
   "name": "Notion",
   "connector": "notion",
   "detect": [],
   "cloud": true
  },
  {
   "id": "orca",
   "name": "Orca",
   "connector": "orca",
   "detect": [
    "/Applications/Orca.app",
    "~/.orca"
   ],
   "note": "orchestrates other coding agents; its runs, tasks, decision gates and questions are exported from orchestration.db",
   "apps": [
    "Orca.app"
   ],
   "commands": [
    "orca"
   ]
  },
  {
   "id": "parallels",
   "name": "Parallels Desktop guests",
   "connector": "parallels",
   "detect": [
    "/usr/local/bin/prlctl",
    "/Applications/Parallels Desktop.app"
   ],
   "note": "Linux guests with Claude Code or Claude Desktop inside; the host pulls their memory and outputs through prlctl, one folder per guest",
   "apps": [
    "Parallels Desktop.app"
   ],
   "commands": [
    "prlctl"
   ]
  }
 ]
}
