#!/usr/bin/env python3
"""brain-audit — the weekly auditor: a propose-only quality pass over the TRUSTED layer.

The nightly curator guards what goes IN; this guards what is already INSIDE.
Deterministic checks first (no model):
  labels        every knowledge note has valid type/source/created, type matches its folder
  one-screen    briefing cards, never articles (line/byte ceilings)
  flatness      knowledge/entities|concepts|syntheses never grow deeper
  links         broken [[links]], raw-style link targets, inbound-orphan cards
  duplicates    near-duplicate slug/title clusters (same normalizer the nightly uses)
  staleness     cards whose deadline-ish lines cite already-past dates
  drift         raw/ lanes on disk that the law (CLAUDE.md) never names; gear state
  workstreams   missing/stale front doors (overview.md + log.md)

Then two LOCAL-inference passes (owner-controlled compute, per the law):
  retro-taste   unscreened knowledge cards judged against taste.md — does the trusted
                layer still satisfy the owner's CURRENT taste rules?
  skip-audit    second opinion on a sample of the nightly judge's recent skips, so a
                different model counter-balances the primary's default-no

Everything lands as ONE dated report in the curator's lane (audit/), and the run
prints a short summary block for the digest relay. This script NEVER edits
knowledge/ — recommendations go through the same owner gate as everything else.

Config via env (defaults mirror curator-run):
  SOVS_VAULT / ~/.brain-root     vault root
  CURATOR_LANE / ~/.curator-lane lane name (default "curator")
  CURATOR_ENDPOINT               OpenAI-compatible endpoint (default: LOCAL Ollama)
  CURATOR_AUDIT_MODEL            model for the audit passes (default: CURATOR_MODEL, then qwen3.8:27b)
  CURATOR_PROFILE / CURATOR_TASTE  same owner files the nightly judge reads

Usage: brain-audit [--no-llm] [--max-screen N] [--max-skips N] [--stale-grace DAYS] [--ws-stale DAYS]
"""
import os, re, json, glob, sys, argparse, hashlib, urllib.request, urllib.parse, ast, time
from datetime import datetime, timezone, date, timedelta

def _pointer(path):
    try:
        return open(os.path.expanduser(path), encoding="utf-8").read().strip() or None
    except OSError:
        return None

VAULT = os.environ.get("SOVS_VAULT") or _pointer("~/.brain-root") or os.getcwd()
LANE_NAME = os.environ.get("CURATOR_LANE") or _pointer("~/.curator-lane") or "curator"
LANE = os.path.join(VAULT, "raw", "workspaces", LANE_NAME)
K = os.path.join(VAULT, "knowledge")
WS = os.path.join(VAULT, "workstreams")
AUDIT_DIR = os.path.join(LANE, "audit")
SCREENED = os.path.join(LANE, ".audit-screened.json")
SKIPMARK = os.path.join(LANE, ".audit-skipmark.json")
HISTMARK = os.path.join(LANE, ".audit-historicized.json")
JUDGMENTS = os.path.join(LANE, "judgments.jsonl")
ENDPOINT = os.environ.get("CURATOR_ENDPOINT", "http://localhost:11434/v1/chat/completions")
MODEL = os.environ.get("CURATOR_AUDIT_MODEL") or os.environ.get("CURATOR_MODEL", "qwen3.8:27b")
KEYFILE = os.environ.get("CURATOR_KEYFILE", "")
KEY = open(KEYFILE).read().strip() if KEYFILE and os.path.exists(KEYFILE) else os.environ.get("CURATOR_KEY", "")
PROFILE = os.environ.get("CURATOR_PROFILE", os.path.join(LANE, "profile.md"))
TASTE = os.environ.get("CURATOR_TASTE", os.path.join(LANE, "taste.md"))


def _inference_guard():
    """Lift curator-run's _inference_violations and reuse it verbatim.

    The law is one rule, so it gets one predicate. A second copy here would drift
    from curator-run's at exactly the edges that matter (what counts as a local
    host, which model ids read as hosted), and the drift would be invisible until
    the day it mattered. curator-run has no __main__ guard and evaluates its own
    guard at module level, so importing it would run that and can SystemExit(4)
    inside this process -- instead parse its AST and exec only this one function
    node. That reads curator-run without importing or modifying it.

    Fails CLOSED. If the shared predicate cannot be lifted (renamed, moved,
    refactored), this refuses to run rather than silently falling back to a local
    copy. A weekly propose-only audit is cheap to fail loudly; an unnoticed
    divergence is the exact hole the guard exists to close.
    """
    srcp = os.path.join(os.path.dirname(os.path.realpath(__file__)), "curator-run")
    with open(srcp, encoding="utf-8") as fh:
        tree = ast.parse(fh.read(), filename=srcp)
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and node.name == "_inference_violations":
            ns = {"urllib": urllib}
            exec(compile(ast.Module(body=[node], type_ignores=[]), srcp, "exec"), ns)
            return ns["_inference_violations"]
    raise RuntimeError("curator-run exposes no _inference_violations to reuse")


# The audit reads knowledge/ -- trusted, vault-derived content -- and feeds it to a
# model, so it sits squarely inside the curation path the sovereign-inference law
# governs. curator-run has enforced this since 2026-08-28; this closes the same hole
# here. Checked BEFORE the model lock, so a violating run never queues for the GPU.
#
# Only the RESOLVED model is checked, not both env vars: brain-audit sends exactly
# one model (CURATOR_AUDIT_MODEL when set, else CURATOR_MODEL), and flagging an
# unused CURATOR_MODEL would refuse a run that is in fact entirely local.
_AUDIT_MODEL_VAR = "CURATOR_AUDIT_MODEL" if os.environ.get("CURATOR_AUDIT_MODEL") else "CURATOR_MODEL"
_ALLOW_REMOTE = os.environ.get("CURATOR_ALLOW_REMOTE", "").strip().lower() in ("1", "on", "true", "yes")
try:
    _violations = _inference_guard()(ENDPOINT, MODEL, None, _ALLOW_REMOTE)
except Exception as _exc:
    print("brain-audit: REFUSING - could not load the shared sovereign-inference guard "
          "from curator-run (%s). Refusing rather than auditing unverified." % _exc,
          file=sys.stderr)
    raise SystemExit(4)
if _violations:
    for _v in _violations:
        print("brain-audit: REFUSING - sovereign-inference law: %s"
              % _v.replace("CURATOR_MODEL", _AUDIT_MODEL_VAR), file=sys.stderr)
    print("brain-audit: set CURATOR_ALLOW_REMOTE=1 only as a deliberate owner decision "
          "for non-vault work; the audit reads knowledge/ and must stay on owned inference.",
          file=sys.stderr)
    raise SystemExit(4)
if _ALLOW_REMOTE:
    print("brain-audit: WARNING - CURATOR_ALLOW_REMOTE is set; inference locality is NOT enforced")



ap = argparse.ArgumentParser()
ap.add_argument("--no-llm", action="store_true", help="deterministic checks only")
ap.add_argument("--max-screen", type=int, default=20, help="retro-taste: cards screened per run")
ap.add_argument("--max-skips", type=int, default=8, help="skip-audit: skipped judgments re-examined per run")
ap.add_argument("--max-historicize", type=int, default=6, help="stale cards redrafted as dated history per run")
ap.add_argument("--stale-grace", type=int, default=14, help="days past a deadline before it counts as stale")
ap.add_argument("--ws-stale", type=int, default=21, help="days without a log.md touch before a workstream counts dormant")
a = ap.parse_args()


def _model_lock(job):
    """Serialize model jobs across scripts (curator runs, the weekly audit, ad-hoc
    backfills). Two jobs sharing the single local-inference slot push each other's
    waits past the client timeout and turn judgments into recorded errors
    (2026-08-21: a curator/nightly collision lost 26 of 33 judgments this way).
    Blocking wait with a 4h deadline; past it, exit nonzero so the cron wrapper
    alerts instead of a silent stall. The returned handle must stay referenced
    for the life of the run."""
    import fcntl
    d = os.path.expanduser("~/.local/state/sovs-cron")
    os.makedirs(d, exist_ok=True)
    fh = open(os.path.join(d, "model.lock"), "a+")
    deadline = time.time() + 4 * 3600
    waited = False
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fh.seek(0)
            fh.truncate()
            fh.write("%s pid %d since %s\n" % (job, os.getpid(), time.strftime("%F %T")))
            fh.flush()
            if waited:
                print("%s: model lock acquired, proceeding" % job)
            return fh
        except OSError:
            if not waited:
                try:
                    holder = open(fh.name).read().strip()
                except OSError:
                    holder = ""
                print("%s: model busy (%s); waiting" % (job, holder or "unknown holder"))
                waited = True
            if time.time() > deadline:
                print("%s: gave up waiting for the model lock after 4h" % job, file=sys.stderr)
                raise SystemExit(3)
            time.sleep(60)

if not a.no_llm:
    _MODEL_LOCK = _model_lock("brain-audit")

TODAY = date.today()
findings = {}          # section -> [lines]
def add(section, line):
    findings.setdefault(section, []).append(line)

def rel(p):
    return os.path.relpath(p, VAULT)

# ---------- gather the trusted layer ----------
TYPE_DIRS = {"entity": "entities", "concept": "concepts", "synthesis": "syntheses",
             # added to Part 1 2026-09-04; homed with the syntheses, no new folder
             "plan": "syntheses", "review": "syntheses"}
cards = sorted(glob.glob(K + "/**/*.md", recursive=True))
slugs = {os.path.basename(p)[:-3] for p in cards}
cross_layer_slugs = {
    os.path.basename(p)[:-3]
    for base in (WS, os.path.join(VAULT, "archive"))
    for p in glob.glob(base + "/**/*.md", recursive=True)
}

def frontmatter(text):
    if not text.startswith("---"):
        return None
    end = text.find("\n---", 3)
    if end == -1:
        return None
    fm = {}
    for line in text[3:end].strip().splitlines():
        m = re.match(r"^(\w[\w-]*):\s*(.*)$", line)
        if m:
            fm[m.group(1)] = m.group(2).strip()
    return fm

# ---------- 1+2+3: labels, one-screen, flatness ----------
for sub in sorted(set(TYPE_DIRS.values())):
    d = os.path.join(K, sub)
    if os.path.isdir(d):
        deep = [x for x in glob.glob(d + "/*/") ]
        for x in deep:
            add("flatness", f"- `{rel(x)}` — subdirectory inside knowledge/{sub}/ (the law: never grows deeper)")

texts = {}
for p in cards:
    try:
        t = open(p, encoding="utf-8", errors="ignore").read()
    except OSError:
        continue
    texts[p] = t
    fm = frontmatter(t)
    if not fm:
        add("labels", f"- `{rel(p)}` — no label block")
        continue
    for req in ("type", "source", "created"):
        if not fm.get(req):
            add("labels", f"- `{rel(p)}` — missing required label: {req}")
    typ = fm.get("type", "")
    sub = os.path.basename(os.path.dirname(p))
    if typ in TYPE_DIRS and TYPE_DIRS[typ] != sub:
        add("labels", f"- `{rel(p)}` — type '{typ}' but lives in {sub}/")
    body = t[t.find("\n---", 3) + 4 :] if t.startswith("---") else t
    nlines = len([l for l in body.splitlines() if l.strip()])
    if nlines > 40 or len(body) > 6000:
        add("one-screen", f"- `{rel(p)}` — {nlines} non-empty lines / {len(body)} bytes (target: one screen)")

# ---------- 4: link graph ----------
WIKI = re.compile(r"\[\[([^\]|#]+?)(?:\|[^\]]*?)?\]\]")
RAWISH = re.compile(r"(_|^reference-|^feedback-|^project-|^20\d\d-)")
inbound = {s: 0 for s in slugs}
outbound = {s: 0 for s in slugs}
for p, t in texts.items():
    me = os.path.basename(p)[:-3]
    for tgt in set(WIKI.findall(t)):
        tgt = tgt.strip()
        if "/" in tgt:
            # a path-form link (folder/slug), the form Obsidian needs when two cards share a slug
            if os.path.exists(os.path.join(VAULT, tgt + ".md")) or os.path.exists(os.path.join(VAULT, tgt)):
                tgt = os.path.basename(tgt)
                if tgt in slugs and tgt != me:
                    inbound[tgt] += 1
                    outbound[me] = outbound.get(me, 0) + 1
                continue
        if tgt in slugs:
            if tgt != me:
                inbound[tgt] += 1
                outbound[me] = outbound.get(me, 0) + 1
        elif tgt in cross_layer_slugs:
            # Valid workstream/archive target. It does not add a trusted-graph edge.
            pass
        elif RAWISH.search(tgt.lower()):
            add("links", f"- `{rel(p)}` — [[{tgt}]] targets a raw-style filename (loading dock, not a card)")
        else:
            add("links", f"- `{rel(p)}` — broken link [[{tgt}]]")
# true orphan = no inbound AND no outbound (fully cut off). Cards that link out but
# are never linked TO are "sink-only leaves" — usually healthy, reported as a count.
orphans = sorted(s for s in slugs if not inbound[s] and not outbound.get(s))
sink_only = sum(1 for s in slugs if not inbound[s] and outbound.get(s))
if orphans:
    add("orphans", f"- {len(orphans)} fully isolated card(s) (no links in either direction): "
        + ", ".join(orphans[:20]) + (" …" if len(orphans) > 20 else ""))
if sink_only:
    add("orphans", f"- {sink_only} sink-only leaf card(s) link out but are never linked to (informational; weave only if a hub should own them)")

# ---------- 5: near-duplicate clusters ----------
def norm(s):
    return re.sub(r"[^a-z0-9]", "", s.lower())
by_key = {}
for s in slugs:
    by_key.setdefault(norm(s), []).append(s)
titles = {}
for p, t in texts.items():
    fm = frontmatter(t) or {}
    ttl = norm(fm.get("title", ""))
    if ttl:
        titles.setdefault(ttl, []).append(os.path.basename(p)[:-3])
clusters = set()
for k, group in by_key.items():
    if len(group) > 1:
        clusters.add(tuple(sorted(group)))
keys = sorted(by_key)
for i, k1 in enumerate(keys):
    if len(k1) < 12:
        continue
    for k2 in keys[i + 1 :]:
        if len(k2) >= 12 and (k1 in k2 or k2 in k1):
            clusters.add(tuple(sorted(by_key[k1] + by_key[k2])))
# token-overlap pass: slugs sharing most of their meaningful words are usually the
# same subject under different phrasings (e.g. x-funding-framework vs
# x-funding-coordination-framework). Report-only; intended entity/concept splits
# will show up too — the owner skims and moves on.
tok = {s: {w for w in s.split("-") if len(w) >= 3} for s in slugs}
slug_list = sorted(slugs)
for i, s1 in enumerate(slug_list):
    t1 = tok[s1]
    if len(t1) < 2:
        continue
    for s2 in slug_list[i + 1 :]:
        t2 = tok[s2]
        if len(t2) < 2:
            continue
        inter = len(t1 & t2)
        if inter >= 2 and inter / len(t1 | t2) >= 0.6:
            clusters.add(tuple(sorted((s1, s2))))
for ttl, group in titles.items():
    if len(group) > 1:
        clusters.add(tuple(sorted(group)))
# blessed pairs: deliberate keep-both rulings the owner has made — skip them.
blessed = set()
try:
    import json as _json
    _b = _json.load(open(os.path.join(LANE, ".audit-blessed-dups.json")))
    for pair in _b.get("pairs", []):
        blessed.add(tuple(sorted(pair)))
except (OSError, ValueError):
    pass
for c in sorted(clusters):
    if tuple(sorted(c)) in blessed:
        continue
    add("duplicates", "- possible same-subject cluster: " + " · ".join(f"`{s}`" for s in c))

# ---------- 6: staleness (deadline-ish lines citing past dates) ----------
MONTHS = {m: i + 1 for i, m in enumerate(
    ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"])}
DEADLINEISH = re.compile(r"deadline|apply by|applications? (close|due)|closes on|due (by|date)|expires?|until|review period|comment period", re.I)
D_ISO = re.compile(r"\b(20\d\d)-(\d\d)-(\d\d)\b")
D_DMY = re.compile(r"\b([0-3]?\d)\s+(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\w*\s+(20\d\d)\b", re.I)
D_MDY = re.compile(r"\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\w*\s+([0-3]?\d),?\s+(20\d\d)\b", re.I)

def line_dates(line):
    out = []
    for y, mo, dd in D_ISO.findall(line):
        out.append((int(y), int(mo), int(dd)))
    for dd, mo, y in D_DMY.findall(line):
        out.append((int(y), MONTHS[mo.lower()[:3]], int(dd)))
    for mo, dd, y in D_MDY.findall(line):
        out.append((int(y), MONTHS[mo.lower()[:3]], int(dd)))
    valid = []
    for y, mo, dd in out:
        try:
            valid.append(date(y, mo, dd))
        except ValueError:
            pass
    return valid

grace = timedelta(days=a.stale_grace)
# historicize memory: cards already rewritten as dated history carry past dates on
# purpose — record, not rot. Their exact content hash is remembered; they neither
# flag as stale nor re-enter the redraft pass until the card changes again.
try:
    histmark = json.load(open(HISTMARK, encoding="utf-8"))
except (OSError, ValueError):
    histmark = {}
stale_cards = []   # cards whose expired facts feed the historicize pass below
for p, t in texts.items():
    for line in t.splitlines():
        if not DEADLINEISH.search(line):
            continue
        past = [d for d in line_dates(line) if d + grace < TODAY]
        if past:
            if histmark.get(rel(p)) == hashlib.md5(t.encode()).hexdigest():
                break  # historicized in this exact form — dated history, not staleness
            add("staleness", f"- `{rel(p)}` — deadline-ish line cites {past[0].isoformat()} (past): “{line.strip()[:110]}”")
            stale_cards.append(p)
            break

# ---------- 7: law-vs-disk drift ----------
law = ""
try:
    law = open(os.path.join(VAULT, "CLAUDE.md"), encoding="utf-8", errors="ignore").read()
except OSError:
    add("drift", "- CLAUDE.md not readable at the vault root — no law to check against")
lanes = []
for base in ("tools", "workspaces"):
    d = os.path.join(VAULT, "raw", base)
    if os.path.isdir(d):
        lanes += [f"raw/{base}/{x}" for x in sorted(os.listdir(d))
                  if os.path.isdir(os.path.join(d, x)) and not x.startswith(".")]
for extra in sorted(os.listdir(os.path.join(VAULT, "raw"))) if os.path.isdir(os.path.join(VAULT, "raw")) else []:
    if extra not in ("tools", "workspaces") and not extra.startswith(".") \
       and os.path.isdir(os.path.join(VAULT, "raw", extra)):
        if law and f"raw/{extra.lower()}" in law.lower():
            continue  # nonstandard lane type, but the owner declared it in the law — accepted
        add("drift", f"- `raw/{extra}/` — a lane TYPE the standard does not define (only tools/ and workspaces/) and the law never names")
if law:
    for lane in lanes:
        name = os.path.basename(lane)
        if name.lower() == LANE_NAME.lower():
            continue
        if name.lower() not in law.lower():
            add("drift", f"- `{lane}/` — lane exists on disk but the law (CLAUDE.md Part 2 pipes) never names it")
# lane contracts: every lane should carry a LANE.md (forward-only rollout: missing is
# tolerated but flagged — undeclared writers are how loading docks rot)
REQ_LANE = ("lane", "producer", "mission", "write", "gear", "status")
LANE_STATUSES = {"proposed", "onboarded", "paused", "retired"}
for lane_rel in lanes:
    lm = os.path.join(VAULT, lane_rel, "LANE.md")
    if not os.path.exists(lm):
        add("contracts", f"- `{lane_rel}/` — no LANE.md (legacy-tolerated; declare the writer when next touched)")
        continue
    try:
        lt = open(lm, encoding="utf-8", errors="ignore").read()
    except OSError:
        add("contracts", f"- `{lane_rel}/LANE.md` — unreadable")
        continue
    lfm = frontmatter(lt)
    if not lfm:
        add("contracts", f"- `{lane_rel}/LANE.md` — no frontmatter block")
        continue
    def _lv(k, _fm=lfm):
        return (_fm.get(k) or "").split("#")[0].strip()
    missing = [k for k in REQ_LANE if not _lv(k)]
    if missing:
        add("contracts", f"- `{lane_rel}/LANE.md` — missing required field(s): {', '.join(missing)}")
    if _lv("lane") and _lv("lane") != os.path.basename(lane_rel):
        add("contracts", f"- `{lane_rel}/LANE.md` — lane field '{_lv('lane')}' does not match the folder name")
    if _lv("status") and _lv("status") not in LANE_STATUSES:
        add("contracts", f"- `{lane_rel}/LANE.md` — unknown status '{_lv('status')}' (want: {', '.join(sorted(LANE_STATUSES))})")

gears_path = os.path.join(LANE, "gears.json")
if os.path.exists(gears_path):
    try:
        g = json.load(open(gears_path, encoding="utf-8"))
        state = ", ".join(f"{k}={v.get('gear','?')}" for k, v in (g.get("rules") or {}).items())
        add("gears", f"- gears.json parses; current state: {state or 'no rules'}")
    except ValueError:
        add("gears", "- gears.json exists but does NOT parse as JSON — fix before any re-grant")
else:
    add("gears", "- no gears.json in the lane — everything is implicitly ask-first")

# ---------- 8: workstream front doors ----------
# A desk is judged by everything that feeds it, not by its own log alone: files anywhere in
# its folder, and lanes whose LANE.md declares `workstreams: [name]`. Owner's call
# (2026-09-05): a desk whose work arrives through a producer lane is active, not dormant.
def newest_mtime(root, skip=("LANE.md",)):
    best = None
    for dp, dn, fn in os.walk(root):
        dn[:] = [x for x in dn if not x.startswith(".") and x != "node_modules"]
        for f in fn:
            if f.startswith(".") or f in skip:
                continue
            try:
                t = os.path.getmtime(os.path.join(dp, f))
            except OSError:
                continue
            if best is None or t > best:
                best = t
    return best

ws_lanes = {}
for lane_rel in lanes:
    try:
        lfm = frontmatter(open(os.path.join(VAULT, lane_rel, "LANE.md"), encoding="utf-8", errors="ignore").read()) or {}
    except OSError:
        continue
    decl = (lfm.get("workstreams") or "").split("#")[0].strip().strip("[]")
    for w in [x.strip().strip("'\"") for x in decl.split(",") if x.strip()]:
        ws_lanes.setdefault(w, []).append(lane_rel)

def days_ago(t):
    return (TODAY - date.fromtimestamp(t)).days

if os.path.isdir(WS):
    for w in sorted(os.listdir(WS)):
        d = os.path.join(WS, w)
        if not os.path.isdir(d) or w.startswith("."):
            continue
        ov, lg = os.path.join(d, "overview.md"), os.path.join(d, "log.md")
        missing = [n for n, f in (("overview.md", ov), ("log.md", lg)) if not os.path.exists(f)]
        if missing:
            add("workstreams", f"- `workstreams/{w}/` — missing {' + '.join(missing)} (the standard's front door)")
            continue
        age = days_ago(os.path.getmtime(lg))
        if age <= a.ws_stale:
            continue
        fed = []
        t = newest_mtime(d)
        if t is not None and days_ago(t) <= a.ws_stale:
            fed.append(f"files in the folder {days_ago(t)}d ago")
        for lane_rel in ws_lanes.get(w, []):
            t = newest_mtime(os.path.join(VAULT, lane_rel))
            if t is not None and days_ago(t) <= a.ws_stale:
                fed.append(f"{lane_rel.split('/')[-1]} lane {days_ago(t)}d ago")
        if not fed:
            add("workstreams", f"- `workstreams/{w}/` — log.md untouched for {age}d and nothing feeds the desk (dormant? archive or revive)")

# ---------- local-inference passes ----------
def ask(system, user):
    payload = json.dumps({"model": MODEL, "temperature": 0.1, "stream": False,
        "response_format": {"type": "json_object"},
        "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}]}).encode()
    req = urllib.request.Request(ENDPOINT, payload,
        {"Authorization": f"Bearer {KEY}", "Content-Type": "application/json"})
    out = json.load(urllib.request.urlopen(req, timeout=180))["choices"][0]["message"]["content"]
    m = re.search(r"\{.*\}", out, re.S)
    return json.loads(m.group(0)) if m else None

llm_errors = llm_calls = 0
if not a.no_llm:
    _profile = _pointer(PROFILE) or ""
    _taste = _pointer(TASTE) or ""

    # historicize: a card with expired facts is usually not garbage — it is history
    # written in the wrong tense. Draft the permanently-true rewrite (dated past
    # tense + a future-facing "why this matters") as an UPDATE the owner gates with
    # curator-approve --force. Retire is only for cards with no durable residue —
    # and then the residue line says where the one durable fact belongs instead.
    #
    # These drafts land in proposals/audit/, NOT the nightly queue in proposals/.
    # Every queue reader (curator-run, curator-status.sh, the Telegram poller) globs
    # proposals/*.md one level deep, so the subfolder is invisible to all of them.
    # That segregation is deliberate: a redraft overwrites an existing trusted card,
    # so it needs a deliberate per-card read, not a bulk "approve all" tap — which
    # would refuse anyway, since only curator-run declares update_of in .meta.json.
    PROP = os.path.join(LANE, "proposals")
    PROP_AUDIT = os.path.join(PROP, "audit")
    SYS_HIST = ("You maintain ONE existing card of a trusted plain-text knowledge layer. Some of its "
        "facts are time-bound and now expired. Rewrite the card so it stays PERMANENTLY true: convert "
        "expired or forward-looking lines into dated past-tense history (\"as of Jun 2026\", \"ran in "
        "spring 2026\"); keep every durable fact; one screen. Preserve EVERY [[wiki-link]] and every URL "
        "from the original, verbatim — a redraft missing even one is invalid and will be discarded. "
        "Also write a strengthened 1-2 sentence why: what a FUTURE reader gains from this card.\n"
        "NEVER historicize a card whose subject is a system, process, or contract that may still be "
        "operating — past dates describing when something was SET UP are provenance, not expiry. "
        "When you cannot tell from the card alone whether the subject has ended, choose keep.\n\n"
        + (f"WHO THE OWNER IS: {_profile}\n\n" if _profile else "")
        + (f"OWNER TASTE RULES:\n{_taste}\n\n" if _taste else "")
        + "If, once the expired material is historicized, NOTHING durable remains (e.g. the card was "
        "only an opportunity listing), choose retire and name the one durable residue line worth "
        "carrying onto a broader card (the funder's card, a lane card) instead. If the card is "
        "ALREADY written as dated past-tense history (its dates are record, not claims), choose keep.\n"
        'Respond ONE JSON object: {"action":"historicize|retire|keep","body":"full replacement body, factual '
        'prose, NO markdown heading (empty when keep)","why":"1-2 sentences for the future reader",'
        '"residue":"only when retiring: the durable one-liner + which card it belongs on, else empty"}.')
    for p in stale_cards[: a.max_historicize]:
        slug = os.path.basename(p)[:-3]
        prop_path = os.path.join(PROP_AUDIT, slug + ".md")
        # pending in EITHER queue means hands off: the nightly may already be
        # proposing this slug, or an earlier audit redraft is still awaiting the gate.
        if os.path.exists(prop_path) or os.path.exists(os.path.join(PROP, slug + ".md")):
            add("historicize", f"- `{rel(p)}` — a proposal for this slug is already pending; skipped")
            continue
        t = texts[p]
        if histmark.get(rel(p)) == hashlib.md5(t.encode()).hexdigest():
            continue  # already historicized in this exact form; past dates are record, not rot
        # Liveness pre-filter (2026-08-09: three of six drafts historicized LIVE
        # systems — the archivist itself, the running grant wire, a workflow mid-
        # period). A card is not history while its subject is demonstrably alive;
        # deterministic signals beat asking the model to notice:
        #   1. any deadline-ish line carries a future date -> its period is not over;
        #   2. its source is a vault path that produced output recently;
        #   3. the owner's gate approved this very card recently (actively maintained).
        LIVE_DAYS = 14
        live_why = ""
        for _line in t.splitlines():
            if DEADLINEISH.search(_line) and any(d >= TODAY for d in line_dates(_line)):
                live_why = f"carries a future date ({max(line_dates(_line)).isoformat()})"
                break
        if not live_why:
            # The source FILE may be static config while the SYSTEM it describes
            # still produces output daily (the scan-mode contract is a Jul prompt
            # file; the wire it governs wrote a daily yesterday). So check the
            # whole home the source lives in: workstreams/<ws>/ or raw/<kind>/<lane>/.
            # BUT only for config/prompt-shaped sources. A FEED source (dated
            # filename, runs/daily/, an archive dump) means the card describes
            # something the system merely REPORTED — a busy wire says nothing
            # about whether an external program it once mentioned has ended.
            _m = re.search(r"^source:\s*(.+)$", t[:600], re.M)
            _srcrel = _m.group(1).strip() if _m else ""
            if re.search(r"\b(runs|daily|weekly|monthly|captures?|candidate-ledger|"
                         r"memory-archive|archive)\b", os.path.dirname(_srcrel), re.I) \
               or re.search(r"\d{4}-\d{2}-\d{2}", os.path.basename(_srcrel)):
                _srcrel = ""  # feed snapshot: home activity is not subject liveness
            _parts = _srcrel.split("/")
            _home = "/".join(_parts[:3] if _parts[:1] == ["raw"] else _parts[:2])
            _home_abs = os.path.join(VAULT, _home) if _home else ""
            if _home_abs and os.path.isdir(_home_abs):
                for _dp, _dn, _fn in os.walk(_home_abs):
                    if live_why:
                        break
                    _dn[:] = [d for d in _dn if not d.startswith(".") and d != "node_modules"]
                    for _f in _fn:
                        try:
                            _mt = os.path.getmtime(os.path.join(_dp, _f))
                        except OSError:
                            continue
                        if (TODAY - date.fromtimestamp(_mt)).days <= LIVE_DAYS:
                            live_why = f"source home `{_home}/` active within {LIVE_DAYS}d"
                            break
            elif _srcrel and os.path.exists(os.path.join(VAULT, _srcrel)) and \
                 (TODAY - date.fromtimestamp(os.path.getmtime(os.path.join(VAULT, _srcrel)))).days <= LIVE_DAYS:
                live_why = f"source `{_srcrel}` active within {LIVE_DAYS}d"
        if not live_why:
            try:
                for _dl in open(os.path.join(LANE, "decisions.log"), encoding="utf-8"):
                    _f = _dl.rstrip("\n").split("\t")
                    if len(_f) >= 3 and _f[1] == "approved" and _f[2] == slug + ".md" \
                       and (TODAY - date.fromisoformat(_f[0][:10])).days <= LIVE_DAYS:
                        live_why = f"gate-approved {_f[0][:10]} (actively maintained)"
                        break
            except (OSError, ValueError):
                pass
        if live_why:
            add("historicize", f"- `{rel(p)}` — stale-dated but LIVE ({live_why}); "
                "not a historicize candidate until its subject stops moving")
            continue
        llm_calls += 1
        try:
            v = ask(SYS_HIST, f"CARD ({rel(p)}), today is {TODAY.isoformat()}:\n\n{t[:5000]}")
        except Exception as exc:
            llm_errors += 1
            add("historicize", f"- `{rel(p)}` — redraft FAILED against {ENDPOINT}: {str(exc)[:120]}")
            continue
        if not v:
            add("historicize", f"- `{rel(p)}` — model returned no usable JSON; flag stands as staleness only")
            continue
        histmark[rel(p)] = hashlib.md5(t.encode()).hexdigest()
        if v.get("action") == "keep":
            continue  # already dated history — remembered, never re-drafted unless the card changes
        if v.get("action") == "historicize" and (v.get("body") or "").strip():
            # Preservation gate (2026-08-09: every accepted redraft had dropped links
            # or URLs the prompt said to keep). Mechanical, not model-trusted: every
            # [[link]] and URL in the original must survive into the redraft, or the
            # draft is discarded and the histmark cleared so next audit retries.
            # Model double-escape repair: a JSON body should never contain a literal
            # backslash-n (the 2026-08-07 curator-architecture draft landed mangled
            # this way). No legitimate card text uses one; convert to real newlines.
            if "\\n" in (v.get("body") or ""):
                v["body"] = v["body"].replace("\\n", "\n")
            _new = (v.get("why") or "") + "\n" + (v.get("body") or "")
            _lost = [f"[[{l}]]" for l in re.findall(r"\[\[([^\]|]+)(?:\|[^\]]*)?\]\]", t)
                     if l not in _new]
            _lost += [u for u in {u.rstrip(").,;>") for u in re.findall(r"https?://\S+", t)}
                      if u not in _new]
            if _lost:
                del histmark[rel(p)]
                add("historicize", f"- `{rel(p)}` — redraft DROPPED {len(_lost)} link(s)/URL(s) "
                    f"({', '.join(_lost[:3])}{'…' if len(_lost) > 3 else ''}); draft discarded, "
                    "flag stands as staleness only, next audit retries")
                continue
            fm_end = t.find("\n---", 3)
            fm_block = t[: fm_end + 4] if t.startswith("---") and fm_end != -1 else "---\ntype: concept\nsource: brain-audit\n---\n"
            m_title = re.search(r"^# (.+)$", t, re.M)
            title = m_title.group(1) if m_title else slug
            why = (v.get("why") or "").strip()
            body = (v.get("body") or "").strip()
            card = f"{fm_block}\n# {title}\n\n" + (f"**Why this matters:** {why}\n\n" if why else "") + body + "\n"
            os.makedirs(PROP_AUDIT, exist_ok=True)
            open(prop_path, "w", encoding="utf-8").write(card)
            add("historicize", f"- `{rel(p)}` — dated-history redraft at `{rel(prop_path)}` → read it "
                f"against the card, then `curator-approve --force {slug} \"historicized\"` "
                f"(or `curator-reject {slug} \"<why>\"` to keep the original)")
        else:
            add("historicize", f"- `{rel(p)}` — nothing durable after expiry → **retire**"
                + (f"; residue: {v.get('residue','')}" if (v.get("residue") or "").strip() else ""))
    json.dump(histmark, open(HISTMARK, "w", encoding="utf-8"), indent=1)

    # retro-taste screen: unscreened (or changed) cards vs the owner's CURRENT rules
    try:
        screened = json.load(open(SCREENED, encoding="utf-8"))
    except (OSError, ValueError):
        screened = {}
    def h(t):
        return hashlib.md5(t.encode()).hexdigest()
    queue = [(p, t) for p, t in sorted(texts.items()) if screened.get(rel(p)) != h(t)]
    SYS_TASTE = ("You audit ONE existing card of a trusted plain-text knowledge layer against the owner's "
        "CURRENT taste rules. The card may predate the rules. Judge the card as it stands.\n\n"
        + (f"WHO THE OWNER IS: {_profile}\n\n" if _profile else "")
        + (f"OWNER TASTE RULES:\n{_taste}\n\n" if _taste else "")
        + "Also apply the standing defaults: config is not knowledge; news/events/deadline-bound "
        "opportunities are not durable cards; no sensitive figures (PII, wallets, retainer amounts) on cards; "
        "the org is the entity, the model is the concept, the opportunity lives outside the brain.\n"
        'Respond with ONE JSON object: {"violates":true|false,"rule":"which rule, briefly",'
        '"action":"keep|trim|merge|historicize|retire","note":"<=25 words, concrete"}. '
        "historicize = the card's facts are time-bound and should be rewritten as dated history, "
        "not deleted. violates=false means the card is fine — most should be.")
    for p, t in queue[: a.max_screen]:
        llm_calls += 1
        try:
            v = ask(SYS_TASTE, f"CARD ({rel(p)}):\n\n{t[:5000]}")
        except Exception as exc:
            llm_errors += 1
            add("retro-taste", f"- `{rel(p)}` — screen FAILED against {ENDPOINT}: {str(exc)[:120]}")
            continue
        screened[rel(p)] = h(t)
        if v and v.get("violates"):
            add("retro-taste", f"- `{rel(p)}` — {v.get('rule','?')} → **{v.get('action','?')}**: {v.get('note','')}")
    json.dump(screened, open(SCREENED, "w", encoding="utf-8"), indent=1)

    # skip-audit: a different set of eyes on what the nightly judge said NO to
    try:
        mark = json.load(open(SKIPMARK, encoding="utf-8")).get("line", 0)
    except (OSError, ValueError):
        mark = 0
    rows, total_lines = [], 0
    if os.path.exists(JUDGMENTS):
        with open(JUDGMENTS, encoding="utf-8") as f:
            all_lines = f.readlines()
        total_lines = len(all_lines)
        if mark > total_lines:
            mark = 0  # judgments file rotated or shrank — start over rather than skip forever
        for line in all_lines[mark:]:
            try:
                j = json.loads(line)
            except ValueError:
                continue
            if j.get("promote") is False:
                rows.append(j)
        mark = total_lines
    SYS_SKIP = ("A primary curator model declined to promote this raw material into a trusted knowledge layer. "
        "You are the second opinion — a DIFFERENT model. The bar stays HIGH and default is still no; flag it "
        "ONLY if it plainly holds durable, reusable knowledge the primary missed.\n"
        + (f"OWNER TASTE RULES:\n{_taste}\n\n" if _taste else "")
        + 'Respond with ONE JSON object: {"disagree":true|false,"why":"<=25 words"}.')
    step = max(1, len(rows) // a.max_skips) if rows else 1
    for j in rows[::step][: a.max_skips]:
        llm_calls += 1
        try:
            v = ask(SYS_SKIP, f"SOURCE: {j.get('source','?')}\nPRIMARY'S REASON TO SKIP: {j.get('reason','')}\n\nEXCERPT:\n{j.get('excerpt','')[:2500]}")
        except Exception as exc:
            llm_errors += 1
            continue
        if v and v.get("disagree"):
            add("skip-audit", f"- `{j.get('source','?')}` — second opinion disagrees with the skip: {v.get('why','')} "
                f"(primary said: {j.get('reason','')[:60]})")
    json.dump({"line": mark}, open(SKIPMARK, "w", encoding="utf-8"))

# ---------- the report ----------
os.makedirs(AUDIT_DIR, exist_ok=True)
stamp = datetime.now().strftime("%Y-%m-%d")
report_path = os.path.join(AUDIT_DIR, f"audit-{stamp}.md")
ORDER = ["labels", "one-screen", "flatness", "links", "orphans", "duplicates",
         "staleness", "historicize", "drift", "contracts", "gears", "workstreams", "retro-taste", "skip-audit"]
TITLES = {"labels": "Labels", "one-screen": "One-screen rule", "flatness": "Folder flatness",
          "links": "Link graph", "orphans": "Inbound orphans", "duplicates": "Possible duplicates",
          "staleness": "Stale dates on cards", "historicize": "Historicize drafts (dated-history rewrites)",
          "drift": "Law vs disk", "contracts": "Lane contracts (LANE.md)", "gears": "Trust gears",
          "workstreams": "Workstream front doors", "retro-taste": "Retro-taste screen (local model)",
          "skip-audit": "Skip audit (second local opinion)"}
issue_sections = [s for s in ORDER if findings.get(s) and s != "gears"]
total = sum(len(findings.get(s, [])) for s in issue_sections)
lines = [f"# Brain audit — {stamp}",
         f"_{len(cards)} knowledge cards checked; {total} finding(s) across {len(issue_sections)} area(s). "
         f"Propose-only: nothing was changed; every action goes through the owner's gate._", ""]
for s in ORDER:
    if not findings.get(s):
        continue
    lines.append(f"## {TITLES[s]} ({len(findings[s])})")
    lines += findings[s]
    lines.append("")
open(report_path, "w", encoding="utf-8").write("\n".join(lines) + "\n")

# short summary block to stdout (first paragraph = what a digest relay forwards)
top = ", ".join(f"{TITLES[s].lower()} {len(findings[s])}" for s in issue_sections[:5]) or "no findings"
print(f"brain-audit: {len(cards)} cards, {total} finding(s) — {top}."
      + (f" LLM: {llm_calls} call(s), {llm_errors} failed." if llm_calls else " (deterministic only)"))
print(f"report: {rel(report_path)}")

if llm_calls and llm_errors == llm_calls:
    print("brain-audit: ALL local-inference calls failed — endpoint down? Exiting non-zero.", file=sys.stderr)
    sys.exit(2)
