#!/usr/bin/env python3
"""brain-audit — the weekly auditor: a propose-only quality pass over the TRUSTED layer.

The nightly curator guards what goes IN; this guards what is already INSIDE.
Deterministic checks first (no model):
  labels        every knowledge note has valid type/source/created, type matches its folder
  one-screen    briefing cards, never articles (line/byte ceilings)
  flatness      knowledge/entities|concepts|syntheses never grow deeper
  links         broken [[links]], raw-style link targets, inbound-orphan cards
  duplicates    near-duplicate slug/title clusters (same normalizer the nightly uses)
  staleness     cards whose deadline-ish lines cite already-past dates
  drift         raw/ lanes on disk that the law (CLAUDE.md) never names; gear state
  workstreams   missing/stale front doors (overview.md + log.md)

Then two LOCAL-inference passes (owner-controlled compute, per the law):
  retro-taste   unscreened knowledge cards judged against taste.md — does the trusted
                layer still satisfy the owner's CURRENT taste rules?
  skip-audit    second opinion on a sample of the nightly judge's recent skips, so a
                different model counter-balances the primary's default-no

Everything lands as ONE dated report in the curator's lane (audit/), and the run
prints a short summary block for the digest relay. This script NEVER edits
knowledge/ — recommendations go through the same owner gate as everything else.

Config via env (defaults mirror curator-run):
  SOVS_VAULT / ~/.brain-root     vault root
  CURATOR_LANE / ~/.curator-lane lane name (default "curator")
  CURATOR_ENDPOINT               OpenAI-compatible endpoint (default: LOCAL Ollama)
  CURATOR_AUDIT_MODEL            model for the audit passes (default: CURATOR_MODEL, then gpt-oss:120b)
  CURATOR_PROFILE / CURATOR_TASTE  same owner files the nightly judge reads

Usage: brain-audit [--no-llm] [--max-screen N] [--max-skips N] [--stale-grace DAYS] [--ws-stale DAYS]
"""
import os, re, json, glob, sys, argparse, hashlib, urllib.request
from datetime import datetime, timezone, date, timedelta

def _pointer(path):
    try:
        return open(os.path.expanduser(path), encoding="utf-8").read().strip() or None
    except OSError:
        return None

VAULT = os.environ.get("SOVS_VAULT") or _pointer("~/.brain-root") or os.getcwd()
LANE_NAME = os.environ.get("CURATOR_LANE") or _pointer("~/.curator-lane") or "curator"
LANE = os.path.join(VAULT, "raw", "workspaces", LANE_NAME)
K = os.path.join(VAULT, "knowledge")
WS = os.path.join(VAULT, "workstreams")
AUDIT_DIR = os.path.join(LANE, "audit")
SCREENED = os.path.join(LANE, ".audit-screened.json")
SKIPMARK = os.path.join(LANE, ".audit-skipmark.json")
JUDGMENTS = os.path.join(LANE, "judgments.jsonl")
ENDPOINT = os.environ.get("CURATOR_ENDPOINT", "http://localhost:11434/v1/chat/completions")
MODEL = os.environ.get("CURATOR_AUDIT_MODEL") or os.environ.get("CURATOR_MODEL", "gpt-oss:120b")
KEYFILE = os.environ.get("CURATOR_KEYFILE", "")
KEY = open(KEYFILE).read().strip() if KEYFILE and os.path.exists(KEYFILE) else os.environ.get("CURATOR_KEY", "")
PROFILE = os.environ.get("CURATOR_PROFILE", os.path.join(LANE, "profile.md"))
TASTE = os.environ.get("CURATOR_TASTE", os.path.join(LANE, "taste.md"))

ap = argparse.ArgumentParser()
ap.add_argument("--no-llm", action="store_true", help="deterministic checks only")
ap.add_argument("--max-screen", type=int, default=20, help="retro-taste: cards screened per run")
ap.add_argument("--max-skips", type=int, default=8, help="skip-audit: skipped judgments re-examined per run")
ap.add_argument("--stale-grace", type=int, default=14, help="days past a deadline before it counts as stale")
ap.add_argument("--ws-stale", type=int, default=21, help="days without a log.md touch before a workstream counts dormant")
a = ap.parse_args()

TODAY = date.today()
findings = {}          # section -> [lines]
def add(section, line):
    findings.setdefault(section, []).append(line)

def rel(p):
    return os.path.relpath(p, VAULT)

# ---------- gather the trusted layer ----------
TYPE_DIRS = {"entity": "entities", "concept": "concepts", "synthesis": "syntheses"}
cards = sorted(glob.glob(K + "/**/*.md", recursive=True))
slugs = {os.path.basename(p)[:-3] for p in cards}

def frontmatter(text):
    if not text.startswith("---"):
        return None
    end = text.find("\n---", 3)
    if end == -1:
        return None
    fm = {}
    for line in text[3:end].strip().splitlines():
        m = re.match(r"^(\w[\w-]*):\s*(.*)$", line)
        if m:
            fm[m.group(1)] = m.group(2).strip()
    return fm

# ---------- 1+2+3: labels, one-screen, flatness ----------
for sub in TYPE_DIRS.values():
    d = os.path.join(K, sub)
    if os.path.isdir(d):
        deep = [x for x in glob.glob(d + "/*/") ]
        for x in deep:
            add("flatness", f"- `{rel(x)}` — subdirectory inside knowledge/{sub}/ (the law: never grows deeper)")

texts = {}
for p in cards:
    try:
        t = open(p, encoding="utf-8", errors="ignore").read()
    except OSError:
        continue
    texts[p] = t
    fm = frontmatter(t)
    if not fm:
        add("labels", f"- `{rel(p)}` — no label block")
        continue
    for req in ("type", "source", "created"):
        if not fm.get(req):
            add("labels", f"- `{rel(p)}` — missing required label: {req}")
    typ = fm.get("type", "")
    sub = os.path.basename(os.path.dirname(p))
    if typ in TYPE_DIRS and TYPE_DIRS[typ] != sub:
        add("labels", f"- `{rel(p)}` — type '{typ}' but lives in {sub}/")
    body = t[t.find("\n---", 3) + 4 :] if t.startswith("---") else t
    nlines = len([l for l in body.splitlines() if l.strip()])
    if nlines > 40 or len(body) > 6000:
        add("one-screen", f"- `{rel(p)}` — {nlines} non-empty lines / {len(body)} bytes (target: one screen)")

# ---------- 4: link graph ----------
WIKI = re.compile(r"\[\[([^\]|#]+?)(?:\|[^\]]*?)?\]\]")
RAWISH = re.compile(r"(_|^reference-|^feedback-|^project-|^20\d\d-)")
inbound = {s: 0 for s in slugs}
outbound = {s: 0 for s in slugs}
for p, t in texts.items():
    me = os.path.basename(p)[:-3]
    for tgt in set(WIKI.findall(t)):
        tgt = tgt.strip()
        if tgt in slugs:
            if tgt != me:
                inbound[tgt] += 1
                outbound[me] = outbound.get(me, 0) + 1
        elif RAWISH.search(tgt.lower()):
            add("links", f"- `{rel(p)}` — [[{tgt}]] targets a raw-style filename (loading dock, not a card)")
        else:
            add("links", f"- `{rel(p)}` — broken link [[{tgt}]]")
# true orphan = no inbound AND no outbound (fully cut off). Cards that link out but
# are never linked TO are "sink-only leaves" — usually healthy, reported as a count.
orphans = sorted(s for s in slugs if not inbound[s] and not outbound.get(s))
sink_only = sum(1 for s in slugs if not inbound[s] and outbound.get(s))
if orphans:
    add("orphans", f"- {len(orphans)} fully isolated card(s) (no links in either direction): "
        + ", ".join(orphans[:20]) + (" …" if len(orphans) > 20 else ""))
if sink_only:
    add("orphans", f"- {sink_only} sink-only leaf card(s) link out but are never linked to (informational; weave only if a hub should own them)")

# ---------- 5: near-duplicate clusters ----------
def norm(s):
    return re.sub(r"[^a-z0-9]", "", s.lower())
by_key = {}
for s in slugs:
    by_key.setdefault(norm(s), []).append(s)
titles = {}
for p, t in texts.items():
    fm = frontmatter(t) or {}
    ttl = norm(fm.get("title", ""))
    if ttl:
        titles.setdefault(ttl, []).append(os.path.basename(p)[:-3])
clusters = set()
for k, group in by_key.items():
    if len(group) > 1:
        clusters.add(tuple(sorted(group)))
keys = sorted(by_key)
for i, k1 in enumerate(keys):
    if len(k1) < 12:
        continue
    for k2 in keys[i + 1 :]:
        if len(k2) >= 12 and (k1 in k2 or k2 in k1):
            clusters.add(tuple(sorted(by_key[k1] + by_key[k2])))
# token-overlap pass: slugs sharing most of their meaningful words are usually the
# same subject under different phrasings (e.g. x-funding-framework vs
# x-funding-coordination-framework). Report-only; intended entity/concept splits
# will show up too — the owner skims and moves on.
tok = {s: {w for w in s.split("-") if len(w) >= 3} for s in slugs}
slug_list = sorted(slugs)
for i, s1 in enumerate(slug_list):
    t1 = tok[s1]
    if len(t1) < 2:
        continue
    for s2 in slug_list[i + 1 :]:
        t2 = tok[s2]
        if len(t2) < 2:
            continue
        inter = len(t1 & t2)
        if inter >= 2 and inter / len(t1 | t2) >= 0.6:
            clusters.add(tuple(sorted((s1, s2))))
for ttl, group in titles.items():
    if len(group) > 1:
        clusters.add(tuple(sorted(group)))
for c in sorted(clusters):
    add("duplicates", "- possible same-subject cluster: " + " · ".join(f"`{s}`" for s in c))

# ---------- 6: staleness (deadline-ish lines citing past dates) ----------
MONTHS = {m: i + 1 for i, m in enumerate(
    ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"])}
DEADLINEISH = re.compile(r"deadline|apply by|applications? (close|due)|closes on|due (by|date)|expires?|until|review period|comment period", re.I)
D_ISO = re.compile(r"\b(20\d\d)-(\d\d)-(\d\d)\b")
D_DMY = re.compile(r"\b([0-3]?\d)\s+(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\w*\s+(20\d\d)\b", re.I)
D_MDY = re.compile(r"\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\w*\s+([0-3]?\d),?\s+(20\d\d)\b", re.I)

def line_dates(line):
    out = []
    for y, mo, dd in D_ISO.findall(line):
        out.append((int(y), int(mo), int(dd)))
    for dd, mo, y in D_DMY.findall(line):
        out.append((int(y), MONTHS[mo.lower()[:3]], int(dd)))
    for mo, dd, y in D_MDY.findall(line):
        out.append((int(y), MONTHS[mo.lower()[:3]], int(dd)))
    valid = []
    for y, mo, dd in out:
        try:
            valid.append(date(y, mo, dd))
        except ValueError:
            pass
    return valid

grace = timedelta(days=a.stale_grace)
for p, t in texts.items():
    for line in t.splitlines():
        if not DEADLINEISH.search(line):
            continue
        past = [d for d in line_dates(line) if d + grace < TODAY]
        if past:
            add("staleness", f"- `{rel(p)}` — deadline-ish line cites {past[0].isoformat()} (past): “{line.strip()[:110]}”")
            break

# ---------- 7: law-vs-disk drift ----------
law = ""
try:
    law = open(os.path.join(VAULT, "CLAUDE.md"), encoding="utf-8", errors="ignore").read()
except OSError:
    add("drift", "- CLAUDE.md not readable at the vault root — no law to check against")
lanes = []
for base in ("tools", "workspaces"):
    d = os.path.join(VAULT, "raw", base)
    if os.path.isdir(d):
        lanes += [f"raw/{base}/{x}" for x in sorted(os.listdir(d))
                  if os.path.isdir(os.path.join(d, x)) and not x.startswith(".")]
for extra in sorted(os.listdir(os.path.join(VAULT, "raw"))) if os.path.isdir(os.path.join(VAULT, "raw")) else []:
    if extra not in ("tools", "workspaces") and not extra.startswith(".") \
       and os.path.isdir(os.path.join(VAULT, "raw", extra)):
        add("drift", f"- `raw/{extra}/` — a lane TYPE the standard does not define (only tools/ and workspaces/)")
if law:
    for lane in lanes:
        name = os.path.basename(lane)
        if name.lower() == LANE_NAME.lower():
            continue
        if name.lower() not in law.lower():
            add("drift", f"- `{lane}/` — lane exists on disk but the law (CLAUDE.md Part 2 pipes) never names it")
gears_path = os.path.join(LANE, "gears.json")
if os.path.exists(gears_path):
    try:
        g = json.load(open(gears_path, encoding="utf-8"))
        state = ", ".join(f"{k}={v.get('gear','?')}" for k, v in (g.get("rules") or {}).items())
        add("gears", f"- gears.json parses; current state: {state or 'no rules'}")
    except ValueError:
        add("gears", "- gears.json exists but does NOT parse as JSON — fix before any re-grant")
else:
    add("gears", "- no gears.json in the lane — everything is implicitly ask-first")

# ---------- 8: workstream front doors ----------
if os.path.isdir(WS):
    for w in sorted(os.listdir(WS)):
        d = os.path.join(WS, w)
        if not os.path.isdir(d) or w.startswith("."):
            continue
        ov, lg = os.path.join(d, "overview.md"), os.path.join(d, "log.md")
        missing = [n for n, f in (("overview.md", ov), ("log.md", lg)) if not os.path.exists(f)]
        if missing:
            add("workstreams", f"- `workstreams/{w}/` — missing {' + '.join(missing)} (the standard's front door)")
            continue
        age = (TODAY - date.fromtimestamp(os.path.getmtime(lg))).days
        if age > a.ws_stale:
            add("workstreams", f"- `workstreams/{w}/` — log.md untouched for {age}d (dormant? archive or revive)")

# ---------- local-inference passes ----------
def ask(system, user):
    payload = json.dumps({"model": MODEL, "temperature": 0.1, "stream": False,
        "response_format": {"type": "json_object"},
        "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}]}).encode()
    req = urllib.request.Request(ENDPOINT, payload,
        {"Authorization": f"Bearer {KEY}", "Content-Type": "application/json"})
    out = json.load(urllib.request.urlopen(req, timeout=180))["choices"][0]["message"]["content"]
    m = re.search(r"\{.*\}", out, re.S)
    return json.loads(m.group(0)) if m else None

llm_errors = llm_calls = 0
if not a.no_llm:
    _profile = _pointer(PROFILE) or ""
    _taste = _pointer(TASTE) or ""

    # retro-taste screen: unscreened (or changed) cards vs the owner's CURRENT rules
    try:
        screened = json.load(open(SCREENED, encoding="utf-8"))
    except (OSError, ValueError):
        screened = {}
    def h(t):
        return hashlib.md5(t.encode()).hexdigest()
    queue = [(p, t) for p, t in sorted(texts.items()) if screened.get(rel(p)) != h(t)]
    SYS_TASTE = ("You audit ONE existing card of a trusted plain-text knowledge layer against the owner's "
        "CURRENT taste rules. The card may predate the rules. Judge the card as it stands.\n\n"
        + (f"WHO THE OWNER IS: {_profile}\n\n" if _profile else "")
        + (f"OWNER TASTE RULES:\n{_taste}\n\n" if _taste else "")
        + "Also apply the standing defaults: config is not knowledge; news/events/deadline-bound "
        "opportunities are not durable cards; no sensitive figures (PII, wallets, retainer amounts) on cards; "
        "the org is the entity, the model is the concept, the opportunity lives outside the brain.\n"
        'Respond with ONE JSON object: {"violates":true|false,"rule":"which rule, briefly",'
        '"action":"keep|trim|merge|retire","note":"<=25 words, concrete"}. '
        "violates=false means the card is fine — most should be.")
    for p, t in queue[: a.max_screen]:
        llm_calls += 1
        try:
            v = ask(SYS_TASTE, f"CARD ({rel(p)}):\n\n{t[:5000]}")
        except Exception as exc:
            llm_errors += 1
            add("retro-taste", f"- `{rel(p)}` — screen FAILED against {ENDPOINT}: {str(exc)[:120]}")
            continue
        screened[rel(p)] = h(t)
        if v and v.get("violates"):
            add("retro-taste", f"- `{rel(p)}` — {v.get('rule','?')} → **{v.get('action','?')}**: {v.get('note','')}")
    json.dump(screened, open(SCREENED, "w", encoding="utf-8"), indent=1)

    # skip-audit: a different set of eyes on what the nightly judge said NO to
    try:
        mark = json.load(open(SKIPMARK, encoding="utf-8")).get("line", 0)
    except (OSError, ValueError):
        mark = 0
    rows, total_lines = [], 0
    if os.path.exists(JUDGMENTS):
        with open(JUDGMENTS, encoding="utf-8") as f:
            all_lines = f.readlines()
        total_lines = len(all_lines)
        if mark > total_lines:
            mark = 0  # judgments file rotated or shrank — start over rather than skip forever
        for line in all_lines[mark:]:
            try:
                j = json.loads(line)
            except ValueError:
                continue
            if j.get("promote") is False:
                rows.append(j)
        mark = total_lines
    SYS_SKIP = ("A primary curator model declined to promote this raw material into a trusted knowledge layer. "
        "You are the second opinion — a DIFFERENT model. The bar stays HIGH and default is still no; flag it "
        "ONLY if it plainly holds durable, reusable knowledge the primary missed.\n"
        + (f"OWNER TASTE RULES:\n{_taste}\n\n" if _taste else "")
        + 'Respond with ONE JSON object: {"disagree":true|false,"why":"<=25 words"}.')
    step = max(1, len(rows) // a.max_skips) if rows else 1
    for j in rows[::step][: a.max_skips]:
        llm_calls += 1
        try:
            v = ask(SYS_SKIP, f"SOURCE: {j.get('source','?')}\nPRIMARY'S REASON TO SKIP: {j.get('reason','')}\n\nEXCERPT:\n{j.get('excerpt','')[:2500]}")
        except Exception as exc:
            llm_errors += 1
            continue
        if v and v.get("disagree"):
            add("skip-audit", f"- `{j.get('source','?')}` — second opinion disagrees with the skip: {v.get('why','')} "
                f"(primary said: {j.get('reason','')[:60]})")
    json.dump({"line": mark}, open(SKIPMARK, "w", encoding="utf-8"))

# ---------- the report ----------
os.makedirs(AUDIT_DIR, exist_ok=True)
stamp = datetime.now().strftime("%Y-%m-%d")
report_path = os.path.join(AUDIT_DIR, f"audit-{stamp}.md")
ORDER = ["labels", "one-screen", "flatness", "links", "orphans", "duplicates",
         "staleness", "drift", "gears", "workstreams", "retro-taste", "skip-audit"]
TITLES = {"labels": "Labels", "one-screen": "One-screen rule", "flatness": "Folder flatness",
          "links": "Link graph", "orphans": "Inbound orphans", "duplicates": "Possible duplicates",
          "staleness": "Stale dates on cards", "drift": "Law vs disk", "gears": "Trust gears",
          "workstreams": "Workstream front doors", "retro-taste": "Retro-taste screen (local model)",
          "skip-audit": "Skip audit (second local opinion)"}
issue_sections = [s for s in ORDER if findings.get(s) and s != "gears"]
total = sum(len(findings.get(s, [])) for s in issue_sections)
lines = [f"# Brain audit — {stamp}",
         f"_{len(cards)} knowledge cards checked; {total} finding(s) across {len(issue_sections)} area(s). "
         f"Propose-only: nothing was changed; every action goes through the owner's gate._", ""]
for s in ORDER:
    if not findings.get(s):
        continue
    lines.append(f"## {TITLES[s]} ({len(findings[s])})")
    lines += findings[s]
    lines.append("")
open(report_path, "w", encoding="utf-8").write("\n".join(lines) + "\n")

# short summary block to stdout (first paragraph = what a digest relay forwards)
top = ", ".join(f"{TITLES[s].lower()} {len(findings[s])}" for s in issue_sections[:5]) or "no findings"
print(f"brain-audit: {len(cards)} cards, {total} finding(s) — {top}."
      + (f" LLM: {llm_calls} call(s), {llm_errors} failed." if llm_calls else " (deterministic only)"))
print(f"report: {rel(report_path)}")

if llm_calls and llm_errors == llm_calls:
    print("brain-audit: ALL local-inference calls failed — endpoint down? Exiting non-zero.", file=sys.stderr)
    sys.exit(2)
