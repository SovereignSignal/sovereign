    aud = sorted(glob.glob(os.path.join(lane, "audit", "audit-*.md")))
    out["audit_latest"] = os.path.basename(aud[-1]) if aud else None
    break
out["knowledge"] = {sub: len(glob.glob(os.path.join(root, "knowledge", sub, "*.md"))) for sub in ("entities", "concepts", "syntheses")}
try:
    out["hub_host"] = __import__("socket").gethostname().split(".")[0]
    # ---- backups: where copies of the brain and the lanes are, and how old ----
    import subprocess
    def git(*args):
        try: return subprocess.run(["git", "-C", root] + list(args), capture_output=True, text=True, timeout=10).stdout.strip()
        except Exception: return ""
    bk = {"remotes": [], "lanes": [], "snapshots": None, "archive": None, "exchange": {}}
    for line in git("remote", "-v").splitlines():
        if not line.endswith("(fetch)"): continue
        name, url = line.split()[:2]
        host = re.sub(r"^[a-z]+://", "", url).split("/")[0].split("@")[-1].split(":")[0]
        head = git("log", "-1", "--format=%cI", name + "/main")
        ahead = git("rev-list", "--count", name + "/main..main") or "?"
        bk["remotes"].append({"name": name, "host": host, "remote_head": head or None, "ahead": int(ahead) if ahead.isdigit() else None})
    keep = None
    try: keep = open(os.path.expanduser("~/.brain-keep")).read().strip()
    except OSError: pass
    for lm in sorted(glob.glob(os.path.join(root, "raw", "workspaces", "*", "LANE.md"))):
        lane = os.path.basename(os.path.dirname(lm))
        try: txt = open(lm, errors="ignore").read()
        except OSError: continue
        if not re.search(r"^write:\s*git-branch", txt, re.M): continue
        pushed = git("log", "-1", "--format=%cI", "refs/remotes/%s/lane/%s" % (keep or "", lane)) if keep else ""
        merged = git("log", "-1", "--format=%cI", "main", "--", "raw/workspaces/" + lane)
        bk["lanes"].append({"lane": lane, "pushed": pushed or None, "merged": merged or None, "keep": keep})
    snap_root = None
    try: snap_root = os.path.expanduser(open(os.path.expanduser("~/.brain-snapshots")).read().strip())
    except OSError:
        cand = os.path.expanduser("~/Backups/vault-snapshots"); snap_root = cand if os.path.isdir(cand) else None
    if snap_root and os.path.isdir(snap_root):
        done = sorted(d for d in os.listdir(snap_root) if re.match(r"^\d{4}-\d{2}-\d{2}$", d) and os.path.exists(os.path.join(snap_root, d, ".snapshot-complete")))
        bk["snapshots"] = {"dir": snap_root, "count": len(done), "newest": done[-1] if done else None,
                           "newest_age_h": round((now - os.path.getmtime(os.path.join(snap_root, done[-1], ".snapshot-complete"))) / 3600, 1) if done else None,
                           "same_disk": True}
    tars = sorted(glob.glob(os.path.join(root, "archive", "*.tar.gz")), key=os.path.getmtime)
    if tars:
        bk["archive"] = {"count": len(tars), "newest": os.path.basename(tars[-1]), "newest_age_h": round((now - os.path.getmtime(tars[-1])) / 3600, 1)}
    logp = os.path.expanduser("~/Library/Logs/brain-exchange-sync.log")
    if os.path.exists(logp):
        try:
            for line in open(logp, errors="ignore").read().splitlines()[-400:]:
                m = re.match(r"(\S+)\s+out: vault -> (\S+) ok", line)
