            reason, hold = reason.split(" · held: ", 1)
        mm = pmeta.get(slug) or {}
        upd = mm.get("update_of") or (head[2][7:] if len(head) > 2 and head[2].startswith("UPDATE ") else None)
        props.append({"slug": slug, "type": fm.get("type"), "title": fm.get("title") or slug, "source": fm.get("source"),
                      "confidence": mm.get("confidence") or (head[1] if len(head) > 1 else None),
                      "update_of": upd, "flags": [f for f in (m.group(2).split(" ⚠ ") if m else []) if f],
                      "reason": reason, "hold": hold, "words": len(body.split()),
                      "age_h": round((now - os.path.getmtime(pp)) / 3600, 1), "body": body.strip()[:2500]})
    out["proposals"] = props
    stop = os.path.join(lane, ".burndown-stop")
    out["burndown"] = {"stopped": os.path.exists(stop),
                       "note": (open(stop, errors="ignore").read().strip()[:200] if os.path.exists(stop) else None)}
    try:
