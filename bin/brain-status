                if m: bk["exchange"].setdefault(m.group(2), {})["fail"] = m.group(1)
        except OSError: pass
    out["backups"] = bk
    # ---- cloud harnesses run here on the hub; report their state for every console ----
    ch = []
    tmpl = os.path.dirname(os.path.dirname(os.path.realpath(os.path.expanduser("~/brain-bin/sov"))))
    for hj in sorted(glob.glob(os.path.join(tmpl, "connectors", "harness", "*", "harness.json"))):
        try: meta = json.load(open(hj))
        except Exception: continue
