def _run_age_from_manifest(last_run_line):
    m = re.search(r"Last run: (\S+)", last_run_line or "")
    if not m:
        return None
    ts = m.group(1)
    try:
        t = datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc).timestamp()
    except ValueError:
        try:   # any ISO-8601 with an offset, as a job's own last-success file may keep it
            d = datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
            t = (d if d.tzinfo else d.replace(tzinfo=datetime.timezone.utc)).timestamp()
        except ValueError:
            return None
    return round((NOW - t) / 3600, 2)


def _harness_entry(hdir, harness_id):
    last = manifest_last_run(hdir)
    items = re.search(r"Items mirrored: (\d+)", last or "")
    md = 0
    for dp, dn, fn in os.walk(hdir):
        md += sum(1 for f in fn if f.endswith(".md") and f not in ("MANIFEST.md", "HARNESS.md", "LANE.md", "brain-load-usage.md"))
    projects = None
    mem = os.path.join(hdir, "memory")
    if os.path.isdir(mem):
        projects = sum(1 for d in os.listdir(mem) if os.path.isdir(os.path.join(mem, d)))
    return {"harness": harness_id, "last_run": last, "run_age_h": _run_age_from_manifest(last),
            "items": int(items.group(1)) if items else None, "md_files": md, "projects": projects,
            "reads_7d": receipts_7d(hdir)["real"], "newest_age_h": age_h(newest_mtime(hdir))}


def parse_hosts_md(root):
    """Owner-kept host registry: the first hosts.md found under raw/workspaces/*/ or
    workstreams/*/, a markdown table whose header names the columns. Returns {host: {col: val}}."""
    for pat in ("raw/workspaces/*/hosts.md", "workstreams/*/hosts.md"):
        for path in sorted(glob.glob(os.path.join(root, pat))):
            rows, cols = {}, None
            for line in open(path, encoding="utf-8", errors="ignore"):
                if not line.startswith("|"):
                    continue
                cells = [c.strip() for c in line.strip().strip("|").split("|")]
                if cols is None:
                    cols = [c.lower() for c in cells]
                    continue
                if all(set(c) <= set("-: ") for c in cells):
                    continue
                row = dict(zip(cols, cells))
                if row.get("host"):
                    rows[row["host"]] = row
            if rows:
                return rows, os.path.relpath(path, root)
    return {}, None


def tailscale_peers():
    """{lowercased peer hostname: {online, ip, os}} when a Tailscale client is present, else {}."""
    for cand in (shutil.which("tailscale"), "/Applications/Tailscale.app/Contents/MacOS/Tailscale", "/usr/bin/tailscale"):
        if cand and os.path.exists(cand):
            try:
                out = subprocess.run([cand, "status", "--json"], capture_output=True, text=True, timeout=8).stdout
                d = json.loads(out)
            except Exception:
                return {}
            peers = {}
            for node in [d.get("Self") or {}] + list((d.get("Peer") or {}).values()):
                name = (node.get("HostName") or "").strip().lower()
                if name:
                    peers[name] = {"online": bool(node.get("Online")), "ip": (node.get("TailscaleIPs") or [None])[0],
                                   "os": node.get("OS"), "self": node is d.get("Self")}
            return peers
    return {}


def port_open(host, port=22, timeout=1.0):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except Exception:
        return False


def fleet_view(root, contrib=None):
    contrib = contrib or {}
    """Every host the vault knows about, from the lane folders themselves: which tools are
    deployed there, whether each reads (receipts) and writes (manifest), and what it pulls.
    Works on any copy of the vault, because these files are plain markdown that syncs."""
    hosts = {}
    def host_of(fm, fallback):
        return (fm.get("host") or fallback or "unassigned").strip()
    for d in sorted(glob.glob(os.path.join(root, "raw", "tools", "*"))):
        if not os.path.isdir(d):
            continue
        name = os.path.basename(d)
        fm = frontmatter(os.path.join(d, "LANE.md"))
        # host comes from the lane contract; a tool lane named <prefix>-<host> is the fallback
        host = host_of(fm, name.rsplit("-", 1)[1] if "-" in name else None)
        rec = hosts.setdefault(host, {"host": host, "lanes": [], "harnesses": []})
        entry = {"lane": name, "producer": fm.get("producer"), "read": fm.get("read"), "write": fm.get("write"),
                 "status": fm.get("status"), "newest_age_h": age_h(newest_mtime(d)),
                 "cards": (contrib.get(name) or {}).get("cards", 0)}
        rec["lanes"].append(entry)
        if os.path.exists(os.path.join(d, "MANIFEST.md")) or os.path.exists(os.path.join(d, "memory", "MANIFEST.md")):
            hid = name[:-(len(host) + 1)] if host and name.endswith("-" + host) else name
            rec["harnesses"].append({**_harness_entry(d, hid), "lane": name})
    for d in sorted(glob.glob(os.path.join(root, "raw", "workspaces", "*"))):
        # no contract, no lane, so no device named after the folder (the lanes list agrees)
        if not os.path.isdir(d) or not os.path.exists(os.path.join(d, "LANE.md")):
            continue
        name = os.path.basename(d)
        fm = frontmatter(os.path.join(d, "LANE.md"))
        host = host_of(fm, name)
        rec = hosts.setdefault(host, {"host": host, "lanes": [], "harnesses": []})
        rec["lanes"].append({"lane": name, "producer": fm.get("producer"), "read": fm.get("read"), "write": fm.get("write"),
                             "status": fm.get("status"), "newest_age_h": age_h(newest_mtime(d)),
                             "cards": (contrib.get(name) or {}).get("cards", 0)})
        for sub in sorted(os.listdir(d)):
            hd = os.path.join(d, sub)
            if os.path.isdir(hd) and (os.path.exists(os.path.join(hd, "HARNESS.md")) or os.path.exists(os.path.join(hd, "MANIFEST.md"))):
                entry = {**_harness_entry(hd, sub), "lane": name}
                # A box that stopped running this mirror leaves the folder behind (raw is
                # provenance). HARNESS.md `status: retired` says so; the row moves out of the
                # live mirrors, so it is never a mirror that is late.
                hfm = frontmatter(os.path.join(hd, "HARNESS.md")) if os.path.exists(os.path.join(hd, "HARNESS.md")) else {}
                if str(hfm.get("status") or "").strip().lower() == "retired":
                    rec.setdefault("retired", []).append(entry)
                else:
                    rec["harnesses"].append(entry)
    # owner registry + live network state
    registry, registry_path = parse_hosts_md(root)
    peers = tailscale_peers()
    me = pointer("~/.brain-host")
    for host, meta in registry.items():
        hosts.setdefault(host, {"host": host, "lanes": [], "harnesses": []})
    for rec in hosts.values():
        meta = registry.get(rec["host"], {})
        rec["meta"] = {k: meta.get(k) for k in ("kind", "where", "reach", "transport", "identity", "notes", "tailscale")}
        ts_name = (meta.get("tailscale") or rec["host"]).strip().lower()
        peer = peers.get(ts_name)
        if rec["host"] == me:
            rec["net"] = {"online": True, "ip": (peer or {}).get("ip"), "via": "this machine"}
        elif peer:
            rec["net"] = {"online": peer["online"], "ip": peer["ip"], "via": "tailscale"}
        elif meta.get("reach", "").startswith("ssh "):
            alias = meta["reach"].split()[1]
            rec["net"] = {"online": port_open(alias), "ip": None, "via": "port 22 probe"}
        else:
            rec["net"] = {"online": None, "ip": None, "via": None}
    # local VMs on this machine (Parallels today): the console offers to connect them
    for vm in local_vms():
        key = vm["name"].split()[0].lower()
        rec = next((r for r in hosts.values() if r["host"].split("-")[0].lower() == key), None)
        if rec is None:
            rec = hosts.setdefault(key + "-vm", {"host": key + "-vm", "lanes": [], "harnesses": [],
                                                 "meta": {"kind": "local VM", "where": "Parallels on " + (me or "this machine")},
                                                 "net": {"online": None, "ip": None, "via": None}})
        rec["vm"] = vm
        # Parallels reports no address for a guest on its shared network and the guests run
        # no SSH, so a port probe answers nothing. The hypervisor knows whether the guest is
        # running, which is what "online" means for a machine only this host can reach.
        if vm.get("status") and not rec["net"].get("online"):
            rec["net"] = {"online": vm["status"] == "running", "ip": vm.get("ip"), "via": "parallels"}
        # The guest's own folder in this host's parallels lane is its lane: the row then
        # shows what was pulled and how fresh it is, instead of "no tools" for a guest
        # whose memory is in the archive.
        slug = re.sub(r"[^a-z0-9]+", "-", (vm.get("name") or "").lower()).strip("-")
        gdir = os.path.join(root, "raw", "tools", "parallels-" + (me or ""), slug) if me else None
        if gdir and os.path.isdir(gdir):
            pulled = [os.path.basename(p) for p in sorted(glob.glob(os.path.join(gdir, "*"))) if os.path.isdir(p)]
            rec["lanes"].append({"lane": "parallels-%s/%s" % (me, slug), "producer": "Claude Code in the guest, pulled by " + me,
                                 "read": "none (contribute-only)", "write": "prlctl exec (via " + me + ")",
                                 "status": "onboarded", "newest_age_h": age_h(newest_mtime(gdir)),
                                 "cards": (contrib.get("parallels-" + me) or {}).get("cards", 0), "pulled": pulled})
            cc = os.path.join(gdir, "claude-code")
            if os.path.isdir(cc):
                rec["harnesses"].append({**_harness_entry(cc, "claude-code"), "lane": "parallels-%s/%s" % (me, slug),
                                         "last_run": manifest_last_run(os.path.dirname(gdir)), "pulled_by": me})
    hosts_sorted = sorted(hosts.values(), key=lambda r: (0 if r["host"] == me else 1, -len(r["harnesses"]), r["host"]))
    return {"hosts": hosts_sorted, "registry": registry_path, "tailscale": bool(peers),
            "bootstrap": bootstrap_handoff() if any(r.get("vm") for r in hosts.values()) else None}


def backups_view(root, hub, fleet):
    """Backup posture, read-only: the hub's copies of the archive (from the hub script), the
    producers' lanes on the keep, and for hosts that live on a hypervisor node this machine
    can reach, whether the node backs the VM up (Proxmox: vzdump jobs and dumps)."""
    from proxmox_backups import PROBE, parse_probe, vm_status
    bk = dict((hub.get("backups") or {}))
    hosts = []
    cache_p = os.path.expanduser("~/.cache/sovereign/hypervisor-backups.json")
    try: cache = json.load(open(cache_p))
    except Exception: cache = {}
    # A success is worth caching for 15 minutes; a failure is not. One slow probe right
    # after a reboot (Tailscale still bringing routes up) used to poison the view for the
    # whole window and report every VM as unbacked-up-and-unreachable. Failures are
    # retried once and then held for two minutes only.
    def _fresh(node):
        e = cache.get(node) or {}
        ttl = 900 if e.get("reachable") and not e.get("partial") else 120
        return e.get("version") == 2 and (time.time() - e.get("_at", 0)) < ttl
    # The probe is optional detail and must never hold the status: with both nodes down
    # the old serial loop cost two attempts of a 12 s ssh timeout per node (49 s measured
    # 2026-09-11, the console showing an empty environment the whole time, again every
    # two minutes when the failure cache expired). Now the wire is checked first with a
    # one-second TCP connect to the address ssh would dial, and nodes are probed at the
    # same time, so the worst case is one node's budget rather than the sum.
    def _target(node):
        try:
            host, port = node, 22
            for line in subprocess.run(["ssh", "-G", node], capture_output=True, text=True, timeout=5).stdout.splitlines():
                k, _, v = line.partition(" ")
                if k == "hostname" and v.strip(): host = v.strip()
                elif k == "port" and v.strip().isdigit(): port = int(v.strip())
            return host, port
        except Exception:
            return node, 22
    PROBE_BUDGET = 6                                       # seconds; ConnectTimeout does not bound a session that hangs after the TCP connect
    def _why(exc):
        """Turn a failed probe into a cause and the owner's next step. Tailscale SSH's
        browser re-check is the one that looks like a slow network: the session opens,
        then waits for a click nobody can see (found 2026-09-11)."""
        err = getattr(exc, "stderr", None) or b""
        if isinstance(err, bytes): err = err.decode("utf-8", "replace")
        m = re.search(r"Tailscale SSH requires an additional check.*?(https://\S+)", err, re.S)
        if m:
            return {"why": "tailscale-check", "url": m.group(1),
                    "action": "Tailscale SSH wants a browser re-check from this machine. In a terminal run `ssh %s` and open the link it prints, then refresh."}
        if isinstance(exc, subprocess.TimeoutExpired):
            return {"why": "hang", "url": None, "action": "ssh to the node connected but never answered within %d s. Check the node's Tailscale SSH policy from this machine: `ssh -v %%s`." % PROBE_BUDGET}
        if "closed or filtered" in str(exc):
            return {"why": "port-closed", "url": None, "action": "Port 22 did not answer from this machine. Check the node is powered on and on the tailnet, then refresh."}
        if isinstance(exc, subprocess.CalledProcessError):
            # ssh says why on its last stderr line (a changed host key, a refused key, a
            # policy deny); the exception's own text is only the argv.
            said = last_line(redacted_tail(err))[:160].rstrip(".").replace("%", "%%")
            return {"why": "ssh-failed" if said else "error", "url": None,
                    "action": "ssh to the node exited %d: %s. Run `ssh %%s` in a terminal to see the whole message, then refresh." % (exc.returncode, said or "no error output")}
        return {"why": "error", "url": None, "action": "ssh to the node failed: %s" % (str(exc)[:120] or type(exc).__name__)}
    def _probe(node):
        result = {"jobs": None, "dumps": {}, "reachable": False, "detail": None}
        for attempt in (1, 2):                             # one retry: a cold route is not an answer, a hang is
            started = time.time()
            try:
                host, port = _target(node)
                if not port_open(host, port, timeout=1.0):
                    raise OSError("port %d closed or filtered" % port)
                probe = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", node, "python3 -"],
                                       input=PROBE, capture_output=True, text=True, timeout=PROBE_BUDGET)
                probe.check_returncode()
                inventory = parse_probe(probe.stdout)
                partial = bool(inventory.get("jobs_error") or inventory.get("storage_error") or
                               any(r.get("error") for r in inventory["jobs"] + inventory["storages"]))
                return {"inventory": inventory, "reachable": True, "detail": None, "partial": partial}
            except Exception as exc:
                d = _why(exc)
                if "%s" in d["action"]: d["action"] = d["action"] % node
                result = {"jobs": None, "dumps": {}, "reachable": False, "detail": d}
                if time.time() - started >= 3:             # it hung rather than failed: a second try would only hang again
                    break
        return result
    wanted = []                                            # (host record, node, vmid), registry order
    for h in fleet.get("hosts", []):
        meta = h.get("meta") or {}
        m = re.search(r"Proxmox node (\S+)", (meta.get("where") or "") + " " + (meta.get("kind") or ""))
        vm = re.search(r"\bVM (\d+)\b", meta.get("kind") or "")
        if m and vm:
            wanted.append((h, m.group(1).strip("()"), vm.group(1)))
    probed = {}
    todo = []
    for _, node, _ in wanted:
        if node in probed or node in todo:
            continue
        if node in cache and _fresh(node):
            probed[node] = cache[node]
        else:
            todo.append(node)
    if todo:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(max_workers=min(4, len(todo))) as pool:
            for node, res in zip(todo, pool.map(_probe, todo)):
                cache[node] = dict(res, _at=time.time(), version=2)
                probed[node] = cache[node]
    for h, node, vmid in wanted:
        pn = probed[node]
        hosts.append({"host": h["host"], "node": node, "vmid": vmid, "reachable": pn["reachable"],
                      "detail": pn.get("detail"), **vm_status(pn, vmid, time.time())})
    if todo:
        cache.pop("_at", None)                         # per-node stamps now, see _fresh
        try:
            os.makedirs(os.path.dirname(cache_p), exist_ok=True); json.dump(cache, open(cache_p, "w"))
        except OSError: pass
    bk["hosts"] = hosts
    return bk


def hypervisor_needs(backups):
    """One needs-you row per hypervisor node this machine could not read, carrying the
    cause and the owner's next step. A silent "unreachable" is not transparent: the
    2026-09-11 case was a Tailscale re-check link the app never showed."""
    rows, seen = [], set()
    for h in (backups or {}).get("hosts") or []:
        node = h.get("node")
        if h.get("reachable") or not node or node in seen:
            continue
        seen.add(node)
        vms = [x["host"] for x in backups["hosts"] if x.get("node") == node]
        d = h.get("detail") or {}
        action = d.get("action") or "The node did not answer from this machine. Check it is on and on the tailnet, then refresh."
        text = "Backup posture of %d VM%s on %s is unknown (%s). %s" % (len(vms), "" if len(vms) == 1 else "s", node, ", ".join(vms), action)
        cause = {"tailscale-check": "Tailscale SSH requires a browser re-check from this machine.",
                 "hang": "The SSH probe did not answer within its 6 second budget.",
                 "port-closed": "The node's SSH port did not answer the connection probe.",
                 "ssh-failed": "ssh to the node exited with an error, quoted in the next step.",
                 "error": "The SSH probe failed; the underlying cause is unconfirmed."}.get(d.get("why"), "The node did not return backup information.")
        row = {"kind": "hypervisor", "node": node, "text": text,
               "why": cause, "action": action,
               "verify": "Refresh; %s reports reachable and returns backup job and dump information. A missing backup remains a separate issue." % node}
        if d.get("url"): row["url"] = d["url"]
        rows.append(row)
    return rows


def fleet_needs(fleet):
    """Explain only an observed failed reachability check; absence is not a failure."""
    rows = []
    for host in (fleet or {}).get("hosts") or []:
        net = host.get("net") or {}
        if net.get("online") is not False:
            continue
        via = net.get("via")
        cause = ("Tailscale reports this device offline." if via == "tailscale" else
                 "The SSH port probe did not answer within its 1 second connection budget." if via in ("port 22 probe", "parallels") else
                 "The reported network check failed; the underlying cause is unconfirmed.")
        rows.append({"kind": "host", "host": host["host"],
                     "text": "This device cannot currently reach %s." % host["host"],
                     "why": cause,
                     "action": "Check the device is powered on and connected to its network%s. Open Sources → Devices and inspect %s, then refresh." %
                               (" with Tailscale signed in" if via == "tailscale" else "", host["host"]),
                     "verify": "Refresh; %s reports reachable. This verifies connectivity only; collection and hub acceptance have their own records." % host["host"]})
    return rows


def contribution_issues(backups):
    rows = []
    for lane in (backups or {}).get("lanes") or []:
        if lane.get("delivery") in ("accepted", "waiting"):
            continue
        issue = {"kind": "contribution", "lane": lane["lane"],
                 "text": "Hub acceptance is unknown for %s." % lane["lane"],
                 "why": lane.get("acceptance_reason") or
                        ("The hub could not verify whether the source commit is included." if lane.get("delivery") == "unknown" else
                         "The connected status service did not report an acceptance result."),
                 "action": "Open Backups → Copies and inspect this lane's source commit and hub connection. If the service is older, ask its maintainer to update it, then refresh.",
                 "verify": "The lane reports accepted or waiting after refresh. Only accepted confirms inclusion on the hub."}
        lane["acceptance_issue"] = issue
        rows.append(issue)
    return rows


def xcode_license_blocked(job):
    """A job that exited 69 whose error log ends in the Xcode shim's refusal. /usr/bin/python3
    on a Mac is that shim: after an Xcode update it refuses to run until the new license is
    accepted, and a launchd job that names it fails every tick. Only the tail is read: the
    log is append-only and keeps the refusals after the fix, so the exit code decides and
    the log explains."""
    err = job.get("stderr")
    if job.get("last_exit") != 69 or not err or not os.path.exists(err):
        return False
    try:
        with open(err, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 4096))
            tail = f.read().decode("utf-8", "ignore")
    except OSError:
        return False
    return "Xcode license" in tail


def explain_needs(rows):
    """Keep legacy summaries readable while giving each existing issue a next step.

    New producers must supply their own fields; unknown kinds remain visibly legacy.
    """
    guidance = {
        "archive": ("Cards and lanes are read from the archive folder, so an unreadable one would otherwise look like an empty archive.", "Check the folder at that path still exists, its drive is mounted and this machine may read it. If the archive moved on purpose, write its new path to ~/.brain-root.", "Refresh; Library lists the archive's cards again."),
        "configuration": ("The local machine role configuration is invalid.", "Repair the local connectors.json machine declaration, then request status again.", "Status reports the declared role without a configuration error."),
        "client-intake": ("The contribution intake reported a delivery or validation failure.", "Inspect the client receipt and retry after resolving its reported cause.", "Refresh status; delivery and hub import each show their own successful receipt."),
        "hub": ("The configured hub did not return status; its governance state is unknown.", "Open Sources → Devices, inspect the configured hub and restore its connection, then refresh.", "Refresh; the hub reports reachable and Review shows a current queue."),
        "gate": ("Proposals are waiting for an owner decision.", "Open Sovereign → Review to compare and decide (or curator-approve on the hub).", "After your decision, refresh Review; the handled proposal leaves the waiting queue."),
        "harness": ("The context connection needs the setup step described above.", "Open Sources, select this tool and follow the setup step above.", "Start a fresh tool session and refresh; its context hook is trusted and a new preparation receipt appears. Model use still requires separate evidence."),
        "mirror-missing": ("The declared mirror executable is missing.", "Open Sources for this lane and repair its connector installation.", "After the next connector tick, refresh; the lane records a successful run."),
        "lane-refused": ("The lane declaration does not fit the runner's execution limits.", "Inspect this lane's declaration in Sources. Correct the reported limit before the next connector tick.", "After the next tick, refresh; the lane is visited and no longer refused."),
        "lane-timeout": ("The lane exceeded its configured execution budget.", "Open Sources for this lane and inspect its error log to resolve the blocking operation.", "After the next connector tick, refresh; the lane finishes within its budget."),
        "lane-silent": ("The runner has not visited this enabled lane within its cadence.", "Inspect the lane error log named above in Sources and verify its runner declaration.", "After the next tick, refresh; the lane's checked time advances within its cadence."),
        "runner-standing-down": ("A previous connector tick still holds the runner lock.", "Open Settings → Jobs and inspect the connector runner log. Identify the still-running operation before any restart.", "Refresh after the next tick; it finishes and the stand-down count stops growing."),
        "runner-stalled": ("The connector runner has not recorded a completed tick within its cadence.", "Open Settings → Jobs and inspect the connector runner's loaded state and error log.", "After the next tick, refresh; the runner has a recent finish time and its lanes are visited."),
        "relay": ("The source and destination observations show an incomplete file relay.", "Open Backups → Copies and inspect the relay's source paths and error log. Restore a missing source or review the removal command above if intentional.", "After the next relay run, refresh; the vault copy catches up and the source error clears."),
        "xcode-license": ("The job's program is the /usr/bin/python3 Xcode shim, which refuses to run until the current Xcode license is accepted.", "Run sudo xcodebuild -license accept, then launchctl kickstart the named job. Reconnect a tool with sov connect to point the job at the Command Line Tools interpreter.", "Refresh after the kickstart; the job's last exit is 0 and its lanes report a fresh run."),
        "job": ("The scheduled job reported a failure or recent error-log output.", "Open Settings → Jobs, select the named job and inspect its error log before retrying.", "After the next successful run, refresh and confirm exit 0; inspect remaining log warnings separately."),
        "not-connected": ("No connected-system archive is configured on this device.", "Use your local archive, or open Sources to configure an optional connection.", "After connecting, refresh; the intended archive and tool appear.")}
    for row in rows:
        if row.get("kind") in guidance:
            for key, value in zip(("why", "action", "verify"), guidance[row["kind"]]):
                row.setdefault(key, value)
        if any(not row.get(key) for key in ("why", "action", "verify")):
            row["legacy"] = True
    return rows


def local_vms():
    """VMs a hypervisor on this machine knows about. Parallels: prlctl list. Others: none yet."""
    prl = shutil.which("prlctl") or "/usr/local/bin/prlctl"
    if not os.path.exists(prl):
        return []
    try:
        rows = json.loads(subprocess.run([prl, "list", "-a", "-j", "-o", "name,status,ip_configured,uuid,ostemplate"],
                                         capture_output=True, text=True, timeout=8).stdout or "[]")
    except (ValueError, subprocess.SubprocessError, OSError):
        return []
    out = []
    for r in rows:
        os_t = (r.get("ostemplate") or "").lower()
        if os_t.startswith(("win", "macos", "darwin")):
            continue                                   # the bootstrap is for Linux guests; others are not offered
        ip = (r.get("ip_configured") or "").strip()
        out.append({"tool": "parallels", "name": r.get("name"), "status": r.get("status"), "ip": ip if ip and ip != "-" else None,
                    "uuid": r.get("uuid"), "os": os_t or None})
    return out


def bootstrap_handoff():
    """What a fresh local VM needs from this machine: the hub's fleet key and the bootstrap
    script, placed under ~/.sovereign so the guest sees them through the shared home."""
    d = os.path.expanduser("~/.sovereign")
    os.makedirs(d, exist_ok=True)
    src = os.path.join(TEMPLATE_ROOT, "connectors", "harness", "_lib", "vm-bootstrap.sh")
    dst = os.path.join(d, "vm-bootstrap.sh")
    try:
        if os.path.exists(src) and (not os.path.exists(dst) or os.path.getmtime(src) > os.path.getmtime(dst)):
            shutil.copyfile(src, dst); os.chmod(dst, 0o755)
    except OSError:
        pass
    hub_pub = os.path.join(d, "hub.pub")
    # On the hub itself there is no ~/.brain-hub pointer, so read the key here rather
    # than over ssh. Assuming the pointer exists crashed the whole status on the hub,
    # which is where the console is most expected to work.
    hub = (pointer("~/.brain-hub") or "").split(":")[0]
    if not os.path.exists(hub_pub) and not hub:
        local_pub = os.path.expanduser("~/.ssh/sovereign_hub_ed25519.pub")
        if os.path.exists(local_pub):
            try: shutil.copyfile(local_pub, hub_pub)
            except OSError: pass
    if not os.path.exists(hub_pub) and hub:
        try:
            pub = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", hub, "cat ~/.ssh/sovereign_hub_ed25519.pub"],
                                 capture_output=True, text=True, timeout=12).stdout.strip()
            if pub.startswith("ssh-"):
                open(hub_pub, "w", encoding="utf-8").write(pub + "\n")
        except (subprocess.SubprocessError, OSError):
            pass
    mac_pub = os.path.join(d, "mac.pub")
    for cand in ("~/.ssh/id_ed25519.pub", "~/.ssh/id_rsa.pub"):
        cand = os.path.expanduser(cand)
        if not os.path.exists(mac_pub) and os.path.exists(cand):
            try: shutil.copyfile(cand, mac_pub)
            except OSError: pass
            break
    return {"script": dst if os.path.exists(dst) else None, "hub_key": os.path.exists(hub_pub),
            "line": "bash /media/psf/Home/.sovereign/vm-bootstrap.sh"}


def archive_shape(root):
    """The trusted layer, measured from the cards themselves: type and month mix, where
    cards come from, how long they run, and how well they link. The knowledge folder
    syncs to every machine, so this costs no hub call; the console turns it into the
    Archive view. Every list is slugs, so a count can open the cards behind it."""
    K = os.path.join(root, "knowledge")
    # The glob below finds nothing in a folder that is gone, unmounted or unreadable
    # (permissions or macOS privacy), and nothing is not zero cards: say which.
    try:
        os.listdir(K)
    except FileNotFoundError:
        raise OSError("%s folder not found" % ("knowledge" if os.path.isdir(root) else "archive"))
    except OSError:
        raise OSError("knowledge folder unreadable")
    WIKI = re.compile(r"\[\[([^\]|#]+?)(?:[|#][^\]]*)?\]\]")
    cards, inbound, slugs = [], {}, set()
    today = datetime.date.today()
    for p in sorted(glob.glob(os.path.join(K, "**", "*.md"), recursive=True)):
        try:
            t = open(p, encoding="utf-8", errors="ignore").read()
        except OSError:
            continue
        slug = os.path.basename(p)[:-3]
        slugs.add(slug)
        fm, body = {}, t
        if t.startswith("---"):
            end = t.find("\n---", 3)
            fm = dict(re.findall(r"(?m)^(\w+):\s*(.*)$", t[3:end])); body = t[end + 4:]
        src = fm.get("source", "")
        m = re.match(r"raw/(tools|workspaces)/([^/]+)", src)
        if m:
            bucket = m.group(2).split(" (")[0].strip()
        elif src.startswith("workstreams/") or src in ("sov", "owner"):
            bucket = "desk"
        elif src.startswith("http"):
            bucket = "web"
        elif src.startswith("raw/"):
            bucket = "legacy"
        else:
            bucket = "other"
        links = {x.strip().rsplit("/", 1)[-1] for x in WIKI.findall(body)}
        links.discard(slug)
        for l in links:
            inbound[l] = inbound.get(l, 0) + 1
        week = None
        try:
            cd = datetime.date.fromisoformat(fm.get("created", ""))
            age = (today - cd).days
            y, w, _ = cd.isocalendar()
            week = "%d-W%02d" % (y, w)
        except ValueError:
            age = None
        cards.append({"slug": slug, "rel": os.path.relpath(p, root)[:-3], "type": fm.get("type") or "?",
                      "month": (fm.get("created") or "")[:7] or "?", "week": week, "src": bucket,
                      "title": fm.get("title") or slug, "words": len(body.split()),
                      "out": len(links), "age_d": age, "targets": sorted(links)})
    for c in cards:
        c["in"] = inbound.get(c["slug"], 0)
    dangling = {}
    for c in cards:
        for l in c.pop("targets"):
            if l not in slugs:
                dangling.setdefault(l, []).append(c["slug"])
    words = sorted(c["words"] for c in cards) or [0]
    def count(key):
        d = {}
        for c in cards:
            d[c[key]] = d.get(c[key], 0) + 1
        return d
    return {"cards": cards, "total": len(cards),
            "by_type": count("type"), "by_month": count("month"), "by_src": count("src"),
            "words": {"median": words[len(words) // 2], "p90": words[int(len(words) * 0.9)], "max": words[-1]},
            "orphans": [c["slug"] for c in cards if c["in"] == 0],
            "zero_link": [c["slug"] for c in cards if c["out"] == 0],
            "over_length": [c["slug"] for c in cards if c["words"] > 450],
            "dangling": [{"target": k, "from": v} for k, v in sorted(dangling.items(), key=lambda kv: -len(kv[1]))]}


def hub_failure(via, exc=None, said=""):
    """Why the hub did not answer, as a phrase the console can show whole after "The hub
    did not answer: ", with the captured text, redacted, kept in error_detail."""
    detail = redacted_tail((getattr(exc, "stderr", None) or str(exc)) if exc is not None else said)
    if isinstance(exc, subprocess.TimeoutExpired):
        why = "no reply within %d seconds" % exc.timeout
    elif isinstance(exc, ValueError):
        why = "incomplete status report"
    else:
        why = last_line(detail)[:160] or (type(exc).__name__ if exc is not None else "no output")
    return {"reachable": False, "error": why, "error_detail": detail or None, "via": via}


def fetch_hub(root, hub_pointer, want):
    if not want:
        return {"reachable": None, "skipped": True}
    if hub_pointer and ":" in hub_pointer:
        alias, path = hub_pointer.split(":", 1)
        try:
            res = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=6", alias, "python3", "-", shlex.quote(path)],
                                 input=HUB_SCRIPT, capture_output=True, text=True, timeout=25)
            if res.returncode == 0 and res.stdout.strip():
                d = json.loads(res.stdout)
                d["via"] = "ssh " + alias
                return d
            return hub_failure("ssh " + alias, said=res.stderr)
        except Exception as e:
            return hub_failure("ssh " + alias, e)
    # this machine may be the hub
    if root and glob.glob(os.path.join(root, "raw", "workspaces", "*", "status.json")):
        try:
            res = subprocess.run([sys.executable, "-", root], input=HUB_SCRIPT, capture_output=True, text=True, timeout=25)
            d = json.loads(res.stdout)
            d["via"] = "local"
            return d
        except Exception as e:
            return hub_failure("local", e)
    return {"reachable": None, "error": "no ~/.brain-hub pointer and this machine holds no hub lane"}


def script_drift_finding(facts, whose):
    """Format a drift fact set, or None when the two sides agree.

    `whose` names the checkout the vendored hash came from, because from a client
    the revision belongs to the hub and would otherwise read as the client's own.
    """
    if not isinstance(facts, dict):
        return None
    ran, here = facts.get("ran"), facts.get("vendored")
    if not ran or not here or ran == here:
        return None
    at = facts.get("at")
    stamp = (datetime.datetime.fromtimestamp(int(at), datetime.timezone.utc)
             .strftime("%Y-%m-%d %H:%MZ") if at else "time unknown")
    rev = facts.get("rev") or ""
    return {"level": "warn",
            "text": "deployed script does not match the repo copy: ran %s (heartbeat %s) vs "
                    "vendored %s, %s%s. If that checkout is behind the exchange, pull before "
                    "investigating." % (ran[:8], stamp, here[:8], whose,
                                        " at " + rev if rev else "")}


def deployed_script_drift(lane, root):
    """Whether the exporter that RAN on a producer matches the copy in this checkout.

    The exporter hashes itself into its heartbeat tag, so this compares what ran with
    what is vendored here, never with a file on a disk nobody executed. Nothing is
    reported when the lane has no vendored copy (it was never brought into the repo,
    so it is not drifting from anything) or when the heartbeat predates the hash.

    The finding names both hashes, which side is which, and this checkout's revision,
    because "the producer drifted" and "this hub has not pulled yet" are the same
    observation from here. Every commit this morning opened a window where the hub was
    behind and a bare mismatch would have read as a leak on a machine that was correct.
    """
    vendored = os.path.join(TEMPLATE_ROOT, "connectors", "producers", lane + "-brain-daily")
    if not os.path.isfile(vendored):
        return None
    try:
        tag = subprocess.run(["git", "-C", root, "cat-file", "-p", "refs/heartbeats/" + lane],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    if tag.returncode != 0:
        return None
    m = re.search(r"^script_sha:\s*([0-9a-f]{64})\s*$", tag.stdout, re.M)
    if not m:
        return None                       # an exporter that predates the hash; say nothing
    ran = m.group(1)
    try:
        with open(vendored, "rb") as f:
            here = hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None
    when = re.search(r"^tagger .*?(\d{10}) ", tag.stdout, re.M)
    rev = ""
    try:
        r = subprocess.run(["git", "-C", TEMPLATE_ROOT, "rev-parse", "--short", "HEAD"],
                           capture_output=True, text=True, timeout=5)
        rev = r.stdout.strip() if r.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        pass
    return script_drift_finding({"ran": ran, "vendored": here, "rev": rev,
                                 "at": int(when.group(1)) if when else None}, "this checkout")


def lane_permission_findings(fm, name, root, retired=False):
    """Where a lane's declared permissions disagree with themselves or with the law.

    Every permission failure found on 2026-09-20 was this shape: the contract and the
    reality had drifted and nothing compared them. Two producers carried a read wire
    their owner never intended; a git-branch lane hit a mirror gate no contract
    declared; a lane the law never named had been running for weeks. None of it was
    hidden. Nothing looked.

    Contract-level only. Whether a producer actually holds the files its scope excludes
    can only be seen on that producer, not from here.
    """
    out = []
    val = lambda k: str(fm.get(k) or "").split("#")[0].strip()
    write, read, status = val("write"), val("read"), val("status")
    if retired or status == "retired":
        # Retiring a lane IS the resolution. Reporting it as unsettled would leave a row
        # the owner already answered, which is how a list of findings stops being read.
        return [{"level": "info", "text": "retired; kept as provenance, not a live wire"}]
    if write == "git-branch" and not fm.get("mirror_harnesses"):
        out.append({"level": "warn", "text": "git-branch lane declares no mirror_harnesses; the mirror refuses every harness until it does"})
    if read in ("none", "") and fm.get("read_scope"):
        out.append({"level": "warn", "text": "declares a read_scope while reading nothing; one of the two is stale"})
    if not read:
        out.append({"level": "warn", "text": "no read declared, so what this producer may see is unstated"})
    if not fm.get("gear"):
        out.append({"level": "warn", "text": "no trust gear declared"})
    try:
        law = open(os.path.join(root, "CLAUDE.md"), encoding="utf-8", errors="ignore").read()
        if name.lower() not in law.lower():
            out.append({"level": "warn", "text": "the law never names this lane, so no one agreed it should exist"})
    except OSError:
        pass
    return out


def _installed_app():
    """The canonical installed app, beside the source it was built from.

    Nothing compared the two until 2026-09-20, so one machine ran a 0.1 build-1
    prototype for months while the other moved through twenty-two builds and every
    release note truthfully said the first was "unchanged".

    Reads ~/Applications/Sovereign.app only. That is the project's one canonical
    install location, and deliberately not whatever the bundle id resolves to: four
    bundles shared com.sovereign.console on one machine and macOS picked the highest
    VERSION, which on that day was an unreleased build sitting in /private/tmp.
    """
    app = os.path.expanduser("~/Applications/Sovereign.app")
    info = os.path.join(app, "Contents", "Info.plist")
    if not os.path.isfile(info):
        return {"installed": False}
    out = {"installed": True, "path": app}
    try:
        import plistlib
        with open(info, "rb") as fh:
            d = plistlib.load(fh)
        out["version"] = d.get("CFBundleShortVersionString")
        out["build"] = d.get("CFBundleVersion")
        # Absent on anything built before the stamp existed, which is itself the answer.
        out["source_commit"] = d.get("SovereignSourceCommit")
    except Exception:
        out["unreadable"] = True
    return out


def _behind(commit, rev):
    """Whether this source's history holds the installed build, so building it is an update.

    Unequal is not newer: an app built from a worktree or a later branch differs from an
    older checkout, and rebuilding that checkout would install an older Sovereign. None
    when there is nothing to compare, including when the two are the same build."""
    commit = (commit or "").replace("+local", "")
    if not rev or not commit or rev.split(" ")[0] == commit:
        return None
    if not re.fullmatch(r"[0-9a-f]{4,40}", commit):
        return False
    try:
        return subprocess.run(["git", "-C", TEMPLATE_ROOT, "merge-base", "--is-ancestor", commit, "HEAD"],
                              capture_output=True, timeout=5).returncode == 0
    except Exception:
        return None


def main():
    if any(a in sys.argv[1:] for a in ("--help", "-h")):
        print(__doc__)
        return 0
    want_json = "--json" in sys.argv
    want_hub = "--no-hub" not in sys.argv
    root = os.environ.get("BRAIN_ROOT") or pointer("~/.brain-root")
    root = os.path.realpath(os.path.expanduser(root)) if root else None
    host = os.environ.get("BRAIN_HOST") or pointer("~/.brain-host") or socket.gethostname().split(".")[0].lower()
    core = os.environ.get("BRAIN_CORE") or pointer("~/.brain-core") or ""
    hub_pointer = pointer("~/.brain-hub")
    stage = (os.environ.get("BRAIN_STAGE") or os.environ.get("SOVEREIGN_STAGE")) or (os.path.expanduser("~/.vault-staging") if os.path.isdir(os.path.expanduser("~/.vault-staging")) else None)
    try:
        rev = subprocess.run(["git", "-C", TEMPLATE_ROOT, "log", "-1", "--format=%h %cs"], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        rev = None
    app = _installed_app()
    if app.get("installed"): app["behind"] = _behind(app.get("source_commit"), rev)

    out = {"generated_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
           "machine": {"vault": root, "vault_name": os.path.basename(root) if root else None, "host": host,
                       "core": [c for c in core.split(",") if c], "template": TEMPLATE_ROOT, "template_rev": rev,
                       "staging": stage, "connected": bool(root), "hub_pointer": hub_pointer,
                       "app": app}}
    try:
        intro = brain_discovery.describe()
        out["machine"].update({key: intro["machine"].get(key) for key in ("role", "client_mode", "role_basis")})
        out["machine"]["role_warnings"] = intro["warnings"]
    except (ValueError, OSError):
        out["machine"].update(role=None, client_mode=None, role_warnings=["Machine configuration could not be read."])
        out["needs_you"] = explain_needs([{"kind": "configuration", "text": "Connector configuration is unreadable.", "why": "The machine role cannot be established safely.", "action": "Inspect the connector manifest before reconnecting this machine.", "verify": "Refresh after correcting the manifest."}])
        print(json.dumps(out, indent=2)); return
    if out["machine"].get("client_mode") == "contribute-only":
        # This role has no archive read wire, even while a legacy pointer awaits cutover.
        receipt = brain_discovery.state_dir() / "contribution.json"
        try:
            if receipt.exists() and not receipt.is_symlink() and receipt.stat().st_size <= 1024 * 1024:
                out["contribution"] = json.loads(receipt.read_text())
        except (ValueError, OSError):
            out["contribution"] = {"state": "unreadable"}
        out["hub"] = {"reachable": None, "error": "Contribute-only client: no archive status requested."}
        out["needs_you"] = []
        for phase in ("collection", "delivery"):
            record = out.get("contribution", {}).get(phase, {})
            if record.get("state") in ("error", "partial"):
                out["needs_you"].append({"kind": "contribution", "text": "Client " + phase + " needs attention.", "why": record.get("reason") or "Some selected sources could not be collected.", "action": "Inspect the contribution receipt and configured source or intake connection; rerun the uploader after correcting it.", "verify": "The next receipt reports successful collection and confirmed delivery."})
        print(json.dumps(out, indent=2)); return
    if not root:
        out["needs_you"] = explain_needs([{"kind": "not-connected", "text": "Connected tools are not configured. Your local archive remains available."}])
        print(json.dumps(out, indent=2) if want_json else "not connected: no ~/.brain-root")
        return

    hub = fetch_hub(root, hub_pointer, want_hub)
    out["hub"] = hub
    if not out["machine"].get("role") and hub.get("via") == "local":
        out["machine"].update(role="hub", role_basis="local-hub-status")
    out["clients"] = hub.get("clients", [])
    hub_lanes = hub.get("lanes", {}) if isinstance(hub, dict) else {}
    hub_contrib = hub.get("contrib", {}) if isinstance(hub, dict) else {}

    # lanes on this machine
    lanes, seen = [], set()
    bases = ([os.path.join(stage, "raw", "tools")] if stage else []) + [os.path.join(root, "raw", "tools"), os.path.join(root, "raw", "workspaces")]
    for base in bases:
        for d in sorted(glob.glob(os.path.join(base, "*"))):
            if not os.path.isdir(d) or not os.path.exists(os.path.join(d, "LANE.md")):
                continue
            name = os.path.basename(d)
            if name in seen:
                continue
            seen.add(name)
            fm = frontmatter(os.path.join(d, "LANE.md"))
            st_dir = os.path.join(stage, "raw", "tools", name) if stage else None
            v_dir = next((p for p in (os.path.join(root, "raw", "tools", name), os.path.join(root, "raw", "workspaces", name)) if os.path.isdir(p)), None)
            lanes.append({"lane": name, "producer": fm.get("producer"), "host": fm.get("host"), "read": fm.get("read"),
                          "write": fm.get("write"), "status": fm.get("status"),
                          "relative_path": os.path.relpath(v_dir, root) if v_dir else "raw/tools/" + name,
                          "staging_age_h": age_h(newest_mtime(st_dir)) if st_dir and os.path.isdir(st_dir) else None,
                          "vault_age_h": age_h(newest_mtime(v_dir)) if v_dir else None,
                          "hub_age_h": (hub_lanes.get(name) or {}).get("age_h") if isinstance(hub_lanes.get(name), dict) else hub_lanes.get(name),
                          "hub_files": (hub_lanes.get(name) or {}).get("files") if isinstance(hub_lanes.get(name), dict) else None,
                          "cards": (hub_contrib.get(name) or {}).get("cards", 0),
                          "recent_cards": (hub_contrib.get(name) or {}).get("recent", []),
                          "last_run": manifest_last_run(d), "reads_7d": receipts_7d(d),
                          # The permission grant itself, so something can finally show it.
                          "gear": fm.get("gear"), "mirror_harnesses": fm.get("mirror_harnesses"),
                          "read_scope": bool(fm.get("read_scope")),
                          "_fm": fm})
    out["lanes"] = lanes

    # harness catalog + installed state
    rows = launchctl_rows()
    # the shared connector job, when this machine has one. Empty dicts on a machine that still
    # runs one job per tool, and every expression below falls back to the per-tool label.
    manifest, runs = runner_state()
    declared = manifest.get("harnesses") or {}
    retired = manifest.get("retired_harnesses") or {}
    for lane in lanes:
        lane["retired"] = any(r.get("lane") == lane["lane"] and not r.get("cleanup_pending") for r in retired.values())
        # Findings are computed here, not where the row is built, because a lane's retired
        # state is only known once the manifest has been read: retiring a lane is the
        # owner's answer to it, and an answered row must not keep asking.
        lane["findings"] = lane_permission_findings(lane.pop("_fm", {}) or {}, lane["lane"], root, lane["retired"])
        # A retired lane is not running, so its script cannot be drifting from anything.
        if not lane["retired"]:
            # Computed here when this machine can (it holds the refs and the checkout),
            # otherwise carried from the hub, which is the only other machine that can.
            # Never both: on the hub both paths see the same facts and would say it twice.
            drift = deployed_script_drift(lane["lane"], root)
            if drift is None:
                hub_entry = hub_lanes.get(lane["lane"])
                if isinstance(hub_entry, dict):
                    # Absent facts mean the hub could not answer, never "no drift".
                    drift = script_drift_finding(hub_entry.get("script"), "the hub's checkout")
            if drift:
                lane["findings"].append(drift)
    # The lanes that shared job actually serves. A calendar-cadence lane is in the manifest so
    # `sov disconnect all` can reach it, but it keeps its own job: it is not the runner's, and
    # every runner-shaped reading below (a synthetic lane row, the silence rules, the stall
    # rule, the count in the text view) must be taken over this subset, never over `declared`.
    served = {hid: ent for hid, ent in declared.items() if lane_ticks(ent)}
    r_label = runner_label(manifest)
    r_loaded = r_label in rows
    harnesses = []
    for hd in sorted(glob.glob(os.path.join(TEMPLATE_ROOT, "connectors", "harness", "*"))):
        h = os.path.basename(hd)
        if h.startswith("_") or not os.path.isdir(hd):
            continue
        meta = {}
        try:
            meta = json.load(open(os.path.join(hd, "harness.json")))
        except Exception:
            pass
        prefix = meta.get("lane_prefix", h)
        lane = meta.get("lane") or "%s-%s" % (prefix, host)   # a fixed name means one lane on every machine (cloud pulls)
        label = ("com.sovereign.connector.%s" if sys.platform == "darwin" else "sovereign-connector-%s") % h
        hook_path = next((p for p in glob.glob(os.path.join(hd, "session-start.*"))), None)
        hook_file = os.path.expanduser(meta.get("hook_file", "")) if meta.get("hook_file") else None
        hook_registered = None
        if hook_path and hook_file:
            try:
                hook_registered = hook_path in open(hook_file, encoding="utf-8").read()
            except OSError:
                hook_registered = False
        elif meta.get("instruction_text_file"):
            # instruction-based read wire in a plain rules file: registered when the sentinel is there
            try:
                hook_registered = meta.get("instruction_sentinel", "[Sovereign]") in open(os.path.expanduser(meta["instruction_text_file"]), encoding="utf-8").read()
            except OSError:
                hook_registered = False
        elif meta.get("instruction_glob"):
            # instruction-based read wire: registered when every space carries the sentinel
            total = covered = 0
            for sp_file in glob.glob(os.path.expanduser(meta["instruction_glob"])):
                try:
                    data = json.load(open(sp_file, encoding="utf-8"))
                    spaces = data.get("spaces") if isinstance(data, dict) else data
                    for sp in spaces or []:
                        total += 1
                        if meta.get("instruction_sentinel", "[Sovereign]") in (sp.get("instructions") or ""):
                            covered += 1
                except Exception:
                    pass
            hook_registered = (total > 0 and covered == total)
        git_lane = pointer("~/.brain-lane")
        if git_lane and os.path.isdir(os.path.join(root, "raw", "workspaces", git_lane)):
            lane = git_lane
            lane_dir = os.path.join(root, "raw", "workspaces", git_lane, prefix)
            lane_dir = lane_dir if os.path.isdir(lane_dir) else None
        else:
            lane_dir = next((p for p in ((os.path.join(stage, "raw", "tools", lane) if stage else None),
                                         os.path.join(root, "raw", "tools", lane)) if p and os.path.isdir(p)), None)
        # The per-tool label is checked FIRST, so a machine that has not migrated still reports
        # correctly from a migrated console. Then the lane: it is connected when this machine
        # declares it and the one shared job that runs it is loaded.
        lane_rec = runner_lane(h, manifest, runs)
        legacy_plist = os.path.exists(os.path.expanduser("~/Library/LaunchAgents/%s.plist" % label)) if sys.platform == "darwin" else False
        legacy_loaded = label in rows
        loaded = legacy_loaded or bool(lane_rec and lane_rec.get("enabled") and r_loaded)
        trusted = None
        if meta.get("trust_check") and hook_registered:
            try:
                trusted = subprocess.run([sys.executable, os.path.join(hd, meta["trust_check"]), "--check"],
                                         capture_output=True, text=True, timeout=10).returncode == 0
            except Exception:
                trusted = None
        read_kind = meta.get("read", "hook" if hook_path else "none")
        if read_kind == "hook":
            read_ok = hook_registered
        elif read_kind == "none":
            read_ok = True                       # write-only pipe: loaded is connected
        else:
            read_ok = hook_registered if hook_registered is not None else read_kind == "instruction"
        if trusted is False:
            read_ok = False
        state = "connected" if (loaded and read_ok) else ("partial" if (loaded or hook_registered) else "not connected")
        if h in retired:
            state = "removal incomplete" if retired[h].get("cleanup_pending") or loaded or hook_registered else "removed"
        detected = any(os.path.exists(os.path.expanduser(x)) for x in meta.get("detect", [])) if meta.get("detect") else None
        harnesses.append({"id": h, "name": meta.get("name", h), "lane": lane, "lane_dir": lane_dir, "label": label, "detected": detected,
                          "read": read_kind, "hook_file": hook_file, "hook_registered": hook_registered, "trusted": trusted,
                          "job_loaded": loaded, "declared": h in declared, "retired": h in retired,
                          "job": rows.get(label) or ({"pid": None, "last_exit": lane_rec.get("last_exit")} if lane_rec else None),
                          "plist": (plist_info(label) if (legacy_loaded or legacy_plist)
                                    else (lane_log_info(h, manifest, runs) if lane_rec else None)),
                          # cadence and the job that actually kicks this lane. `label` keeps its
                          # exact value: it is the console row id, the jump target and the name in
                          # every LANE.md; only its meaning shifts from launchd handle to lane id.
                          # A lane with its own job is not the runner's, so `lane_rec` is None
                          # for it; its declared calendar cadence is then the only one on a
                          # platform with no plist to read, and without it the console judges a
                          # daily pull against the 15-minute default it never claimed.
                          "cadence_s": ((lane_rec or {}).get("cadence_s")
                                        or _schedule_seconds(plist_info(label) if (legacy_loaded or legacy_plist) else None)
                                        or (declared.get(h) or {}).get("cadence_s")),
                          "kick": label if (legacy_loaded or legacy_plist) else (r_label if lane_rec else label),
                          "runs_in": r_label if (lane_rec and not (legacy_loaded or legacy_plist)) else label,
                          "last_run": file_last_run(meta) or (manifest_last_run(lane_dir) if lane_dir else None),
                          "last_status": one_line(meta.get("last_status_file")),
                          "reads_7d": receipts_7d(lane_dir) if lane_dir else {"total": 0, "real": 0},
                          "manual_step": meta.get("manual_step"), "secret": meta.get("secret"), "state": state,
                          "has_mirror": os.path.exists(os.path.join(hd, "mirror.sh")),
                          "instruction": os.path.join(hd, "INSTRUCTION.md") if os.path.exists(os.path.join(hd, "INSTRUCTION.md")) else None})
    # a cloud pull belongs on the hub: when this machine is not the hub, show the hub's record for it
    hub_cloud = {c["id"]: c for c in ((out.get("hub") or {}).get("cloud_harnesses") or [])}
    if hub_cloud and pointer("~/.brain-hub"):
        for h in harnesses:
            c = hub_cloud.get(h["id"])
            if c is None or h.get("detected") is not None:
                continue
            h.update({"runs_on": pointer("~/.brain-hub").split(":")[0] or (out.get("hub") or {}).get("hub_host"), "state": c["state"], "job_loaded": c["job_loaded"], "lane": c["lane"],
                      "label": c["label"], "last_status": c.get("last_status"), "hub_installed": c["installed"], "declared": c["installed"],
                      "last_run": ("Last run: %s" % c["last_success"]) if c.get("last_success") else None, "hook_registered": None})
    out["harnesses"] = harnesses

    # every tool the catalog can recognize on this machine, connector or not
    tools_found = []
    try:
        catalog = json.load(open(os.path.join(TEMPLATE_ROOT, "connectors", "harness", "_lib", "known-tools.json")))["tools"]
    except Exception:
        catalog = []
    connected_ids = {h["id"] for h in harnesses if h["state"] == "connected"}
    for t in catalog:
        det = any(os.path.exists(os.path.expanduser(x)) for x in t.get("detect", [])) if t.get("detect") else None
        tools_found.append({"id": t["id"], "name": t["name"], "detected": det, "connector": t.get("connector"),
                            "connected": (t.get("connector") in connected_ids) if t.get("connector") else False,
                            "note": t.get("note")})
    out["tools_found"] = tools_found

    # Obsidian, when its CLI is around: sync state and the vault name for open links
    obs = {"cli": None, "sync": None, "vault_name": os.path.basename(root)}
    for cand in (shutil.which("obsidian"), "/opt/homebrew/bin/obsidian", "/Applications/Obsidian.app/Contents/MacOS/obsidian-cli"):
        if cand and os.path.exists(cand):
            obs["cli"] = cand
            try:
                raw = subprocess.run([cand, "sync:status"], capture_output=True, text=True, timeout=8).stdout.strip()
                first = (raw.splitlines() or [""])[0]
                obs["sync"] = re.sub(r"(?i)^status:\s*", "", first).strip()[:40] or None
            except Exception:
                obs["sync"] = None
            break
    out["obsidian"] = obs

    out["fleet"] = fleet_view(root, hub_contrib)
    out["backups"] = backups_view(root, out.get("hub") or {}, out["fleet"])

    # the archive itself, from the cards (no hub call; the trusted layer syncs everywhere)
    try:
        out["archive"] = archive_shape(root)
    except Exception as e:
        out["archive"] = {"error": str(e)[:200]}

    # jobs on this machine: what the OS actually runs, plus one row per lane the shared
    # connector job serves. A lane row is synthetic on purpose - it keeps the per-lane exit
    # code, error log and Run-now button that seven separate jobs used to provide, so a lane
    # failure stays a DOWN verdict instead of a warn-level line.
    jobs = []
    for label, r in sorted(rows.items()):
        info = plist_info(label) if sys.platform == "darwin" else unit_info(label, manifest)
        jobs.append({"label": label, **r, **info})
        if label.startswith("com.sovereign.hub."):
            # A template-run hub job runs through the hub runner, whose receipts outlive what
            # launchd remembers: last run, last ok and last exit live in <state>/hub/, and so
            # does the job's own error log. The row reads those, so a job launchd has never
            # seen exit still shows when it ran and how it ended.
            hub_state = os.path.join(_state_dir(), "hub"); jid = label[len("com.sovereign.hub."):]
            def _receipt(name, _hub=hub_state, _jid=jid):
                try:
                    return int(open(os.path.join(_hub, "%s.%s" % (_jid, name))).read().strip())
                except (OSError, ValueError):
                    return None
            row = jobs[-1]
            row["last_run"], row["last_ok"] = _receipt("last-run"), _receipt("last-ok")
            if _receipt("last-exit") is not None:
                row["last_exit"] = _receipt("last-exit")
            # The runner captures the program's whole output, stdout too, in .last-output:
            # a kit receipt or "updates=0" is normal there, so it is what a failure points
            # at, never an error log. launchd's stderr is the error log; it only holds
            # failures outside the program (for example startup).
            err = os.path.join(hub_state, jid + ".error.log")
            n, a = _log_lines(err)
            row["stderr"], row["stderr_lines"], row["stderr_age_h"] = err, n, a
            out_p = os.path.join(hub_state, jid + ".last-output")
            row["last_output"] = out_p if os.path.exists(out_p) else None
    real = {j["label"] for j in jobs}
    for hid, ent in sorted(served.items()):
        lbl = ent.get("label") or (("com.sovereign.connector.%s" if sys.platform == "darwin" else "sovereign-connector-%s") % hid)
        if lbl in real:
            continue                      # a legacy per-tool job still carries this lane: no double row
        rec = runner_lane(hid, manifest, runs) or {}
        jobs.append({"label": lbl, "kick": r_label, "harness": hid, "lane": ent.get("lane"),
                     "pid": None, "last_exit": rec.get("last_exit"),
                     **lane_log_info(hid, manifest, runs)})
    out["jobs"] = jobs

    # the one mover, and which of its sources are really there. One exit code for three sources
    # would lose the attribution, so each source says whether it still exists.
    relay = manifest.get("relay")
    if isinstance(relay, dict):
        rl = relay.get("label") or relay_label(manifest)   # its name is platform-shaped, like the runner's
        out["relay"] = {"label": rl, "enabled": relay.get("enabled", True), "dest": relay.get("dest"),
                        "job_loaded": rl in rows, "last_exit": (rows.get(rl) or {}).get("last_exit"),
                        "sources": [{"path": src.get("path"), "kind": src.get("kind"), "name": src.get("name"),
                                     "exists": os.path.isdir(os.path.expanduser(src.get("path") or "/nonexistent"))}
                                    for src in (relay.get("sources") or []) if isinstance(src, dict)]}

    # needs you
    needs = []
    if out["archive"].get("error"):
        needs.append({"kind": "archive", "text": "The archive could not be read: %s. It is configured at %s." % (out["archive"]["error"], root)})
    if hub.get("reachable") is False:
        needs.append({"kind": "hub", "text": "The hub did not answer (%s). Governance state is unknown until it does." % hub.get("via", "?")})
    if hub.get("pending"):
        needs.append({"kind": "gate", "text": "%d proposal%s waiting at the gate. Open Sovereign → Review to compare and decide (or curator-approve on the hub)." % (hub["pending"], "" if hub["pending"] == 1 else "s")})
    for h in harnesses:
        if h.get("trusted") is False:
            needs.append({"kind": "harness", "harness": h["id"], "text": "%s: the hook is installed but not trusted. Run: sov connect %s --apply" % (h["name"], h["id"])})
        elif h["state"] == "connected" and h["read"] == "hook" and h["reads_7d"]["real"] == 0 and h["manual_step"]:
            needs.append({"kind": "harness", "harness": h["id"], "text": "%s: %s" % (h["name"], h["manual_step"])})
        elif h["state"] == "connected" and h["read"] == "instruction" and h["manual_step"]:
            needs.append({"kind": "harness", "harness": h["id"], "text": "%s: %s" % (h["name"], h["manual_step"])})
    needs.extend(hypervisor_needs(out.get("backups")))
    # lanes the shared connector job serves. Consolidation would otherwise invent one failure
    # mode: a lane quietly dropped from the loop produces no error anywhere while the shared job
    # stays green. `checked_at` is stamped for every enabled lane on every tick, so its age is
    # the anti-silence signal, and this is the most important rule here. A lane the runner
    # LOOKED at and refused is stamped too, so it gets a rule of its own below: it fires on the
    # first read after the refusal starts rather than waiting out two cadences.
    names = {x["id"]: x.get("name", x["id"]) for x in harnesses}
    lane_flagged = set()
    ticked = bool((runs.get("runner") or {}).get("tick_started"))
    for hid in sorted(served):
        lane = runner_lane(hid, manifest, runs) or {}
        if not lane.get("enabled"):
            continue
        nm = names.get(hid, hid)
        mirror = lane.get("mirror")
        # A lane the runner refuses is the quietest failure this design can produce: the
        # shared job stays green, the lane's error log stays empty, and nothing mirrors. It
        # is named here, by lane and by reason, on the first read after the refusal starts.
        refused = lane_refusal(lane, manifest)
        if refused:
            lane_flagged.add(hid)
            if refused == "mirror missing":
                kind = "mirror-missing"
                why = "the declared mirror script is gone (%s)" % (mirror or "none is declared")
                fix = "Run: sov connect %s --apply" % hid
            elif refused == "timeout exceeds interval":
                kind = "lane-refused"
                why = "its timeout (%ss) is longer than the %ss tick" % (lane_timeout(lane), runner_interval(manifest))
                fix = "Lower timeout_s below the tick, or give this lane a job of its own."
            else:
                kind, why, fix = "lane-refused", refused, ""
            needs.append({"kind": kind, "harness": hid,
                          "text": ("%s: the connector job refuses to run this lane, so nothing is mirroring it: %s. %s"
                                   % (nm, why, fix)).strip()})
            continue
        if lane.get("timed_out"):
            lane_flagged.add(hid)
            needs.append({"kind": "lane-timeout", "harness": hid,
                          "text": "%s: the mirror was killed after %ss. It is hanging." % (nm, lane_timeout(lane))})
        if not ticked:
            continue
        seen = iso_age_h(lane.get("checked_at"))
        cad = lane.get("cadence_s") or 900
        if seen is None or seen > 2 * (cad / 3600.0):
            needs.append({"kind": "lane-silent", "harness": hid,
                          "text": "%s: the connector job is running but has not visited this lane %s (cadence %ss). Check %s."
                                  % (nm, ("for %.1fh" % seen) if seen is not None else "at all", cad,
                                     os.path.join((manifest.get("runner") or {}).get("log_dir") or os.path.join(_state_dir(), "lanes"), "%s.error.log" % hid))})
    if served:
        fin = (runs.get("runner") or {}).get("tick_finished")
        iv = runner_interval(manifest)
        # A tick that cannot start because the last one still holds the lock is not a stall yet, so
        # it says nothing the first time. A streak of them, or a lock held longer than the interval
        # it is meant to fit inside, is the machine quietly mirroring nothing: name it.
        rr = runs.get("runner") or {}
        downs = rr.get("stand_downs") or 0
        held = rr.get("lock_held_s")
        if (isinstance(downs, int) and downs >= 2) or (isinstance(held, (int, float)) and held > iv):
            since = rr.get("stand_down_since")
            needs.append({"kind": "runner-standing-down",
                          "text": ("The connector job has stood down %d tick(s) in a row%s: the tick before it is still running%s, so no lane has mirrored since. Check %s."
                                   % (downs, (" since %s" % since[:16]) if since else "",
                                      (" and has held the lock %.0fs, past its %ss slot" % (held, iv)) if isinstance(held, (int, float)) else "",
                                      os.path.join(_state_dir(), "runner.error.log")))})
        fa = iso_age_h(fin)
        if fa is None or fa > 2 * (iv / 3600.0):
            needs.append({"kind": "runner-stalled",
                          "text": ("The connector job has not finished a tick since %s (every %ss). No lane on this machine is writing." % (fin, iv))
                                  if fin else
                                  ("%d lane(s) are declared but the connector job (%s) has never finished a tick. It runs at load, so check that it is loaded: launchctl print gui/$(id -u)/%s" % (len(served), r_label, r_label))})
    for src in ((out.get("relay") or {}).get("sources") or []):
        if not src.get("exists"):
            needs.append({"kind": "relay",
                          "text": "The mover's source %s is gone; the other sources still copied (exit 23). Run: sov relay remove %s, if that was deliberate."
                                  % (src.get("path"), src.get("name"))})
    for j in jobs:
        if j.get("harness") in lane_flagged:
            continue                      # the lane rule above already names this one, in its own words
        if xcode_license_blocked(j):
            needs.append({"kind": "xcode-license",
                          "text": "%s cannot start: its program is /usr/bin/python3, an Xcode shim, and the current Xcode license has not been accepted. Every scheduled run exits 69." % j["label"],
                          "why": "macOS routes /usr/bin/python3 through Xcode. After an Xcode update the shim refuses to run until the new license is agreed, and a launchd job that names it fails silently from then on.",
                          "action": "Run: sudo xcodebuild -license accept   then: launchctl kickstart gui/$(id -u)/%s. Reconnecting any tool with sov connect points the job at the Command Line Tools interpreter, which an Xcode update cannot revoke." % j["label"],
                          "verify": "Refresh after the kickstart; the job's last exit is 0 and its lanes report a fresh run."})
        elif j.get("last_exit") not in (None, 0):
            log = j.get("last_output") or j.get("stderr")     # a hub job's failure is in what its program printed
            n = {"kind": "job", "text": "%s last exited %s. Check %s." % (j["label"], j["last_exit"], log or "its log"), "failure_output": job_error_output(log)}
            if j.get("harness"):
                n["harness"] = j["harness"]        # a lane row routes to the tool, not to the job list
            needs.append(n)
        elif j.get("stderr_lines") and (j.get("stderr_age_h") if j.get("stderr_age_h") is not None else 0) <= 24:
            needs.append({"kind": "job", "harness": j.get("harness"),
                          "text": "%s: %s; error output was recorded within the last day." % (j["label"], "last run exited 0" if j.get("last_exit") == 0 else "last run status unknown"),
                          "why": "The error log still contains recent output. A successful exit can include skipped sources, so it does not by itself verify the failed operation recovered.",
                          "action": "Inspect the captured error output and verify the affected operation completes.",
                          "verify": "Confirm a new capture from the affected source. A suspended or skipped source does not verify recovery." if j.get("harness") else "Confirm the operation named in the error completes successfully.",
                          "failure_output": job_error_output(j.get("stderr"))})
    for l in lanes:
        sa, va = l.get("staging_age_h"), l.get("vault_age_h")
        if sa is not None and va is not None and va - sa > 1.0 and va > 2:
            needs.append({"kind": "relay", "text": "Lane %s: staging is %.1fh old but the vault copy is %.1fh old. The relay may be stuck." % (l["lane"], sa, va)})
    needs.extend(fleet_needs(out.get("fleet")))
    contribution_issues(out.get("backups"))  # Unknown evidence stays neutral; explain it on each lane.
    for client in out.get("clients", []):
        if client.get("state") in ("error", "rejected"):
            needs.append({"kind": "client-intake", "text": "Client intake needs attention: " + str(client.get("client_id", "unknown")), "why": client.get("reason") or "One or more submitted items failed the hub validation.", "action": "Inspect the client in System and the hub intake receipt. Correct the source or intake connection, then rerun the configured intake job.", "verify": "A new receipt reports the received head, imported captures and no rejected items."})
    out["needs_you"] = explain_needs(needs)

    if want_json:
        print(json.dumps(out, indent=2))
        return
    # text view
    m = out["machine"]
    print("vault   %s\nhost    %s\ncore    %s\nhub     %s" % (m["vault"], m["host"], ",".join(m["core"]) or "(none)",
          ("ok via %s, last nightly %s" % (hub.get("via"), (hub.get("status") or {}).get("generated_at", "?")[:16])) if hub.get("reachable") else hub.get("error") or "not checked"))
    def fmt(h): return "-" if h is None else ("%.1fh" % h if h < 48 else "%.0fd" % (h / 24))
    print("\nlanes (newest file age: staging -> vault -> hub)")
    for l in lanes:
        print("  %-22s %-6s %-6s %-6s reads7d=%-3d read: %s" % (l["lane"], fmt(l["staging_age_h"]), fmt(l["vault_age_h"]), fmt(l["hub_age_h"]), l["reads_7d"]["real"], l["read"]))
    print("\ntools on this machine")
    for h in harnesses:
        print("  %-12s %-14s hook=%s job=%s reads7d=%d%s" % (h["id"], h["state"], h["hook_registered"], h["job_loaded"], h["reads_7d"]["real"], ("  NOTE: " + h["manual_step"]) if h["manual_step"] and h["reads_7d"]["real"] == 0 else ""))
    if served:
        rr = runs.get("runner") or {}
        print("\nconnector job  %s  %s, every %ss, %d lane(s) declared, last tick %s" %
              (r_label, "loaded" if r_loaded else "NOT LOADED",
               (manifest.get("runner") or {}).get("interval_s", "?"), len(served),
               rr.get("tick_finished") or "never"))
    if needs:
        print("\nneeds you")
        for n in needs:
            print("  - " + n["text"])


if __name__ == "__main__":
    main()
