#!/usr/bin/env python3
"""sov-status: one honest JSON about this machine's place in the archive.

Everything the console app, the health check, and `sov status` show comes from
here, so there is one truth. Read-only. Never writes the vault.

Sections:
  machine    vault, host, core, template revision, whether this machine is the hub
  hub        the hub's state (local if this is the hub, else over ssh via ~/.brain-hub):
             last nightly, pending, tail, gears summary, last verdicts, card counts,
             per-lane freshness as seen from the hub, scheduler last runs
  lanes      every lane this machine has a copy of: contract fields plus freshness in
             staging, in the local vault copy, and on the hub
  harnesses  the connector catalog (connectors/harness/*/harness.json) with what is
             installed here: hook registered, launchd job loaded, last mirror run,
             reads in the last 7 days, the manual step if any
  jobs       every write wire on this machine: the real launchd/systemd jobs, plus one row
             per lane the shared connector job serves (its health comes from the runner's
             runs.json, not from a job of its own)
  relay      the one rsync mover, its destination and each declared source
  needs_you  the short list of things only the owner can do

One job or many: a machine may run one launchd job per tool (the old shape) or a single
shared connector job that runs every lane on a tick (the new one). Both are read here, the
per-tool label first, so a console on either shape reports the other machine correctly and
the fleet can migrate one machine at a time.

Config, all instance-level: ~/.brain-root, ~/.brain-host, ~/.brain-core,
  ~/.brain-hub ("sshalias:/path/to/vault"; absent when this machine is the hub).

Usage: sov-status [--json] [--no-hub]
"""
import os, sys, json, glob, time, subprocess, socket, re, plistlib, datetime, shlex, shutil, hashlib

HERE = os.path.dirname(os.path.realpath(__file__))   # brain-bin symlinks here; the catalog lives beside the real file
TEMPLATE_ROOT = os.path.abspath(os.path.join(HERE, ".."))
sys.path.insert(0, os.path.join(TEMPLATE_ROOT, "lib"))
import brain_discovery
NOW = time.time()
# launchd/systemd labels the status watches. The connector prefix is built in; an
# instance can add its own legacy prefixes in ~/.brain-job-prefixes (comma separated).
def _job_prefixes():
    extra = []
    try:
        extra = [x.strip() for x in open(os.path.expanduser("~/.brain-job-prefixes")).read().split(",") if x.strip()]
    except OSError:
        pass
    return tuple(["com.sovereign.", "sovereign-connector-"] + extra)
JOB_PREFIXES = _job_prefixes()
# sov-connectors-run's DEFAULT_TIMEOUT_S. A lane that declares no bound gets this one at
# run time, so the read side has to assume the same number or the two disagree about which
# lanes the tick is too short for.
RUNNER_DEFAULT_TIMEOUT_S = 300


def pointer(p):
    from sovereign_config import pointer as instance_pointer
    return instance_pointer(p)


def newest_mtime(path):
    best = 0
    for dp, dn, fn in os.walk(path):
        dn[:] = [d for d in dn if d != ".git"]
        for f in fn:
            try:
                best = max(best, os.path.getmtime(os.path.join(dp, f)))
            except OSError:
                pass
    return best or None


def age_h(mtime):
    return None if not mtime else round((NOW - mtime) / 3600, 2)


def frontmatter(path):
    out = {}
    try:
        lines = open(path, encoding="utf-8").read().split("\n")
    except OSError:
        return out
    if not lines or lines[0].strip() != "---":
        return out
    for line in lines[1:]:
        if line.strip() == "---":
            break
        m = re.match(r"^([A-Za-z_]+):\s*(.*)$", line)
        if m:
            # A '#' that opens the value or follows a space starts a YAML comment, which an
            # owner's note on a contract line is; one inside a URL or a name stays.
            out[m.group(1)] = re.sub(r"(^|\s)#.*$", "", m.group(2)).strip()
    return out


def manifest_last_run(lane_dir):
    for cand in (os.path.join(lane_dir, "MANIFEST.md"), os.path.join(lane_dir, "memory", "MANIFEST.md")):
        try:
            for line in open(cand, encoding="utf-8"):
                if line.startswith("Last run:"):
                    return line.strip()
        except OSError:
            continue
    return None


def one_line(path):
    if not path:
        return None
    try:
        return open(os.path.expanduser(path), encoding="utf-8").readline().strip() or None
    except OSError:
        return None


def file_last_run(meta):
    """A job that keeps its own last-success file (one ISO timestamp) reports it in the manifest's shape."""
    ts = one_line(meta.get("last_success_file"))
    return "Last run: %s" % ts if ts else None


def receipts_7d(lane_dir):
    p = os.path.join(lane_dir, "brain-load-usage.md")
    cutoff = (datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=7)).strftime("%Y-%m-%dT%H:%MZ")
    n, real = 0, 0
    try:
        for line in open(p, encoding="utf-8"):
            if line.startswith("- ") and line[2:19] >= cutoff:
                n += 1
                if "session=install-" not in line and "session=manual" not in line:
                    real += 1
    except OSError:
        pass
    return {"total": n, "real": real}


def systemd_rows():
    """Linux: sovereign-connector-* user timers."""
    rows = {}
    try:
        out = subprocess.run(["systemctl", "--user", "list-timers", "--all", "--no-legend", "--no-pager"], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return rows
    for line in out.splitlines():
        m = re.search(r"(sovereign-connector-[\w-]+)\.timer", line)
        if m:
            label = m.group(1)
            try:
                st = subprocess.run(["systemctl", "--user", "show", label + ".service", "-p", "ExecMainStatus", "--value"], capture_output=True, text=True, timeout=10).stdout.strip()
            except Exception:
                st = ""
            rows[label] = {"pid": None, "last_exit": int(st) if st.lstrip("-").isdigit() else None}
    return rows


def launchctl_rows():
    if sys.platform != "darwin":
        return systemd_rows()
    """Jobs in this user's GUI domain. `launchctl list` sees them only from inside that
    session (an ssh shell sees none), so every plist we know of is also probed with
    `launchctl print gui/<uid>/<label>`, which answers from anywhere."""
    rows = {}
    try:
        out = subprocess.run(["launchctl", "list"], capture_output=True, text=True, timeout=10).stdout
        for line in out.splitlines()[1:]:
            parts = line.split("\t")
            if len(parts) >= 3 and parts[2].startswith(JOB_PREFIXES):
                rows[parts[2]] = {"pid": None if parts[0] == "-" else int(parts[0]),
                                  "last_exit": int(parts[1]) if parts[1].lstrip("-").isdigit() else None}
    except Exception:
        pass
    for plist in glob.glob(os.path.expanduser("~/Library/LaunchAgents/*.plist")):
        label = os.path.basename(plist)[:-6]
        if not label.startswith(JOB_PREFIXES) or label in rows:
            continue
        try:
            pr = subprocess.run(["launchctl", "print", "gui/%d/%s" % (os.getuid(), label)], capture_output=True, text=True, timeout=10)
        except Exception:
            continue
        if pr.returncode == 0:
            m = re.search(r"last exit code = (-?\d+)", pr.stdout)
            rows[label] = {"pid": None, "last_exit": int(m.group(1)) if m else None}
    return rows


def _state_dir():
    return os.environ.get("SOV_STATE_DIR") or os.path.expanduser("~/.local/state/sovereign")


def runner_label(manifest=None):
    """The one job that runs every lane on this machine."""
    lbl = ((manifest or {}).get("runner") or {}).get("label")
    return lbl or ("com.sovereign.connector.runner" if sys.platform == "darwin" else "sovereign-connector-runner")


def relay_label(manifest=None):
    """The one rsync mover. It keeps its own log pair, relay.log / relay.error.log, and NOT the
    <label>.error.log every other unit gets, so the read side has to know its name by itself.
    A row pointed at a log the installer never writes reports a failing mover as "no log file",
    which is the silent failure this whole change exists to remove."""
    lbl = ((manifest or {}).get("relay") or {}).get("label")
    return lbl or ("com.sovereign.connector.relay" if sys.platform == "darwin" else "sovereign-connector-relay")


def lane_ticks(ent):
    """Does the shared runner serve this lane? A calendar-cadence lane (a cloud pull whose one
    run can outlive a tick) declares "tick": false: it is in the manifest so `sov disconnect all`
    can reach it, but it keeps its own job, and the runner never runs it, never counts it due and
    never stamps it. Every runner-shaped reading below has to skip it - the tick it would shorten,
    the synthetic lane row, the silence rules - or the console reports a lane as failing to tick
    when nothing was ever going to tick it, and doubles a row that its own job already fills.

    Read exactly as `sov connect` writes the flag and as the runner and `connect-all` read it,
    hand-written "false" included: four readers of one manifest disagreeing about one lane is
    how the console calls a lane ticking that nothing on the machine ever ticks."""
    if not isinstance(ent, dict):
        return False
    t = ent.get("tick", True)
    if isinstance(t, str):
        return t.strip().lower() not in ("false", "0", "no", "")
    return bool(t)


def runner_interval(manifest):
    """The tick the shared runner will actually use, computed the way it computes it: what
    the manifest declares, else the shortest enabled cadence. Read-time has to agree with
    run-time here, or a lane the runner refuses reads as a lane that is merely idle."""
    r = (manifest or {}).get("runner") or {}
    try:
        iv = int(r.get("interval_s"))
    except (TypeError, ValueError):
        iv = 0
    if iv > 0:
        return iv
    cads = []
    for e in ((manifest or {}).get("harnesses") or {}).values():
        if not isinstance(e, dict) or not e.get("enabled", True) or not lane_ticks(e):
            continue
        try:
            c = int(e.get("cadence_s"))
        except (TypeError, ValueError):
            continue
        if c > 0:
            cads.append(c)
    return min(cads) if cads else 900


def mirror_present(mirror):
    """The runner's own test for a usable mirror, character for character: a file, at the
    literal path the manifest declares. Read-time has to use run-time's test, or the two
    disagree about whether a lane is refused. Expanding a `~` here would be the friendlier
    read and the wrong one: the runner does not expand it, so it would refuse the lane while
    this said the mirror was fine, and the lane would stop writing in silence."""
    return bool(mirror) and os.path.isfile(mirror)


def lane_timeout(lane):
    """The bound the runner will really enforce: what the lane declares, else the runner's
    own default. Reading a missing timeout_s as 0 would call an over-tick lane healthy."""
    try:
        t = int(lane.get("timeout_s"))
    except (TypeError, ValueError):
        return RUNNER_DEFAULT_TIMEOUT_S
    return t if t > 0 else RUNNER_DEFAULT_TIMEOUT_S


def lane_refusal(lane, manifest):
    """Why the shared runner will not run this lane AT ALL, or None.

    A refusal is structural: it holds on every tick until the declaration or the disk
    changes, so it is not the same thing as a lane that simply was not due. It is computed
    here from those two facts ONLY, the way the runner computes it, so a lane the installer
    accepted and the runner will then refuse is loud before the first tick, and a refusal
    cured on disk clears without waiting for a tick.

    The run record's own `refused` is history and is deliberately not consulted: every row
    built from this carries a reason recomputed from the CURRENT declaration, so trusting a
    stale verdict prints a sentence the declaration contradicts ("its timeout (300s) is
    longer than the 900s tick"). The runner has exactly these two refusals, so nothing the
    record could say is lost by recomputing instead of copying."""
    if not mirror_present(lane.get("mirror")):
        return "mirror missing"
    if lane_timeout(lane) > runner_interval(manifest):
        return "timeout exceeds interval"
    return None


def runner_unit(label):
    """The file that job is declared in, per platform, or None when it is not installed."""
    p = (os.path.expanduser("~/Library/LaunchAgents/%s.plist" % label) if sys.platform == "darwin"
         else os.path.expanduser("~/.config/systemd/user/%s.service" % label))
    return p if os.path.exists(p) else None


def runner_state():
    """The shared connector job's two files: connectors.json, the declaration (written only by
    sov connect / disconnect / relay), and runs.json, the liveness record (written only by the
    runner). ({}, {}) on a machine that still runs one job per tool, so nothing else changes."""
    sd = _state_dir()

    def load(path):
        try:
            d = json.load(open(path, encoding="utf-8"))
        except (OSError, ValueError):
            return {}
        return d if isinstance(d, dict) else {}
    return (load(os.environ.get("SOV_MANIFEST") or os.path.join(sd, "connectors.json")),
            load(os.path.join(sd, "runs.json")))


def runner_lane(h, manifest, runs):
    """What is declared for harness h merged with what last happened to it, or None when this
    machine does not declare it, or declares it with its own job ("tick": false) so the runner
    never touches it and every field below would be somebody else's answer. The declaration
    wins on cadence, timeout and enabled; the run record carries the timing and the exit code
    that a per-tool job used to provide."""
    ent = (manifest.get("harnesses") or {}).get(h)
    if not isinstance(ent, dict) or not lane_ticks(ent):
        return None
    run = (runs.get("lanes") or {}).get(h) or {}
    lane = dict(ent)
    lane["enabled"] = ent.get("enabled", True)
    lane["cadence_s"] = ent.get("cadence_s") or run.get("cadence_s") or (manifest.get("runner") or {}).get("interval_s") or 900
    for k in ("checked_at", "attempted_at", "finished_at", "duration_s", "last_exit",
              "timed_out", "in_flight", "skipped"):
        lane[k] = run.get(k)
    lane["ran"] = bool(run)
    # Whether this lane is refused is a fact about the declaration and the disk as they are
    # NOW, never what the last tick found: the record's copy outlives the fix and would keep
    # a cured lane red until a tick proved otherwise. `skipped` above stays the record's,
    # because that one is history on purpose.
    lane["mirror_missing"] = not mirror_present(lane.get("mirror"))
    lane["refused"] = lane_refusal(lane, manifest) if lane["enabled"] else None
    return lane


def _short_program(prog):
    """Long argv, readable in a row: head, ellipsis, tail. The full string stays in program_full."""
    prog = prog or ""
    return prog if len(prog) <= 81 else prog[:40] + "…" + prog[-40:]


def _schedule_seconds(info):
    """The cadence a plist declares, so a machine with per-tool jobs still reports cadence_s."""
    if (info or {}).get("cadence_s"):
        return info["cadence_s"]
    m = re.search(r"every (\d+)s", ((info or {}).get("schedule") or ""))
    return int(m.group(1)) if m else None


def _log_lines(path):
    n, a = None, None
    if path and os.path.exists(path):
        try:
            n = sum(1 for _ in open(path, errors="ignore"))
            a = age_h(os.path.getmtime(path))
        except OSError:
            pass
    return n, a


def job_error_output(path):
    """Bounded, redacted diagnostic output for the same log the job row names."""
    if not path or os.path.islink(path) or not os.path.isfile(path):
        return ""
    try:
        with open(path, errors="replace") as stream:
            raw = stream.read(65537)
        if len(raw) > 65536:
            return ""
        from brain_redact import redact_text
        clean, _ = redact_text(raw)
        return "\n".join(clean.splitlines()[-35:])[:8000]
    except OSError:
        return ""


def redacted_tail(text, limit=400):
    """Captured output as the console may show it: credentials redacted before the tail is
    cut, and nothing when redaction fails, never the raw text."""
    if isinstance(text, bytes):
        text = text.decode("utf-8", "replace")
    try:
        from brain_redact import redact_text
        return redact_text(text or "")[0].strip()[-limit:]
    except Exception:
        return ""


def last_line(text):
    return next((l.strip() for l in reversed((text or "").splitlines()) if l.strip()), "")


def lane_log_info(h, manifest, runs=None):
    """The plist-shaped record the console already reads, sourced from the runner instead of a
    per-tool job. One log pair per lane, same path formula on both platforms, so a clean lane
    reports 0 lines rather than null (null renders as "no log", which reads as "never ran")."""
    lane = runner_lane(h, manifest, runs or {}) or {}
    lanes_dir = (manifest.get("runner") or {}).get("log_dir") or os.path.join(_state_dir(), "lanes")
    err = os.path.join(lanes_dir, "%s.error.log" % h)
    n, a = _log_lines(err)
    return {"plist": runner_unit(runner_label(manifest)),
            "schedule": "every %ss" % lane.get("cadence_s", 900),   # the console parses this
            "program": _short_program(lane.get("mirror")), "program_full": lane.get("mirror"),
            "stderr": err, "stderr_lines": n, "stderr_age_h": a}


def unit_info(label, manifest=None):
    """systemd's answer to plist_info: what a real user unit shows on Linux."""
    manifest = manifest or {}
    unit = os.path.expanduser("~/.config/systemd/user/%s.service" % label)
    if label == runner_label(manifest):
        err = os.path.join(_state_dir(), "runner.error.log")
        iv = (manifest.get("runner") or {}).get("interval_s")
        sched = "every %ss" % iv if iv else "systemd timer"
    elif label == relay_label(manifest):
        # The mover writes relay.error.log, not <label>.error.log. Falling through to the
        # generic name below names a file nothing ever creates, so a mover that is failing
        # every tick reads as one with no log at all.
        err = os.path.join(_state_dir(), "relay.error.log")
        iv = (manifest.get("relay") or {}).get("interval_s")
        sched = "every %ss" % iv if iv else "systemd timer"
    else:
        err = os.path.join(_state_dir(), "%s.error.log" % label)
        sched = "systemd timer"
    n, a = _log_lines(err)
    return {"plist": unit if os.path.exists(unit) else None, "schedule": sched,
            "program": None, "program_full": None, "stderr": err, "stderr_lines": n, "stderr_age_h": a}


def iso_age_h(ts):
    if not ts:
        return None
    try:
        d = datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
    except ValueError:
        return None
    if not d.tzinfo:
        d = d.replace(tzinfo=datetime.timezone.utc)
    return round((NOW - d.timestamp()) / 3600, 2)


def plist_info(label):
    p = os.path.expanduser("~/Library/LaunchAgents/%s.plist" % label)
    info = {"plist": p if os.path.exists(p) else None, "schedule": None, "cadence_s": None, "program": None,
            "program_full": None, "stderr": None, "stderr_lines": None, "stderr_age_h": None}
    if not info["plist"]:
        return info
    try:
        d = plistlib.load(open(p, "rb"))
    except Exception:
        return info
    # A property list is not always a dict: an array or a bare string parses fine and has
    # no .get. Such a file in ~/Library/LaunchAgents is somebody else's, and it may cost
    # this one row its schedule, never every row in the console.
    if not isinstance(d, dict):
        return info
    ci, si = d.get("StartCalendarInterval"), d.get("StartInterval")
    if isinstance(ci, dict):
        ci = [ci]
    if ci:
        info["schedule"] = " | ".join("wd=%s %02d:%02d" % (c.get("Weekday", "*"), c.get("Hour", 0), c.get("Minute", 0)) for c in ci)
        # a calendar job has a cadence too, and saying so keeps a daily pull from being
        # judged against a 15-minute default it never claimed
        info["cadence_s"] = (604800 if any("Weekday" in c for c in ci) else 86400) // max(1, len(ci))
    elif si:
        info["schedule"] = "every %ss" % si
        info["cadence_s"] = int(si) if str(si).isdigit() else None
    prog = " ".join(str(x) for x in (d.get("ProgramArguments") or [d.get("Program", "")]))
    info["program_full"] = prog
    info["program"] = _short_program(prog)   # a multi-source rsync argv is unreadable tail-only
    err = d.get("StandardErrorPath")
    info["stderr"] = err
    if err and os.path.exists(err):
        try:
            info["stderr_lines"] = sum(1 for _ in open(err, errors="ignore"))
            info["stderr_age_h"] = age_h(os.path.getmtime(err))
        except OSError:
            pass
    return info


HUB_SCRIPT = r'''
import os, sys, json, glob, re, time, subprocess, hashlib
import datetime
root = sys.argv[1]; now = time.time()
def scan(path):
    best = 0; n = 0
    for dp, dn, fn in os.walk(path):
        dn[:] = [d for d in dn if d != ".git"]
        for f in fn:
            n += 1
            try: best = max(best, os.path.getmtime(os.path.join(dp, f)))
            except OSError: pass
    return (best or None), n
out = {"reachable": True, "root": root, "lanes": {}, "jobs": {}}
# Intake receipts belong to this hub's state directory, never a mirrored archive.
client_fields = ("client_id", "role", "client_mode", "lane", "state", "attempted_at", "received_at", "imported_at", "collected_at", "received", "imported_current", "head", "promotion", "reason", "rejections")
out["clients"] = []
for receipt in sorted(glob.glob(os.path.join(os.environ.get("SOV_STATE_DIR") or os.path.expanduser("~/.local/state/sovereign"), "intake-*.json")))[:100]:
    try:
        if os.path.islink(receipt) or os.path.getsize(receipt) > 8 * 1024 * 1024: continue
        record = json.load(open(receipt))
        if isinstance(record, dict) and record.get("archive_root") == os.path.realpath(root): out["clients"].append({k: record[k] for k in client_fields if k in record})
    except (OSError, ValueError): pass
lane_name = None
for cand in glob.glob(os.path.join(root, "raw", "workspaces", "*", "status.json")):
    lane_name = os.path.basename(os.path.dirname(cand))
    try: out["status"] = json.load(open(cand)); out["status_age_h"] = round((now - os.path.getmtime(cand)) / 3600, 2)
    except Exception: pass
    lane = os.path.dirname(cand)
    # A gate verdict rewrites status.json with a minimal shape and drops the run
    # telemetry. The digest the nightly wrote survives that, so fill the gaps from it.
    st = out.setdefault("status", {})
    try:
        inbox = open(os.path.join(lane, "INBOX.md"), errors="ignore").read()
        m = re.search(r"(\d+) proposal\(s\) from (\d+) new item", inbox)
        if m:
            st.setdefault("new_proposals", int(m.group(1))); st.setdefault("judged", int(m.group(2)))
        m = re.search(r"Coverage: (\d+) processable . (\d+) judged-ever . (\d+) stranded pre-watermark . (\d+) awaiting", inbox)
        if m:
            cov = st.setdefault("coverage", {})
            cov.setdefault("processable", int(m.group(1))); cov.setdefault("judged_ever", int(m.group(2)))
            cov.setdefault("stranded_pre_watermark", int(m.group(3))); cov.setdefault("unjudged_in_window", int(m.group(4)))
        m = re.search(r"(\d+) newer item\(s\) beyond --max were deferred", inbox)
        if m: st.setdefault("deferred", int(m.group(1)))
        sec = inbox.split("## Auto-applied", 1)
        st.setdefault("auto_promoted", len(re.findall(r"(?m)^- \*\*", sec[1])) if len(sec) > 1 else 0)
        m = re.search(r"(?m)^# Archivist digest . (\S+ \S+)", inbox)
        if m: out["digest_at"] = m.group(1)
    except OSError:
        pass
    out["lane"] = lane_name
    out["pending"] = len(glob.glob(os.path.join(lane, "proposals", "*.md")))
    try:
        lines = [l.rstrip("\n").split("\t") for l in open(os.path.join(lane, "decisions.log"), errors="ignore")]
        out["decisions_tail"] = [{"ts": l[0], "verdict": l[1], "slug": l[2], "actor": l[3]} for l in lines[-6:] if len(l) >= 4]
    except OSError: pass
    try:
        g = json.load(open(os.path.join(lane, "gears.json")))
        out["gears"] = {k: v.get("gear") for k, v in g.get("rules", {}).items()}
    except Exception: pass
    # the judge, by ISO week: judgments.jsonl is append-only and hub-only, so this is
    # the one place the keep-rate trend can be read (50% -> 3% went unseen for a month)
    try:
        wk = {}
        for line in open(os.path.join(lane, "judgments.jsonl"), errors="ignore"):
            try: d = json.loads(line)
            except Exception: continue
            ts = (d.get("timestamp") or "")[:10]
            if len(ts) != 10: continue
            try: y, w, _ = datetime.date.fromisoformat(ts).isocalendar()
            except ValueError: continue
            e = wk.setdefault("%d-W%02d" % (y, w), [0, 0])
            e[0] += 1
            if d.get("promote"): e[1] += 1
        keys = sorted(wk)[-12:]
        out["judge"] = {"weeks": [{"week": k, "judged": wk[k][0], "kept": wk[k][1]} for k in keys],
                        "total_judged": sum(v[0] for v in wk.values())}
    except OSError:
        pass
    # the queue, for the gate: what each pending proposal is and why it is waiting.
    # The INBOX bullet carries confidence, flags, reason and any hold note; .meta.json
    # carries confidence/update_of; the proposal file carries the card itself.
    try: pmeta = json.load(open(os.path.join(lane, "proposals", ".meta.json")))
    except Exception: pmeta = {}
    try: inbox_txt = open(os.path.join(lane, "INBOX.md"), errors="ignore").read()
    except OSError: inbox_txt = ""
    props = []
    for pp in sorted(glob.glob(os.path.join(lane, "proposals", "*.md")), key=os.path.getmtime, reverse=True)[:60]:
        slug = os.path.basename(pp)[:-3]
        try: txt = open(pp, encoding="utf-8", errors="ignore").read()
        except OSError: continue
        fm, body = {}, txt
        if txt.startswith("---"):
            end = txt.find("\n---", 3)
            fm = dict(re.findall(r"(?m)^(\w+):\s*(.*)$", txt[3:end])); body = txt[end + 4:]
        m = re.search(r"(?m)^- \*\*%s\*\* \(([^)]*)\)((?: ⚠ \w+)*) — (.*)$" % re.escape(slug), inbox_txt)
        head = m.group(1).split(", ") if m else []
        reason = m.group(3) if m else ""
        hold = None
        if " · held: " in reason:
            reason, hold = reason.split(" · held: ", 1)
        mm = pmeta.get(slug) or {}
        upd = mm.get("update_of") or (head[2][7:] if len(head) > 2 and head[2].startswith("UPDATE ") else None)
        props.append({"slug": slug, "type": fm.get("type"), "title": fm.get("title") or slug, "source": fm.get("source"),
                      "confidence": mm.get("confidence") or (head[1] if len(head) > 1 else None),
                      "update_of": upd, "flags": [f for f in (m.group(2).split(" ⚠ ") if m else []) if f],
                      "reason": reason, "hold": hold, "words": len(body.split()),
                      "age_h": round((now - os.path.getmtime(pp)) / 3600, 1), "body": body.strip()[:2500]})
    out["proposals"] = props
    stop = os.path.join(lane, ".burndown-stop")
    out["burndown"] = {"stopped": os.path.exists(stop),
                       "note": (open(stop, errors="ignore").read().strip()[:200] if os.path.exists(stop) else None)}
    try:
        gb = g.get("_grants_basis", "")
        i = gb.rfind(" 20")
        out["gears_note"] = (gb[i + 1:] if i != -1 else gb)[:420]
    except Exception:
        pass
    aud = sorted(glob.glob(os.path.join(lane, "audit", "audit-*.md")))
    out["audit_latest"] = os.path.basename(aud[-1]) if aud else None
    break
