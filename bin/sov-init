#!/usr/bin/env bash
#
# sov-init — stand up a fresh, empty archive from this template.
#
#   sov-init <target-dir> [instance-name]
#
# Lays down the five-folder skeleton, the rules (CLAUDE.md), and the note template,
# then git-inits it. Running it in an empty dir yields a clean, fork-ready archive.

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  sed -n '2,/^set -/{ /^set -/d; /^if /,$d; p; }' "$0"
  exit 0
fi

set -euo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
TARGET="${1:?usage: sov-init <target-dir> [instance-name]}"
NAME="${2:-$(basename "$TARGET")}"

mkdir -p "$TARGET"
rsync -a "$HERE/skeleton/" "$TARGET/"
mkdir -p "$TARGET/.obsidian/templates"
cp "$HERE/templates/note.md" "$TARGET/.obsidian/templates/note.md"
# drop the rules in, stamped with the archive's name
sed "s/{{SOVEREIGN_NAME}}/$NAME/g; s/{{BRAIN_NAME}}/$NAME/g" "$HERE/CLAUDE.md" > "$TARGET/CLAUDE.md"

# The ignore file and the first commit come from the same function the app uses, so the
# two ways of making an archive cannot drift. Without git the archive still stands.
. "$HERE/bin/_sov-python.sh"
"$(sov_python "$HERE")" -I -B - "$HERE/lib" "$TARGET" "$NAME" <<'PY'
import sys
sys.path.insert(0, sys.argv[1])
import brain_local
out = brain_local.init_repository(sys.argv[2], sys.argv[3])
if not out['git']:
    print(out['git_message'], file=sys.stderr)
PY

echo "Archive '$NAME' created at $TARGET"
echo "Next: open it in Obsidian, set the Templates folder to .obsidian/templates, write your first note, then run:"
echo "  $HERE/bin/sov-check \"$TARGET\""
