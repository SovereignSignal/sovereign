#!/usr/bin/env python3
"""Symlink-safe entry point for importing another tool's memories (lib/sovereign_import.py)."""
from pathlib import Path
import sys

repository = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(repository / "lib"))

from sovereign_import import main  # noqa: E402

raise SystemExit(main(sys.argv[1:]))
