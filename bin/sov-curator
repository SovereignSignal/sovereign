#!/usr/bin/env python3
"""sov-curator — the curator on a single Mac, for an archive with no hub.

An operator's archive is curated by its hub (`sov hub`). A newcomer's archive has none,
so this runs curator-run on this Mac, on the hosted provider its owner chose (Anthropic
unless they picked another with `sov curator provider`, under the owner's own key for
that provider, read from the login Keychain), every two hours. It starts
in ask-first: nothing lands by itself and every proposal waits in Review. Once its
judgments have earned it, the owner can run `sov curator trust --apply` to let routine
concept and synthesis cards (high and medium confidence) land on their own and report
back, at most 12 per pass. Flagged items, entities, and anything destructive still ask,
auto-rejection stays off, and `sov curator trust --off --apply` returns to ask-first.

  sov curator enable [--every SECONDS] [--apply]   the two-hourly job (dry run without --apply)
  sov curator run                                  one pass now (the app's "Curate now")
  sov curator trust [--off] [--apply]              let routine cards land on their own (dry run without --apply)
  sov curator retire <slug> [--apply]              retire a recent background landing (dry run without --apply)
  sov curator status [--json]
  sov curator disable [--apply]
  sov curator provider [name] [--apply]            show or choose the hosted provider
                                                   (anthropic, openai, gemini, grok, muse);
                                                   a switch returns trust to ask-first
  sov curator key                                  save the owner's key for the chosen
                                                   provider in the login Keychain, from
                                                   $SOV_CURATOR_KEY or stdin

The key is never an argument and never written to disk. It goes to /usr/bin/security on
stdin, which creates the Keychain item, so the scheduled job (which reads it with the same
tool) does not raise a Keychain prompt every two hours.
"""
import argparse, bisect, json, os, plistlib, re, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))
from sovereign_config import pointer
from sovereign_hub.digest_counts import parse_epoch

LABEL = "com.sovereign.curator"
# The hosted providers a hubless archive's owner may choose (rule 5, amended
# 2026-10-18): one at a time, under their own account. curator-run owns the
# endpoints and model defaults; here we own the choice, each provider's
# Keychain item, and what a plausible key looks like (prefix None = shape only).
PROVIDERS = {
    "anthropic": {"name": "Anthropic", "backend": "anthropic", "prefix": "sk-ant-", "minlen": 40, "hint": "sk-ant-…"},
    "openai": {"name": "OpenAI", "backend": "openai", "prefix": "sk-", "minlen": 40, "hint": "sk-…"},
    "gemini": {"name": "Google Gemini", "backend": "openai", "prefix": None, "minlen": 20, "hint": "API key…"},
    "grok": {"name": "xAI Grok", "backend": "openai", "prefix": "xai-", "minlen": 40, "hint": "xai-…"},
    "muse": {"name": "Muse", "backend": "openai", "prefix": None, "minlen": 20, "hint": "API key…"},
}
LANE = "curator"
STATE = Path(os.environ.get("SOV_STATE_DIR") or "~/.local/state/sovereign").expanduser()
UNIT = Path("~/Library/LaunchAgents").expanduser() / (LABEL + ".plist")
TRUST_STATE = STATE / "curator-trust.json"
PROVIDER_STATE = STATE / "curator-provider.json"
TRUST_CAP = "12"
TRUST_TYPES = ("concept", "synthesis")
TRUST_CONFIDENCE = ["high", "med"]
TRUST_SUGGESTION_THRESHOLD = 10
TRUST_LANDED_WINDOW_S = 30 * 86400
AUTO_ACTORS = {"auto-gear", "auto-taste"}


def vault():
    v = os.environ.get("SOVS_VAULT") or pointer("~/.brain-root")
    root = Path(v).expanduser() if v else None
    if not root or not (root / "knowledge").is_dir():
        sys.exit("no archive: connect a tool to it first, or set SOVS_VAULT")
    return root


def refuse_on_hub():
    # A hub curates on owned inference from its own jobs; a second, hosted curator on
    # the same Mac would judge the same raw twice under a different law.
    if Path("~/.sovereign-hub").expanduser().exists() or (STATE / "hub.json").exists():
        sys.exit("this Mac runs a hub; its curator runs from `sov hub`, not here")


def python():
    return os.environ.get("SOV_PYTHON") or sys.executable


def trust_on():
    try:
        return bool(json.loads(TRUST_STATE.read_text()).get("act_and_report"))
    except Exception:
        return False


def provider():
    try:
        p = json.loads(PROVIDER_STATE.read_text()).get("provider")
    except Exception:
        p = None
    return p if p in PROVIDERS else "anthropic"


def keychain_service(provider_id):
    return f"sovereign-curator-{provider_id}"


def curator_env(root):
    p = provider()
    env = {"SOVS_VAULT": str(root), "CURATOR_LANE": LANE, "CURATOR_PROVIDER": p,
           "CURATOR_BACKEND": PROVIDERS[p]["backend"],
           "CURATOR_SCREEN": "on", "ARCHIVIST_AUTO_PROMOTE_MAX": TRUST_CAP if trust_on() else "0",
           "ARCHIVIST_AUTO_REJECT_MAX": "0",
           "PATH": "/usr/bin:/bin:/usr/sbin:/sbin"}
    if "/Contents/Resources/runtime/bin/" in python():
        env["PYTHONDONTWRITEBYTECODE"] = "1"  # never write caches into the signed app bundle
        env["PATH"] = str(HERE / "git-guard") + ":" + env["PATH"]  # no developer-tools installer prompt
    return env


# The curator's default answer is no, and its bar is set for an established archive. In a
# new one, the owner's first notes about themselves are exactly what should become cards,
# so a fresh lane gets this owner profile (the standard's own lever, read with every
# judgment). The owner edits or replaces it; it is never overwritten.
STARTER_PROFILE = """This archive is new, and its owner is setting it up. What the owner says about themselves comes straight from the owner and is durable: a project they are building, a goal, a decision they made, a constraint, a preference about how they work. Each of these is card-worthy even when it is said in one or two sentences, because it is exactly what their future sessions need to know. Machine output such as run logs, manifests and folder listings is not.
"""


def seed_profile(root):
    lane = root / "raw" / "workspaces" / LANE
    profile = lane / "profile.md"
    if not profile.exists():
        lane.mkdir(parents=True, exist_ok=True)
        profile.write_text(STARTER_PROFILE)
        print(f"curator: wrote a starter owner profile to {profile.relative_to(root)}; edit it to say who you are")


def key_saved(provider_id=None):
    try:
        return subprocess.run(["/usr/bin/security", "find-generic-password", "-s",
                               keychain_service(provider_id or provider())],
                              capture_output=True, timeout=20).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def save_key(a):
    p = provider(); spec = PROVIDERS[p]
    key = (os.environ.get("SOV_CURATOR_KEY") or sys.stdin.readline()).strip()
    if (spec["prefix"] and not key.startswith(spec["prefix"])) or len(key) < spec["minlen"] \
            or any(c.isspace() for c in key):
        shape = f" (they start with {spec['prefix']})" if spec["prefix"] else ""
        print(f"That does not look like a {spec['name']} API key{shape}.", file=sys.stderr); return 65
    user = os.environ.get("USER") or "sovereign"
    r = subprocess.run(["/usr/bin/security", "add-generic-password", "-U", "-s", keychain_service(p), "-a", user,
                        "-l", f"Sovereign curator ({spec['name']})", "-w"],
                       input=f"{key}\n{key}\n", capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        print("The key could not be saved in the Keychain.", file=sys.stderr); return 1
    print("saved in the login Keychain"); return 0


def set_provider(a):
    refuse_on_hub()
    cur = provider()
    if not a.name:
        print(f"curator provider: {cur} ({PROVIDERS[cur]['name']})")
        for pid, spec in PROVIDERS.items():
            print(f"  {pid:10} {spec['name']}  key in Keychain: {'yes' if key_saved(pid) else 'no'}")
        return 0
    if a.name not in PROVIDERS:
        print(f"curator: unknown provider {a.name!r}; choose one of {', '.join(PROVIDERS)}", file=sys.stderr); return 65
    if a.name == cur:
        print(f"curator provider is already {cur} ({PROVIDERS[cur]['name']})"); return 0
    print(f"curator provider: {cur} -> {a.name} ({PROVIDERS[a.name]['name']})")
    print("  a new judge has not earned background landing: trust returns to ask-first")
    if not a.apply:
        print("dry run. add --apply to switch."); return 0
    STATE.mkdir(parents=True, exist_ok=True)
    atomic_json(PROVIDER_STATE, {"provider": a.name})
    atomic_json(TRUST_STATE, {"act_and_report": False})
    try:
        refresh_unit(vault())
    except SystemExit:
        pass  # no archive yet; the choice still stands for when one opens
    print("switched. save this provider's key with `sov curator key` if the Keychain has none.")
    return 0


def launchctl(*args):
    return subprocess.run([os.environ.get("SOV_LAUNCHCTL", "launchctl"), *args], capture_output=True, text=True)


def unit(root, every):
    u = {"Label": LABEL,
            "ProgramArguments": [python(), str(HERE / "curator-run"), "--max", "20"],
            "EnvironmentVariables": curator_env(root),
            "StartInterval": every, "RunAtLoad": True,
            "StandardOutPath": str(STATE / "curator.log"), "StandardErrorPath": str(STATE / "curator.error.log")}
    if "/Contents/Resources/runtime/bin/" in python():
        # listed as "Sovereign" in Login Items, not under the signing developer's name
        u["AssociatedBundleIdentifiers"] = ["com.sovereign.console"]
    return u


def enable(a):
    refuse_on_hub(); root = vault()
    body = plistlib.dumps(unit(root, a.every))
    print(f"curator: {root} every {a.every}s on {PROVIDERS[provider()]['name']} (key in Keychain: {'yes' if key_saved() else 'NOT YET'})")
    print(f"  job  {UNIT}")
    if not a.apply:
        print("dry run. add --apply to install."); return 0
    STATE.mkdir(parents=True, exist_ok=True); UNIT.parent.mkdir(parents=True, exist_ok=True)
    if UNIT.exists() and UNIT.read_bytes() == body and launchctl("print", f"gui/{os.getuid()}/{LABEL}").returncode == 0:
        print("already installed and loaded"); return 0
    seed_profile(root)
    UNIT.write_bytes(body)
    launchctl("bootout", f"gui/{os.getuid()}/{LABEL}")
    r = launchctl("bootstrap", f"gui/{os.getuid()}", str(UNIT))
    if r.returncode != 0:
        print(f"[launchd] bootstrap failed: {r.stderr.strip()}", file=sys.stderr); return 1
    print("installed; the first pass starts now"); return 0


def disable(a):
    print(f"curator: remove {UNIT}")
    if not a.apply:
        print("dry run. add --apply to remove."); return 0
    launchctl("bootout", f"gui/{os.getuid()}/{LABEL}")
    UNIT.unlink(missing_ok=True); print("removed"); return 0


def planned_gears(path):
    gears = {}
    if path.exists():
        gears = json.loads(path.read_text())
        if not isinstance(gears, dict):
            raise ValueError("gears.json is not a JSON object")
    for typ in TRUST_TYPES:
        rule = dict(gears.get(typ) or {})
        rule["auto_approve_confidence"] = list(TRUST_CONFIDENCE)
        rule["auto_approve_update_confidence"] = list(TRUST_CONFIDENCE)
        gears[typ] = rule
    return gears


def atomic_json(path, data):
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=1) + "\n")
    os.replace(tmp, path)


def trust_granted(path):
    try:
        gears = json.loads(path.read_text())
    except (OSError, ValueError):
        return False
    if not isinstance(gears, dict):
        return False
    for typ in TRUST_TYPES:
        rule = gears.get(typ)
        if not isinstance(rule, dict):
            return False
        for key in ("auto_approve_confidence", "auto_approve_update_confidence"):
            if set(rule.get(key) or ()) != set(TRUST_CONFIDENCE):
                return False
    return True


def _normal_confidence(value):
    value = str(value or "").strip().lower()
    return "med" if value == "medium" else value


def _type_from_detail(detail):
    m = re.search(r"knowledge/(entities|concepts|syntheses)/", detail or "")
    return {"entities": "entity", "concepts": "concept", "syntheses": "synthesis"}.get(
        m.group(1), "") if m else ""


def _type_from_card(path):
    try:
        head = path.read_text(encoding="utf-8", errors="replace")[:4096]
    except OSError:
        return ""
    m = re.search(r"(?m)^type:\s*['\"]?([A-Za-z0-9_-]+)", head)
    return m.group(1).lower() if m else ""


def _card_type(root, lane, slug, detail):
    for sub in ("entities", "concepts", "syntheses"):
        path = root / "knowledge" / sub / (slug + ".md")
        if path.is_file():
            return _type_from_card(path) or {"entities": "entity", "concepts": "concept",
                                             "syntheses": "synthesis"}[sub]
    rejected = lane / "rejected"
    try:
        candidates = sorted(rejected.glob(slug + "*.md"), key=lambda p: p.stat().st_mtime)
    except OSError:
        candidates = []
    for path in reversed(candidates):
        if path.stem == slug or path.stem.startswith(slug + "--rejected-"):
            return _type_from_card(path)
    return _type_from_detail(detail)


def trust_record(root, lane, now=None):
    """Read-only evidence for the app: whether trust is on, whether it is ready
    to offer, and what the gear landed recently. It grants nothing."""
    now = time.time() if now is None else now
    on = trust_on()
    granted = trust_granted(lane / "gears.json") if lane else False
    state = ("act-and-report" if on and granted else
             "incomplete" if on or granted else "ask-first")
    record = {"state": state, "eligible": False, "repair_needed": state == "incomplete",
              "clean_streak": 0, "threshold": TRUST_SUGGESTION_THRESHOLD,
              "routine_approved": 0, "routine_rejected": 0, "routine_retired": 0,
              "auto_landed_30d": 0, "auto_reverted_30d": 0, "recent_auto_landed": []}
    if not root or not lane:
        return record

    judgments = {}
    try:
        lines = (lane / "judgments.jsonl").read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        lines = []
    for seq, line in enumerate(lines):
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if not isinstance(row, dict) or row.get("promote") is not True:
            continue
        slug, at = row.get("slug"), parse_epoch(row.get("timestamp"))
        if not isinstance(slug, str) or at is None:
            continue
        judgments.setdefault(slug, []).append({
            "at": at, "seq": seq, "type": str(row.get("type") or "").strip().lower(),
            "confidence": _normal_confidence(row.get("confidence"))})
    judgment_times = {}
    for slug, rows in judgments.items():
        rows.sort(key=lambda r: (r["at"], r["seq"]))
        judgment_times[slug] = [r["at"] for r in rows]

    def judgment_for(slug, at):
        rows = judgments.get(slug) or []
        if not rows:
            return None
        if at is None:
            return rows[-1]
        pos = bisect.bisect_right(judgment_times[slug], at) - 1
        return rows[pos] if pos >= 0 else None

    try:
        decision_lines = (lane / "decisions.log").read_text(
            encoding="utf-8", errors="replace").splitlines()
    except OSError:
        decision_lines = []
    decisions = []
    for seq, line in enumerate(decision_lines):
        parts = line.rstrip("\n").split("\t")
        if len(parts) < 3:
            continue
        actor = parts[3].strip() if len(parts) >= 5 else "owner-cli"
        detail = parts[4] if len(parts) >= 5 else (parts[3] if len(parts) == 4 else "")
        decisions.append({"seq": seq, "ts": parts[0], "at": parse_epoch(parts[0]),
                          "verdict": parts[1].strip(), "slug": Path(parts[2]).stem,
                          "actor": actor, "detail": detail})
    decisions.sort(key=lambda r: (r["at"] is None, r["at"] or 0, r["seq"]))

    streak, landed, auto = set(), {}, {}
    for row in decisions:
        slug = row["slug"]
        judgment = judgment_for(slug, row["at"])
        typ = (judgment or {}).get("type") or _card_type(root, lane, slug, row["detail"])
        confidence = (judgment or {}).get("confidence", "")
        relevant = typ in TRUST_TYPES and confidence in TRUST_CONFIDENCE
        owner = row["actor"] not in AUTO_ACTORS
        if row["verdict"] == "approved":
            landed[slug] = {"relevant": relevant, "type": typ, "confidence": confidence}
            if row["actor"] == "auto-gear":
                auto[slug] = {**row, "type": typ, "confidence": confidence, "relevant": relevant}
            elif owner and relevant:
                record["routine_approved"] += 1
                streak.add(slug)
        elif owner and row["verdict"] == "rejected" and relevant:
            record["routine_rejected"] += 1
            streak.clear()
        elif owner and row["verdict"] == "retired":
            was = landed.pop(slug, None)
            if relevant or (was and was["relevant"]):
                record["routine_retired"] += 1
                streak.clear()

    since = now - TRUST_LANDED_WINDOW_S
    recent = []
    for slug, row in auto.items():
        if row["at"] is None or not since <= row["at"] <= now or not row["relevant"]:
            continue
        reverted = any(d["slug"] == slug and d["verdict"] == "retired" and
                       d["actor"] not in AUTO_ACTORS and d["seq"] > row["seq"]
                       for d in decisions)
        recent.append({"ts": row["ts"], "slug": slug, "type": row["type"],
                       "confidence": row["confidence"], "reverted": reverted,
                       "_seq": row["seq"]})
    recent.sort(key=lambda r: r["_seq"], reverse=True)
    record["auto_landed_30d"] = len(recent)
    record["auto_reverted_30d"] = sum(1 for r in recent if r["reverted"])
    record["recent_auto_landed"] = [{k: v for k, v in r.items() if k != "_seq"}
                                     for r in recent[:5]]
    record["clean_streak"] = len(streak)
    record["eligible"] = state == "ask-first" and len(streak) >= TRUST_SUGGESTION_THRESHOLD
    return record


def refresh_unit(root):
    if not UNIT.exists():
        print("  job  not installed yet; takes effect when the curator is enabled"); return
    try:
        every = int(plistlib.loads(UNIT.read_bytes()).get("StartInterval") or 7200)
    except Exception:
        every = 7200
    body = plistlib.dumps(unit(root, every))
    if UNIT.read_bytes() == body:
        return
    UNIT.write_bytes(body)
    if launchctl("print", f"gui/{os.getuid()}/{LABEL}").returncode == 0:
        launchctl("bootout", f"gui/{os.getuid()}/{LABEL}")
        launchctl("bootstrap", f"gui/{os.getuid()}", str(UNIT))
    print("  job  refreshed")


def trust(a):
    refuse_on_hub(); root = vault()
    lane = root / "raw" / "workspaces" / LANE
    gears_path = lane / "gears.json"
    if a.off:
        print("curator: back to ask-first; nothing lands without your approval")
        if not a.apply:
            print("dry run. add --apply to change."); return 0
        STATE.mkdir(parents=True, exist_ok=True)
        atomic_json(TRUST_STATE, {"act_and_report": False})
        refresh_unit(root)
        print("ask-first. gears.json is left in place; the zero cap disables it."); return 0
    try:
        gears = planned_gears(gears_path)
    except (OSError, ValueError) as e:
        print(f"curator: cannot read {gears_path}: {e}", file=sys.stderr); return 1
    current = None
    if gears_path.exists():
        try:
            current = json.loads(gears_path.read_text())
        except ValueError:
            current = None
    if trust_on() and current == gears:
        print("already trusted: routine concept and synthesis cards land on their own"); return 0
    print("curator: concept and synthesis cards at high and medium confidence, new and updates,")
    print(f"  land without waiting, at most {TRUST_CAP} per pass, each listed with its revert path")
    print("  still asking first: flagged items, entities, collisions, anything destructive")
    print("  auto-rejection stays off")
    print(f"  gears  {gears_path}")
    if not a.apply:
        print("dry run. add --apply to grant."); return 0
    lane.mkdir(parents=True, exist_ok=True); STATE.mkdir(parents=True, exist_ok=True)
    atomic_json(gears_path, gears)
    atomic_json(TRUST_STATE, {"act_and_report": True})
    refresh_unit(root)
    print("granted. undo any time with `sov curator trust --off --apply`."); return 0


def retire(a):
    refuse_on_hub(); root = vault()
    lane = root / "raw" / "workspaces" / LANE
    slug = a.slug.removesuffix(".md")
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,120}", slug):
        print("curator: that is not a card name Sovereign can retire", file=sys.stderr); return 65
    record = trust_record(root, lane)
    item = next((r for r in record["recent_auto_landed"] if r["slug"] == slug), None)
    if record["state"] != "act-and-report" or not item or item["reverted"]:
        print("curator: refused: only an unreverted recent background landing can be retired here",
              file=sys.stderr); return 1
    folder = {"concept": "concepts", "synthesis": "syntheses"}.get(item["type"])
    card = root / "knowledge" / folder / (slug + ".md") if folder else None
    if not card or not card.is_file():
        print(f"curator: refused: trusted card not found for {slug}", file=sys.stderr); return 1
    print(f"curator: retire {card.relative_to(root)}; it moves to the curator's rejected archive")
    if not a.apply:
        print("dry run. add --apply to retire."); return 0
    env = dict(os.environ, SOVS_VAULT=str(root), CURATOR_LANE=LANE,
               CURATOR_ACTOR="console-owner")
    try:
        r = subprocess.run(["/bin/bash", str(HERE / "curator-retire.sh"), slug,
                            "Owner reverted background landing in Sovereign"],
                           env=env, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"curator: retirement could not run: {e}", file=sys.stderr); return 1
    if r.stdout.strip():
        print(r.stdout.strip())
    if r.returncode != 0:
        print((r.stderr or r.stdout).strip() or "curator: retirement failed", file=sys.stderr)
    return r.returncode


def run(a):
    refuse_on_hub(); root = vault(); seed_profile(root)
    env = dict(os.environ, **curator_env(root))
    # "Curate now" means now: pull what the connected tools saved since their last tick
    # (the runner's cadence is 15 minutes) before judging, so a note made a minute ago counts.
    if (STATE / "connectors.json").exists():
        subprocess.run([python(), str(HERE / "sov-connectors-run"), "--force"], env=env,
                       stdout=subprocess.DEVNULL, timeout=600)
    return subprocess.run([python(), str(HERE / "curator-run"), "--max", "20"], env=env).returncode


def status(a):
    root = None
    try:
        root = vault()
    except SystemExit:
        pass
    lane = root / "raw" / "workspaces" / LANE if root else None
    last = None
    if lane and (lane / "status.json").exists():
        try:
            last = json.loads((lane / "status.json").read_text())
        except ValueError:
            last = None
    hub = Path("~/.sovereign-hub").expanduser().exists() or (STATE / "hub.json").exists()
    record = trust_record(root, lane)
    out = {"archive": str(root) if root else None, "hub": hub, "installed": UNIT.exists(),
           "loaded": launchctl("print", f"gui/{os.getuid()}/{LABEL}").returncode == 0,
           "key_saved": key_saved(), "model": provider(), "provider": provider(),
           "providers": [{"id": pid, "name": spec["name"], "hint": spec["hint"],
                          "key_saved": key_saved(pid)} for pid, spec in PROVIDERS.items()],
           "trust": record["state"], "trust_record": record, "last_run": last,
           "pending": len(list((lane / "proposals").glob("*.md"))) if lane and (lane / "proposals").is_dir() else 0}
    if a.json:
        print(json.dumps(out))
    else:
        for k, v in out.items():
            if k not in ("last_run", "trust_record"):
                print(f"{k:10} {v}")
        print(f"{'ready':10} {record['clean_streak']} of {record['threshold']} clean routine decisions"
              + ("; act-and-report can be offered" if record["eligible"] else ""))
    return 0


def main():
    ap = argparse.ArgumentParser(prog="sov curator", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    e = sub.add_parser("enable"); e.add_argument("--every", type=int, default=7200); e.add_argument("--apply", action="store_true")
    d = sub.add_parser("disable"); d.add_argument("--apply", action="store_true")
    sub.add_parser("run")
    t = sub.add_parser("trust"); t.add_argument("--off", action="store_true"); t.add_argument("--apply", action="store_true")
    r = sub.add_parser("retire"); r.add_argument("slug"); r.add_argument("--apply", action="store_true")
    pv = sub.add_parser("provider"); pv.add_argument("name", nargs="?"); pv.add_argument("--apply", action="store_true")
    sub.add_parser("key")
    s = sub.add_parser("status"); s.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if getattr(a, "every", 7200) < 600:
        sys.exit("--every must be at least 600 seconds")
    return {"enable": enable, "disable": disable, "run": run, "trust": trust,
            "retire": retire, "status": status, "key": save_key,
            "provider": set_provider}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
