        ("flagged source cannot auto-promote a new card", False,
         _decide_auto_promote_new("concept", "high", None, False, GN, 0, 5,
                                  screen_flagged=True, taste_flagged=False)),
        ("flagged source cannot auto-reject either", False,
         _decide_auto_reject("concept", "news-no-engagement", C, 0, 10,
                             screen_flagged=True, taste_flagged=False)),
        ("taste-flagged body cannot auto-promote an update", False,
         _decide_auto_promote("concept", "high", "card-a", "concept", G, 0, 5,
                              screen_flagged=False, taste_flagged=True)),
        ("taste-flagged body cannot auto-promote a new card", False,
         _decide_auto_promote_new("concept", "high", None, False, GN, 0, 5,
