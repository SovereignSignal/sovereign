        ("taste-flagged body cannot auto-promote a new synthesis", False,
         _decide_auto_promote_new("synthesis", "high", None, False, GN, 0, 5,
                                  screen_flagged=False, taste_flagged=True)),
        ("taste-flagged body cannot auto-reject either", False,
         _decide_auto_reject("concept", "news-no-engagement", C, 0, 10,
                             screen_flagged=False, taste_flagged=True)),
        # 2026-09-04 step-3 guards and the two new types
        ("update inside the 7-day cool-down is held for the owner", False,
         _decide_auto_promote("concept", "high", "card-a", "concept", G, 0, 5,
                              screen_flagged=False, taste_flagged=False, last_landed_days=2.5)),
        ("update after the cool-down proceeds", True,
         _decide_auto_promote("concept", "high", "card-a", "concept", G, 0, 5,
