#!/usr/bin/env python3
"""curator-run — one incremental curation pass (the Archivist's heartbeat).

Gathers raw/ and workstreams/ material changed since the last run, asks an LLM
whether each piece holds durable, reusable knowledge (default NO), drafts
validated candidate cards into the curator's lane, and writes a digest + status.

Proposer-first by design: this NEVER writes to knowledge/. A proposal becomes
trusted only when the owner runs curator-approve (the gate). Everything is logged.

Config via env (the mechanism is generic; the model/endpoint are swappable):
  SOVS_VAULT        vault root (default: cwd)
  CURATOR_LANE      lane name (default: curator; this brain: archivist)
  CURATOR_ENDPOINT  OpenAI-compatible chat endpoint (default: Ollama cloud)
  CURATOR_MODEL     model id (default: gpt-oss:120b)
  CURATOR_KEYFILE   file holding the API key (default: ~/.config/ollama-cloud/key)

Usage: curator-run [--since-days N] [--max N] [--dry]
"""
import os, re, json, glob, sys, time, argparse, hashlib, urllib.request
from datetime import datetime, timezone

VAULT = os.environ.get("SOVS_VAULT", os.getcwd())
LANE_NAME = os.environ.get("CURATOR_LANE", "curator")
LANE = os.path.join(VAULT, "raw", "workspaces", LANE_NAME)
PROP = os.path.join(LANE, "proposals"); INBOX = os.path.join(LANE, "INBOX.md")
STATUS = os.path.join(LANE, "status.json"); WM = os.path.join(LANE, ".last-run")
HASHSTORE = os.path.join(LANE, ".content-hashes.json")
JUDGMENTS = os.path.join(LANE, "judgments.jsonl")
K = os.path.join(VAULT, "knowledge")
ENDPOINT = os.environ.get("CURATOR_ENDPOINT", "https://ollama.com/v1/chat/completions")
MODEL = os.environ.get("CURATOR_MODEL", "gpt-oss:120b")
KEYFILE = os.environ.get("CURATOR_KEYFILE", os.path.expanduser("~/.config/ollama-cloud/key"))
# never-promote paths (vault-relative prefixes, colon-separated) — pruned from the gather entirely
EXCLUDE = [e.strip().strip("/") for e in os.environ.get("CURATOR_EXCLUDE", "").split(":") if e.strip()]
# optional owner profile injected into the judge prompt; the mechanism ships, the owner supplies the text
PROFILE = os.environ.get("CURATOR_PROFILE", os.path.join(LANE, "profile.md"))

ap = argparse.ArgumentParser()
ap.add_argument("--since-days", type=float, default=None, help="lookback window if no watermark")
ap.add_argument("--max", type=int, default=40, help="max new items to judge this run")
ap.add_argument("--dry", action="store_true", help="judge and report, write nothing")
ap.add_argument("--init", action="store_true", help="set the watermark to now (forward-only) and exit")
a = ap.parse_args()
os.makedirs(PROP, exist_ok=True)
if a.init:
    open(WM, "w").write(str(time.time()))
    print("curator-run: watermark set to now — forward-only. Only material arriving after this point will be judged.")
    raise SystemExit(0)

if a.since_days is not None:
    since = time.time() - a.since_days * 86400  # explicit window overrides watermark
elif os.path.exists(WM):
    since = float(open(WM).read().strip() or 0)
else:
    since = time.time() - 2 * 86400  # first-run default lookback

def _file_hash(path):
    """Fast content hash for change detection."""
    h = hashlib.md5()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(8192)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()

def _load_hashes():
    if os.path.exists(HASHSTORE):
        try:
            return json.load(open(HASHSTORE, encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            pass
    return {}

known_hashes = _load_hashes()

def _excerpt(path, limit=1200):
    try:
        txt = open(path, encoding="utf-8", errors="ignore").read(limit)
    except OSError:
        return ""
    return re.sub(r"\s+", " ", txt).strip()

def candidates():
    out, skipped_by_hash = [], 0
    for r in (os.path.join(VAULT, "raw"), os.path.join(VAULT, "workstreams")):
        for dp, dn, fn in os.walk(r):
            if LANE in dp or "/node_modules" in dp or "/.git" in dp or "/imports/" in dp:
                continue
            rel_dp = os.path.relpath(dp, VAULT)
            if any(rel_dp == e or rel_dp.startswith(e + "/") for e in EXCLUDE):
                dn[:] = []  # never-promote path: prune the whole subtree
                continue
            for f in fn:
                if f.startswith(".") or not f.endswith((".md", ".txt")):
                    continue
                p = os.path.join(dp, f)
                try:
                    if os.path.getmtime(p) <= since:
                        continue
                    # mtime changed — check if content actually changed
                    rel = os.path.relpath(p, VAULT)
                    ch = _file_hash(p)
                    if rel in known_hashes and known_hashes[rel] == ch:
                        skipped_by_hash += 1
                        continue  # sync re-touched the file, content identical
                    out.append(p)
                except OSError:
                    pass
    def rank(p):
        if "/workstreams/" in p: return 0
        if "/raw/tools/" in p: return 2
        return 1
    return sorted(out, key=lambda p: (rank(p), -os.path.getmtime(p))), skipped_by_hash

cands_all, skipped_by_hash = candidates()
cands = cands_all[: a.max]
have = {os.path.basename(p)[:-3] for p in glob.glob(K + "/**/*.md", recursive=True)}
pending = {os.path.basename(p)[:-3] for p in glob.glob(PROP + "/*.md")}
index = ", ".join(sorted(have))
KEY = open(KEYFILE).read().strip() if os.path.exists(KEYFILE) else os.environ.get("CURATOR_KEY", "")

_profile = ""
if os.path.exists(PROFILE):
    _profile = open(PROFILE, encoding="utf-8", errors="ignore").read().strip()

SYS = (
 "You are the curator of a plain-text knowledge brain. "
 "Your job: decide whether ONE piece of raw material holds DURABLE, REUSABLE knowledge "
 "worth a one-screen card. Write clear, factual card bodies.\n\n"
 + (f"WHO THE OWNER IS: {_profile}\n\n" if _profile else "")
 + "JUDGMENT: DEFAULT NO, bar is HIGH. Promote ONLY a SIGNIFICANT new entity, a genuinely "
 "NOVEL concept/mechanism/playbook, or a MAJOR status change. Generic orgs/funds/programs "
 "are NOT automatically card-worthy unless the owner has a direct relationship or it changes "
 "the owner's strategic landscape. When in doubt, do NOT promote.\n\n"
 "TYPES: an entity is ONE durable real thing \u2014 a person, org, place, or system. News items, "
 "events, rulings, announcements, and grant applications are NOT entities; if durable at all "
 "they are a concept (a pattern or mechanism) or an update_of an existing card. Usually SKIP.\n\n"
 "TABULAR / CRM SOURCES: in trackers, pipelines, and spreadsheets, fields like 'Owner' name "
 "the person responsible for the RECORD, never ownership of the organization. NEVER claim the "
 "owner founded, owns, or operates an org based on tracker fields. State only what the source "
 "supports; never invent relationships.\n\n"
 "The existing knowledge slugs already cover their topics: if an item is within or adjacent "
 "to a covered topic, default to update_of (extend it) or SKIP. "
 "Existing knowledge slugs (link with [[slug]]; never duplicate): " + index + ". "
 'Respond with ONE JSON object: {"promote":true|false,"reason":"<=20 words","type":"entity|concept|synthesis|null",'
 '"slug":"kebab-case","title":"","body":"factual prose, one screen, [[links]], NO markdown heading",'
 '"why":"1-2 sentences: why this matters to the owner\'s work, written for a future reader",'
 '"confidence":"high|med|low","update_of":"existing-slug or null"}. '
 "If promote is false the other fields may be empty. "
 'IMPORTANT: in body text, link brain topics with [[slug]] but NEVER wrap a URL in [[...]] '
 '\u2014 use plain URLs (e.g. https://example.com) and reserve [[...]] only for internal brain slugs.'
)

def judge(path):
    txt = open(path, encoding="utf-8", errors="ignore").read()[:6000]
    name = os.path.relpath(path, VAULT)
    payload = json.dumps({"model": MODEL, "temperature": 0.1, "stream": False,
        "response_format": {"type": "json_object"},
        "messages": [{"role": "system", "content": SYS},
                     {"role": "user", "content": f"SOURCE: {name}\n\n{txt}"}]}).encode()
    req = urllib.request.Request(ENDPOINT, payload, {"Authorization": f"Bearer {KEY}", "Content-Type": "application/json"})
    out = json.load(urllib.request.urlopen(req, timeout=150))["choices"][0]["message"]["content"]
    m = re.search(r"\{.*\}", out, re.S)
    return json.loads(m.group(0)) if m else None

proposals, judgments, judged = [], [], 0
_seen_this_run = set()
for p in cands:
    judged += 1
    src = os.path.relpath(p, VAULT)
    base_judgment = {
        "timestamp": datetime.now(timezone.utc).astimezone().isoformat(),
        "lane": LANE_NAME,
        "model": MODEL,
        "source": src,
        "hash": _file_hash(p),
        "mtime": os.path.getmtime(p),
        "excerpt": _excerpt(p),
    }
    try:
        v = judge(p)
    except Exception as exc:
        judgments.append({**base_judgment, "promote": None, "error": str(exc)[:500]})
        continue
    if not v or not v.get("promote"):
        judgments.append({**base_judgment, "promote": False, "reason": (v or {}).get("reason", "")})
        continue
    slug, typ = v.get("slug", ""), v.get("type", "")
    if not slug or typ not in ("entity", "concept", "synthesis"):
        judgments.append({**base_judgment, "promote": False, "reason": "invalid promote payload", "raw": v})
        continue
    judgments.append({**base_judgment, "promote": True,
                      "reason": v.get("reason", ""), "type": typ,
                      "slug": slug, "confidence": v.get("confidence", ""),
                      "update_of": v.get("update_of")})
    if slug in have or slug in pending:
        v["update_of"] = v.get("update_of") or slug
    # dedup against proposals already accepted this run (catches near-duplicate
    # slugs from different source files describing the same entity)
    slug_lower = slug.lower()
    seen_key = slug_lower.replace("-", "")
    if seen_key in _seen_this_run or any(seen_key in s for s in _seen_this_run):
        v["update_of"] = v.get("update_of") or slug
    _seen_this_run.add(seen_key)
    body = (v.get("body") or "").strip()
    why = (v.get("why") or "").strip() or (v.get("reason") or "").strip()
    if why:
        body = f"**Why this matters:** {why}\n\n{body}"
    card = (f"---\ntype: {typ}\nsource: {src}\ncreated: {datetime.now().strftime('%Y-%m-%d')}\n"
            f"title: {v.get('title', slug)}\n---\n\n# {v.get('title', slug)}\n\n{body}\n")
    proposals.append({**{k: v.get(k) for k in ("slug", "type", "title", "reason", "confidence", "update_of")},
                      "src": src, "card": card})

# Sovereign-inference law: a failed local run fails loudly, never silently.
# Errored files must be re-judged next run: hold the watermark below them and
# skip their content hashes so they re-enter the gather.
errored = [j for j in judgments if j.get("error")]
errored_srcs = {j["source"] for j in errored}

if not a.dry:
    if judgments:
        with open(JUDGMENTS, "a", encoding="utf-8") as jf:
            for row in judgments:
                jf.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
    for pr in proposals:
        open(os.path.join(PROP, pr["slug"] + ".md"), "w").write(pr["card"])
    lines = [f"# Archivist digest — {datetime.now().strftime('%Y-%m-%d %H:%M')}",
             f"_{len(proposals)} proposal(s) from {judged} new item(s). Approve: `curator-approve <slug>`  ·  drop: `curator-reject <slug>`._", ""]
    for pr in proposals:
        tag = "UPDATE " + pr["update_of"] if pr.get("update_of") else "new"
        lines.append(f"- **{pr['slug']}** ({pr['type']}, {pr['confidence']}, {tag}) — {pr['reason']}\n  from `{pr['src']}`")
    open(INBOX, "w").write("\n".join(lines) + "\n")
    json.dump({"generated_at": datetime.now(timezone.utc).astimezone().isoformat(), "lane": LANE_NAME,
               "judged": judged, "new_proposals": len(proposals),
               "errors": len(errored),
               "pending": len(glob.glob(PROP + "/*.md"))}, open(STATUS, "w"), indent=2)
    # hold the watermark below the oldest errored file so it re-enters next run
    wm_val = min(j["mtime"] for j in errored) - 1 if errored else time.time()
    open(WM, "w").write(str(wm_val))
    # record content hashes for files we judged so sync re-touches skip next time
    # (errored files excluded: no hash means they are re-judged, not hash-skipped)
    for p in cands:
        rel = os.path.relpath(p, VAULT)
        if rel in errored_srcs:
            continue
        try:
            known_hashes[rel] = _file_hash(p)
        except OSError:
            pass
    json.dump(known_hashes, open(HASHSTORE, "w", encoding="utf-8"), indent=2)

print(f"curator-run: judged {judged} new item(s), proposed {len(proposals)} card(s)"
      + (f", skipped {skipped_by_hash} sync re-touch(es)" if skipped_by_hash else "")
      + (" [DRY: nothing written]" if a.dry else ""))
for pr in proposals:
    u = f" [UPDATE {pr['update_of']}]" if pr.get("update_of") else ""
    print(f"  + {pr['slug']} ({pr['type']}, {pr['confidence']}){u}: {pr['reason']}")

if errored:
    print(f"curator-run: {len(errored)} of {judged} judgment(s) FAILED against {ENDPOINT}; "
          "watermark held so they re-enter next run", file=sys.stderr)
    if judged and len(errored) == judged:
        print("curator-run: ALL judgments failed — inference endpoint down? Exiting non-zero.", file=sys.stderr)
        sys.exit(2)
