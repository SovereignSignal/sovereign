    for name, want, got in link_cases:
        ok = got == want
        failed += 0 if ok else 1
        print(f"  {'PASS' if ok else 'FAIL'}  {name}" + ("" if ok else f"  (got {got!r})"))
    # NOTE 2026-08-20: the taste tables were run but left OUT of this sum, so the
    # printed score under-reported by the size of the taste table. Counted now.
    total = (len(wiring_cases) + len(screen_cases) + len(cases) + len(new_cases) + len(reject_cases)
             + len(veto_cases) + len(fn_cases) + len(link_cases)
             + len(taste_redact_cases) + len(taste_veto_cases) + len(guard_cases))
    print(f"curator-run --self-test: {total - failed}/{total} passed")
