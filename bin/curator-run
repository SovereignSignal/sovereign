        ok = got is want
        failed += 0 if ok else 1
        print(f"  {'PASS' if ok else 'FAIL'}  {name}" + ("" if ok else f"  (got {got}: {why})"))
    print(" both vetoes over BOTH gears (a flagged item goes to the owner, never to a gear):")
    veto_cases = [
        ("flagged source cannot auto-promote an update", False,
         _decide_auto_promote("concept", "high", "card-a", "concept", G, 0, 5,
