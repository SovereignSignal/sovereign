#!/bin/bash
# sov: one front door for the brain tools.
#
#   sov load <topic>              print the context pack for a topic (brain-load)
#   sov capture <slug> ...        stage a capture into your lane (brain-capture)
#   sov connect <harness> [...]   install a connector on this machine, both wires
#                                 (see connectors/harness/<harness>/install.sh; dry run
#                                 without --apply)
#   sov hook <harness>            run a harness's session-start hook here, for testing
#   sov status                    pointers, lanes on this machine, and their freshness
#   sov check                     validate the vault (brain-check)
#
# It routes; it does not reimplement. Instance data lives in pointer files
# (~/.brain-root, ~/.brain-core, ~/.brain-host, ~/.brain-lane), never here.
set -euo pipefail

SELF="$(/usr/bin/python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
BIN="$(dirname "$SELF")"
TEMPLATE="$(dirname "$BIN")"
HARNESS_DIR="$TEMPLATE/connectors/harness"

cmd="${1:-help}"; shift || true
case "$cmd" in
  load)     exec /usr/bin/python3 "$BIN/brain-load" "$@";;
  capture)  exec /usr/bin/python3 "$BIN/brain-capture" "$@";;
  check)    exec /bin/bash "$BIN/brain-check.sh" "$@";;
  connect)
    h="${1:-}"; shift || true
    [ -n "$h" ] || { echo "sov connect <harness>; available: $(ls "$HARNESS_DIR" | grep -v '^_' | tr '\n' ' ')"; exit 64; }
    [ -x "$HARNESS_DIR/$h/install.sh" ] || chmod +x "$HARNESS_DIR/$h/install.sh" 2>/dev/null || true
    exec /bin/bash "$HARNESS_DIR/$h/install.sh" "$@";;
  hook)
    h="${1:-}"; [ -n "$h" ] || { echo "sov hook <harness>"; exit 64; }
    hook="$(ls "$HARNESS_DIR/$h"/session-start.* 2>/dev/null | head -1)"
    [ -n "$hook" ] || { echo "no session-start hook for $h"; exit 66; }
    printf '{"cwd":"%s","session_id":"manual","source":"startup"}' "$PWD" | /usr/bin/python3 "$hook";;
  status)   exec /usr/bin/python3 "$BIN/brain-status" "$@";;
  help|-h|--help) sed -n '2,15p' "$SELF";;
  *) echo "sov: unknown command '$cmd'"; sed -n '2,15p' "$SELF"; exit 64;;
esac
