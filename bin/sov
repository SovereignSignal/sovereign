#!/bin/bash
# sov: one front door for the archive tools.
#
#   sov init <path> [name]      create a new Sovereign instance
#   sov load <topic>              print the context pack for a topic (sov-load)
#   sov capture <slug> ...        stage a capture into your lane (sov-capture)
#   sov connect <harness>|all    install a connector on this machine, both wires (all = every tool found)
#                                 (see connectors/harness/<harness>/install.sh; dry run
#                                 without --apply)
#   sov disconnect <harness>|all  undeclare a lane, retire its error log, and drop the
#                                 shared job when it was the last (dry run without
#                                 --apply; the lane stays, because raw/ is provenance)
#   sov relay add|remove|list     the directory pipes this machine's one mover carries
#                                 (add <path> [--name NAME] [--force]; remove <name>; list)
#   sov hook <harness>            run a harness's session-start hook here, for testing
#   sov hub install|status|run|key|recovery|snapshot|restore|activate
#                                install and recover a local Hub; preview before --apply
#   sov hub init|env|tick|jobs|kit|law
#                                the template-run hub: instance file, runner, jobs from the
#                                manifest, the rebuild kit, Part 1 drift (sov-hub)
#   sov ingest folder <path>    bring a folder of material into its own raw lane:
#                                 convert, redact, content-dedup, hand each file to
#                                 sov-capture. Dry plan unless --apply (sov-ingest)
#   sov about [--json]          explain this installation, offline and read-only
#   sov contribute <command>    assess, collect, deliver, or import selected work
#   sov status                    pointers, lanes on this machine, and their freshness
#   sov check                     validate the vault (sov-check)
#
# It routes; it does not reimplement. Instance data lives in pointer files
# (~/.brain-root, ~/.brain-core, ~/.brain-host, ~/.brain-lane), never here.
set -euo pipefail

# Resolve links before choosing Python, so a clean managed Hub uses its bundled runtime.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  DIR="$(cd "$(dirname "$SELF")" && pwd -P)"
  SELF="$(readlink "$SELF")"
  case "$SELF" in /*) ;; *) SELF="$DIR/$SELF";; esac
done
BIN="$(cd "$(dirname "$SELF")" && pwd -P)"
SELF="$BIN/$(basename "$SELF")"
TEMPLATE="$(dirname "$BIN")"
. "$BIN/_sov-python.sh"
. "$BIN/_sov-config.sh"
PYTHON="$(sov_python "$TEMPLATE")"
export SOV_PYTHON="$PYTHON"
HARNESS_DIR="$TEMPLATE/connectors/harness"

# The harnesses a person can actually name. The catalog folder holds its own README.md and
# the _lib every installer shares, and neither is connectable, so the list is built from the
# folders that carry an install.sh rather than from a bare `ls`.
_harness_ids() {
  local d id
  for d in "$HARNESS_DIR"/*/; do
    [ -d "$d" ] || continue
    id="$(basename "$d")"
    case "$id" in _*) continue;; esac
    [ -f "$d/install.sh" ] || continue
    printf '%s ' "$id"
  done
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  hub)
    # The template-run hub (instance file, runner, jobs, kit, law) lives in sov-hub; the
    # app-installed managed hub keeps its commands on sov-managed-hub.
    case "${1:-}" in
      init|env|tick|jobs|kit|kit-restore|law|retry) exec "$PYTHON" "$BIN/sov-hub" "$@";;
      *) exec "$PYTHON" "$BIN/sov-managed-hub" "$@";;
    esac;;
  init) exec /bin/bash "$BIN/sov-init" "$@";;
  about)    exec "$PYTHON" "$BIN/sov-about" "$@";;
  contribute) exec "$PYTHON" "$BIN/sov-contribute" "$@";;
  load)     "$PYTHON" "$BIN/sov-about" --read-enabled || { echo "Context reading is disabled for this client mode or invalid role configuration." >&2; exit 65; }; exec "$PYTHON" "$BIN/sov-load" "$@";;
  capture)  exec "$PYTHON" "$BIN/sov-capture" "$@";;
  ingest)   exec "$PYTHON" "$BIN/sov-ingest" "$@";;
  check)
    # The label check, then Part 1 drift when this machine runs a template hub (warns only).
    /bin/bash "$BIN/sov-check" "$@"; rc=$?
    if [ -f "${SOV_STATE_DIR:-$HOME/.local/state/sovereign}/hub.json" ]; then "$PYTHON" "$BIN/sov-hub" law || true; fi
    exit $rc;;
  connect)
    h="${1:-}"; shift || true
    [ -n "$h" ] || { echo "sov connect <harness>|all; available: $(_harness_ids)"; exit 64; }
    [[ "$h" =~ ^[a-z][a-z0-9-]*$ ]] || { echo "invalid harness" >&2; exit 64; }
    [ "$h" = "all" ] && exec "$PYTHON" "$HARNESS_DIR/_lib/connect-all.py" "$@"
    [ -x "$HARNESS_DIR/$h/install.sh" ] || chmod +x "$HARNESS_DIR/$h/install.sh" 2>/dev/null || true
    # a cloud pull (no detect paths) runs on the hub: route there from any other machine.
    # A declared secret travels on stdin, never on the remote command line.
    if [ -f "$HARNESS_DIR/$h/harness.json" ]; then
      cloud="$("$PYTHON" -c 'import json,sys; m=json.load(open(sys.argv[1])); print("cloud" if not m.get("detect") else "local"); print((m.get("secret") or {}).get("env") or "")' "$HARNESS_DIR/$h/harness.json" 2>/dev/null)"
      hub="$(_sov_pointer "$HOME/.brain-hub")"; hub_alias="${hub%%:*}"
      if [ "${cloud%%$'\n'*}" = "cloud" ] && [ -n "$hub_alias" ] && [ "$(_sov_pointer "$HOME/.brain-host")" != "$hub_alias" ]; then
        senv="${cloud#*$'\n'}"
        echo "routing to the hub ($hub_alias): $h is a cloud pull and runs there"
        if [ -n "$senv" ] && [ -n "${!senv:-}" ]; then
          exec sh -c 'printf "%s" "$1" | ssh -o BatchMode=yes "$2" "$3=\$(cat) ~/brain-bin/sov connect $4 $5"' _ "${!senv}" "$hub_alias" "$senv" "$h" "$(printf '%q ' "$@")"
        fi
        exec ssh -o BatchMode=yes "$hub_alias" "~/brain-bin/sov connect $h $(printf '%q ' "$@")"
      fi
    fi
    exec /bin/bash "$HARNESS_DIR/$h/install.sh" "$@";;
  disconnect)
    # connect's mirror: install.sh --disconnect undeclares the lane and drops the shared
    # job when it was the last. `all` walks the lanes this machine actually declares,
    # which is the manifest, not the catalog of harnesses that exist in the template.
    h="${1:-}"; shift || true
    [ -n "$h" ] || { echo "sov disconnect <harness>|all; available: $(_harness_ids)"; exit 64; }
    [[ "$h" =~ ^[a-z][a-z0-9-]*$ ]] || { echo "invalid harness" >&2; exit 64; }
    if [ "$h" = "all" ]; then
      . "$HARNESS_DIR/_lib/install-common.sh"
      sov_resolve_state
      rc=0; n=0
      while IFS= read -r lane; do
        [ -n "$lane" ] || continue
        [ -f "$HARNESS_DIR/$lane/install.sh" ] || { echo "declared lane '$lane' has no installer in this template; left alone" >&2; rc=64; continue; }
        n=$((n+1)); echo; echo "=== $lane ==="
        /bin/bash "$HARNESS_DIR/$lane/install.sh" --disconnect "$@" || rc=$?
      done < <(_sov_manifest_py get lane-ids)
      [ "$n" -gt 0 ] || echo "no lane is declared on this machine"
      exit "$rc"
    fi
    [ -x "$HARNESS_DIR/$h/install.sh" ] || chmod +x "$HARNESS_DIR/$h/install.sh" 2>/dev/null || true
    # Reuse cloud routing and credential-safe argument handling from connect.
    exec /bin/bash "$SELF" connect "$h" --disconnect "$@";;
  relay)
    # The directory pipes on this machine's one mover. No harness is named, so the vault
    # comes from the pointer file and the state paths resolve on their own; the work is
    # install-common's sov_relay_*, the same library every installer uses.
    sub="${1:-}"; shift || true
    . "$HARNESS_DIR/_lib/install-common.sh"
    VAULT="$(_pointer "$HOME/.brain-root")"; VAULT="${VAULT/#\~/$HOME}"
    [ -n "$VAULT" ] || { echo "no vault here: connect a tool first (sov connect <harness> --vault PATH --apply)"; exit 64; }
    [ -d "$VAULT/knowledge" ] || { echo "not an archive: $VAULT has no knowledge/ folder"; exit 66; }
    sov_resolve_state
    case "$sub" in
      add)
        p="${1:-}"; shift || true
        [ -n "$p" ] || { echo "usage: sov relay add <path> [--name NAME] [--force]" >&2; exit 64; }
        rname=""; rforce=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --name) rname="${2:-}"
                    [ -n "$rname" ] || { echo "usage: sov relay add <path> [--name NAME] [--force]" >&2; exit 64; }
                    shift 2;;
            --force) rforce=--force; shift;;
            *) echo "unknown option: $1" >&2; exit 64;;
          esac
        done
        sov_relay_add "$p" "$rname" "$rforce";;
      remove)
        rn="${1:-}"
        [ -n "$rn" ] || { echo "usage: sov relay remove <name>" >&2; exit 64; }
        sov_relay_remove "$rn";;
      list) sov_relay_list;;
      *) echo "usage: sov relay add <path> [--name NAME] | remove <name> | list" >&2; exit 64;;
    esac;;
  hook)
    h="${1:-}"; [ -n "$h" ] || { echo "sov hook <harness>"; exit 64; }
    hook="$(ls "$HARNESS_DIR/$h"/session-start.* 2>/dev/null | head -1)"
    [ -n "$hook" ] || { echo "no session-start hook for $h"; exit 66; }
    printf '{"cwd":"%s","session_id":"manual","source":"startup"}' "$PWD" | "$PYTHON" "$hook";;
  status)   exec "$PYTHON" "$BIN/sov-status" "$@";;
  host)     # sov host add NAME ... : runs on the hub; from any other machine it is routed there
    sub="${1:-}"; shift || true
    [ "$sub" = "add" ] || { echo "sov host add NAME --user U --addr IP[,IP] [--identity I] [--workstreams a,b] [--apply]"; exit 64; }
    hub="$(_sov_pointer "$HOME/.brain-hub")"; hub_alias="${hub%%:*}"
    if [ -n "$hub_alias" ] && [ "$hub_alias" != "$(hostname -s)" ] && [ ! -f "$HOME/.brain-root" -o "$(_sov_pointer "$HOME/.brain-host")" != "$hub_alias" ]; then
      exec ssh -o BatchMode=yes "$hub_alias" "~/brain-bin/sov host add $(printf '%q ' "$@")"
    fi
    exec "$PYTHON" "$BIN/sov-host-add" "$@";;
  gate)
    # The owner's gate from a console or a shell: sov gate approve|reject <slug> [reason].
    # Runs the same deterministic scripts the Telegram poller and the gears use, as a
    # named actor, so the decisions log says who moved the card. Never --force.
    verb="${1:-}"; shift || true
    if [ -f "$HOME/.sovereign-hub" ] && { [ "$verb" = "approve" ] || [ "$verb" = "reject" ]; }; then
      proposal="${1:-}"; shift || true
      exec "$PYTHON" "$BIN/sov-managed-hub" run "$verb" --proposal "$proposal" --reason "$*" --apply
    fi
    export SOVS_VAULT="${SOVS_VAULT:-$(_sov_pointer "$HOME/.brain-root")}"
    if [ -z "${CURATOR_LANE:-}" ]; then
      st="$(ls "$SOVS_VAULT"/raw/workspaces/*/status.json 2>/dev/null | head -1)"
      CURATOR_LANE="$(basename "$(dirname "$st")")"
    fi
    export CURATOR_LANE CURATOR_ACTOR="${CURATOR_ACTOR:-console-owner}"
    case "$verb" in
      approve) exec /bin/bash "$BIN/curator-approve.sh" "$@";;
      reject)  exec /bin/bash "$BIN/curator-reject.sh" "$@";;
      *) echo "usage: sov gate approve|reject <slug> [reason]" >&2; exit 64;;
    esac;;
  help|-h|--help) sed -n '2,/^set -euo/{ /^set -euo/d; p; }' "$SELF";;
  *) echo "sov: unknown command '$cmd'"; sed -n '2,/^set -euo/{ /^set -euo/d; p; }' "$SELF"; exit 64;;
esac
