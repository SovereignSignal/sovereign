#!/usr/bin/env bash
# Nightly Archivist run: curate new raw on owned inference, deliver the digest.
#
# What this script's exit codes mean, because a tick that did nothing must not read as a
# tick that worked:
#   0   a pass ran
#   64  ARCHIVIST_PENDING_LIMIT is not a usable number (EX_USAGE)
#   75  the queue circuit breaker is open: the review queue is full, so nothing was
#       judged, on any lane, until the owner drains the gate (EX_TEMPFAIL; nothing is
#       broken, the work is paused). This is lib/sovereign_hub/runner.py's PAUSED_EXIT:
#       the runner keeps it in the receipt, withholds last-ok, and tells the owner once
#       rather than every two hours. The two numbers must stay equal.
# Anything else comes from curator-run: 3 = gave up waiting for the model lock after 4h,
# 4 = the sovereign-inference law refused the endpoint or model.
set -euo pipefail
export PATH="/opt/homebrew/bin:$PATH"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOV_TEMPLATE="${SOV_TEMPLATE:-$(cd "$HERE/../.." && pwd)}"; export SOV_TEMPLATE
STATE="${SOV_STATE_DIR:-$HOME/.local/state/sovereign}"
# Settings come from the instance file. The runner exports them; a hand run asks the front door.
[ -n "${SOVS_VAULT:-}" ] || eval "$(/bin/bash "$SOV_TEMPLATE/bin/sov" hub env)"
# Notion: opened selectively 2026-08-13. The lane holds ~17k exported files; the
# bulk below stays pruned and the rest (the owner's top-level pages,
# ENS MetaGov Term 7, Cardano Funding Assessment ~ 457 files) is now curated.

# Per-run auto-promote cap. This script serves two callers: the 06:00 nightly, which
# exports 12 before invoking it, and the 2-hourly curate tick (owner decision
# 2026-09-21), which does not. The tick's cap is hub.json curate_auto_promote_max
# (exported as SOV_CURATE_AUTO_PROMOTE_MAX, default 4), a name of its own so that
# changing the tick can never move the nightly or the burndown, which read
# ARCHIVIST_AUTO_PROMOTE_MAX when it is set.
: "${ARCHIVIST_AUTO_PROMOTE_MAX:=${SOV_CURATE_AUTO_PROMOTE_MAX:-4}}"
export ARCHIVIST_AUTO_PROMOTE_MAX

pending_limit="${ARCHIVIST_PENDING_LIMIT:-50}"
if ! [[ "$pending_limit" =~ ^[0-9]+$ ]] || (( pending_limit < 1 )); then
  printf 'archivist-nightly: invalid ARCHIVIST_PENDING_LIMIT=%q\n' "$pending_limit" >&2
  exit 64
fi

shopt -s nullglob
pending_cards=("$SOVS_VAULT/raw/workspaces/$CURATOR_LANE/proposals"/*.md)
pending_count=${#pending_cards[@]}
if (( pending_count >= pending_limit )); then
  printf 'curator-run: queue circuit breaker open: %d pending >= limit %d; no new sources judged\n' \
    "$pending_count" "$pending_limit"
  exit 75
fi

# curator-run's own shebang is `#!/usr/bin/env python3`, which on a Mac finds the Xcode
# shim: after an Xcode update that refuses to run until someone accepts the license, and
# a scheduled job that names it fails every tick, silently. Name the interpreter the
# resolver picks instead: the same one every rendered launchd job already uses.
. "$SOV_TEMPLATE/bin/_sov-python.sh"
exec "$(sov_python "$SOV_TEMPLATE")" "$SOV_TEMPLATE/bin/curator-run" --max 50
