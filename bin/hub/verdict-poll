        check("split: corrupt meta -> inbox only",
              split_screened(["a", "b", "c"]) == (["a", "b"], ["c"]))
    finally:
        META_FILE, INBOX_FILE = _meta_save, _inbox_save

    # --- taste hold-back (approve-all holds taste-flagged proposals too) ---
    global PROPOSALS_DIR
    _meta_save, _inbox_save, _prop_save = META_FILE, INBOX_FILE, PROPOSALS_DIR
    try:
        META_FILE = os.path.join(tmpdir, "tmeta.json")
        INBOX_FILE = os.path.join(tmpdir, "TINBOX.md")
        PROPOSALS_DIR = os.path.join(tmpdir, "proposals")
        os.makedirs(PROPOSALS_DIR, exist_ok=True)
        order = ["clean-card", "wallet-card", "screened-card", "both-card"]
        for slug in order:
            with open(os.path.join(PROPOSALS_DIR, slug + ".md"), "w") as f:
                f.write("---\ntype: concept\nsource: sov\n---\nbody\n")
        with open(META_FILE, "w") as f:
            json.dump({
                "clean-card": {"confidence": "high", "screen_flagged": False,
                               "taste_flagged": False, "taste_reason": ""},
                "wallet-card": {"confidence": "high", "screen_flagged": False,
                                "taste_flagged": True,
                                "taste_reason": "taste veto: evm wallet address"},
                "screened-card": {"confidence": "high", "screen_flagged": True,
                                  "taste_flagged": False, "taste_reason": ""},
                "both-card": {"confidence": "med", "screen_flagged": True,
                              "taste_flagged": True,
                              "taste_reason": "taste veto: private money figure"},
            }, f)
        with open(INBOX_FILE, "w") as f:
            f.write("- **clean-card** (concept, high, new) — nothing tripped\n")
        flags = hold_flags()
        check("taste: unflagged stays in the bulk path",
              split_screened(["clean-card"], flags) == (["clean-card"], []))
        check("taste: taste-flagged excluded from bulk",
              split_screened(["clean-card", "wallet-card"], flags)
              == (["clean-card"], ["wallet-card"]))
        check("taste: screen-flagged excluded from bulk",
              split_screened(["clean-card", "screened-card"], flags)
              == (["clean-card"], ["screened-card"]))
        check("taste: both kinds excluded together, order kept",
              split_screened(order, flags)
              == (["clean-card"], ["wallet-card", "screened-card", "both-card"]))
        check("taste: reason names the rule that fired",
              flags.get("wallet-card") == "taste: evm wallet address")
        check("taste: screen reason label",
              flags.get("screened-card") == SCREEN_LABEL)
        check("taste: a doubly-flagged card names both reasons",
              flags.get("both-card")
              == "injection screen + taste: private money figure")
        check("taste: clean card carries no flag", "clean-card" not in flags)
        check(
            "taste: held summary counts each reason in one line",
            held_summary(["screened-card", "wallet-card"], flags)
            == "held 2 (1 injection screen, 1 taste: evm wallet address) — "
               "review with the Review cards button or approve by slug",
        )
        check("taste: held lines carry the releasing verdict",
              held_lines(["wallet-card"], flags)[1]
              == "HELD wallet-card: taste: evm wallet address — read it, "
                 "then: approve wallet-card")
        check("taste: nothing held -> no lines", held_lines([], flags) == [])
        # per-card render (Review cards): the flag is visible BEFORE the button
        check("taste: card render leads with the taste flag",
              card_text("wallet-card", flags).startswith(
                  "⚠ FLAGGED (taste: evm wallet address)\n<b>wallet-card</b>"))
        check("taste: card render leads with the screen flag",
              card_text("screened-card", flags).startswith(
                  "⚠ FLAGGED (injection screen)\n<b>screened-card</b>"))
        check("taste: unflagged card render has no flag line",
              "FLAGGED" not in card_text("clean-card", flags)
              and card_text("clean-card", flags).startswith(
                  "<b>clean-card</b> (concept, high)"))
        # holding back is about the BULK path only
        v_one, _ = parse_verdicts("approve wallet-card")
        check(
            "taste: single-slug approve of a flagged item still permitted",
            v_one == [("approve", "wallet-card", "")]
            and resolve_slug("wallet-card", {}, {"wallet-card"}) == "wallet-card"
            and "wallet-card" in flags,
        )
        # digest fallback for proposals judged before the fields were persisted
        with open(META_FILE, "w") as f:
            f.write("{not json")
        with open(INBOX_FILE, "w") as f:
            f.write("- **legacy-taste** (concept, high, new) ⚠ TASTE — old row\n"
                    "- **legacy-both** (concept, high, new) ⚠ SCREENED ⚠ TASTE — old\n"
                    "- **legacy-clean** (concept, high, new) — clean line\n")
        legacy = hold_flags()
        check("taste: inbox ⚠ TASTE fallback held",
              legacy.get("legacy-taste") == "taste veto")
        check("taste: inbox both marks -> both reasons",
              legacy.get("legacy-both") == "injection screen + taste veto")
        check("taste: inbox clean line not held", "legacy-clean" not in legacy)
    finally:
        META_FILE, INBOX_FILE = _meta_save, _inbox_save
        PROPOSALS_DIR = _prop_save

    # --- knowledge_paths (revert resolves a slug to exactly one card) ---
    global VAULT, KNOWLEDGE_DIR
    _vault_save, _kd_save = VAULT, KNOWLEDGE_DIR
    try:
        VAULT = os.path.join(tmpdir, "vault")
        KNOWLEDGE_DIR = os.path.join(VAULT, "knowledge")
        for sub in KNOWLEDGE_SUBS:
            os.makedirs(os.path.join(KNOWLEDGE_DIR, sub), exist_ok=True)
        check("knowledge_paths: missing slug -> []", knowledge_paths("nope") == [])
        with open(os.path.join(KNOWLEDGE_DIR, "concepts", "one-card.md"), "w") as f:
            f.write("---\ntype: concept\nsource: sov\n---\n")
        check(
            "knowledge_paths: single match",
            knowledge_paths("one-card") == ["knowledge/concepts/one-card.md"],
        )
        with open(os.path.join(KNOWLEDGE_DIR, "entities", "one-card.md"), "w") as f:
            f.write("---\ntype: entity\nsource: sov\n---\n")
        check("knowledge_paths: ambiguous slug -> 2", len(knowledge_paths("one-card")) == 2)
    finally:
        VAULT, KNOWLEDGE_DIR = _vault_save, _kd_save

    # --- Sovereign transition (2026-09-11): no Telegram route runs a gate ---
    g = globals()
    saved = {k: g[k] for k in ("run_gate", "run_revert", "send_reply",
                                "edit_or_reply", "answer_callback",
                                "pending_slugs", "hold_flags", "cbmap_load")}
    gate_calls, revert_calls, out = [], [], []
    g["run_gate"] = lambda verb, slug, reason: gate_calls.append((verb, slug)) or "landed: x"
    g["run_revert"] = lambda slug, reason: revert_calls.append(slug) or "retired: x"
    g["send_reply"] = lambda t, c, text, reply_markup=None, parse_mode=None: out.append((text, reply_markup))
    g["edit_or_reply"] = lambda t, c, m, text: out.append((text, None))
    g["answer_callback"] = lambda t, i, text=None: None
    g["pending_slugs"] = lambda: ["p-one", "p-two"]
    g["hold_flags"] = lambda: {}
    g["cbmap_load"] = lambda path=None: {"c1": "p-one"}
    owner = "394395765"
    try:
        def tmsg(text):
            return {"message": {"chat": {"id": 394395765}, "from": {"id": 394395765}, "text": text}}
        def tcb(data):
            return {"callback_query": {"id": "1", "from": {"id": 394395765}, "data": data,
                                       "message": {"message_id": 5, "date": int(time.time())}}}
        for text in ("approve p-one", "reject p-one too thin", "approve p-one\nreject p-two",
                     "approved", "approve all", "approve as recommended", "ok"):
            out.clear(); used = handle_update(tmsg(text), "tok", owner, MAX_VERDICTS)
            check("text %r runs no gate" % text, used == 0 and not gate_calls)
            check("text %r points at Sovereign" % text, out and "Sovereign" in out[-1][0])
        for data in ("aap", "aapc", "a:p-one", "r:p-one", "a:c1", "r:c1"):
            out.clear(); used = handle_update(tcb(data), "tok", owner, MAX_VERDICTS)
            check("callback %r runs no gate" % data, used == 0 and not gate_calls)
            check("callback %r points at Sovereign" % data, out and "Sovereign" in out[-1][0])
        out.clear(); handle_update(tcb("rev"), "tok", owner, MAX_VERDICTS)
        check("callback rev sends no buttons", out and all(m is None for _, m in out))
        check("callback rev points at Sovereign", out and "Sovereign" in out[-1][0])
        out.clear(); handle_update(tcb("aapx"), "tok", owner, MAX_VERDICTS)
        check("callback aapx still cancels", out and out[-1][0] == "Cancelled.")
        out.clear(); used = handle_update(tmsg("revert p-one my reason"), "tok", owner, MAX_VERDICTS)
        check("revert still runs the audited retire path", used == 1 and revert_calls == ["p-one"] and not gate_calls)
        out.clear(); used = handle_update({"message": {"chat": {"id": 1}, "from": {"id": 1}, "text": "approve p-one"}}, "tok", owner, MAX_VERDICTS)
        check("non-owner text still silent", used == 0 and not out and not gate_calls)
    finally:
        g.update(saved)

    print("%d checks, %d failures" % (total[0], len(failures)))
    return 1 if failures else 0


def main():
    if "--self-test" in sys.argv[1:]:
        return self_test()
    try:
        return poll()
    except Exception:
        tb = traceback.format_exc().strip().splitlines()[-1]
        log("RUN ERROR (offset preserved): %s" % tb)
        print("run error: %s" % tb, file=sys.stderr)
        return 0


if __name__ == "__main__":
    sys.exit(main())
