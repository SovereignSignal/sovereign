#!/usr/bin/env bash
# vault-secret-scan.sh <file-list>
#
# Credential gate for anything about to enter the sovs-brain git history.
# Reads a newline-separated list of vault-relative paths on argv[1] (cwd must
# be the vault), prints every hit, and exits nonzero if ANY hit is found.
# Nonzero here means: do not commit. There is no override flag on purpose.
#
# Two checks:
#   1. filenames that conventionally hold credentials (.env, *.pem, id_rsa, ...)
#   2. file contents against known credential shapes
#
# Patterns are deliberately tight (fixed-alphabet runs, not "sk-" + anything)
# so ordinary prose like "cross-prime-risk-announcement-path" does not trip it.
set -uo pipefail

LIST="${1:?usage: vault-secret-scan.sh <file-list>}"

# The token must start at a word boundary: a title ending in "sk" followed by
# a document ID is a link, not an API key. Punctuation still admits real keys.
CONTENT_PAT='(^|[^[:alnum:]_])sk-(proj-|ant-|svcacct-|or-)?[A-Za-z0-9]{24,}'
CONTENT_PAT="$CONTENT_PAT"'|gh[pousr]_[A-Za-z0-9]{30,}'
CONTENT_PAT="$CONTENT_PAT"'|github_pat_[A-Za-z0-9_]{40,}'
CONTENT_PAT="$CONTENT_PAT"'|A(KIA|SIA)[0-9A-Z]{16}'
CONTENT_PAT="$CONTENT_PAT"'|xox[baprse]-[0-9A-Za-z]{8,}-[0-9A-Za-z-]{8,}'
CONTENT_PAT="$CONTENT_PAT"'|-----BEGIN [A-Z ]*PRIVATE KEY-----'
CONTENT_PAT="$CONTENT_PAT"'|(postgres|postgresql|mysql|mongodb|mongodb\+srv|redis|rediss|amqp)://[A-Za-z0-9_.%-]+:[^@[:space:]/]{6,}@'
CONTENT_PAT="$CONTENT_PAT"'|AIza[0-9A-Za-z_-]{35}'
CONTENT_PAT="$CONTENT_PAT"'|glpat-[A-Za-z0-9_-]{20,}'
CONTENT_PAT="$CONTENT_PAT"'|xai-[A-Za-z0-9]{40,}'
CONTENT_PAT="$CONTENT_PAT"'|pplx-[A-Za-z0-9]{40,}'
CONTENT_PAT="$CONTENT_PAT"'|hf_[A-Za-z0-9]{34,}'
CONTENT_PAT="$CONTENT_PAT"'|fc-[a-f0-9]{32}'
CONTENT_PAT="$CONTENT_PAT"'|[0-9]{9,10}:AA[A-Za-z0-9_-]{33}'

NAME_PAT='(^|/)\.env($|\.|/)'
NAME_PAT="$NAME_PAT"'|(^|/)[^/]*(secrets?|credentials?)[^/]*\.(env|json|txt|ya?ml|sh|bash|zsh|conf|cfg|ini|toml|properties|csv)$'
NAME_PAT="$NAME_PAT"'|(^|/)[^/.]*(secrets?|credentials?)[^/.]*$'
NAME_PAT="$NAME_PAT"'|\.(pem|p12|pfx|key|jks|keystore)$'
NAME_PAT="$NAME_PAT"'|(^|/)id_(rsa|dsa|ecdsa|ed25519)($|\.)'
NAME_PAT="$NAME_PAT"'|(^|/)(\.netrc|\.npmrc|\.pgpass|\.htpasswd)$'
NAME_PAT="$NAME_PAT"'|(^|/)(api[_-])?tokens?\.(json|txt|env|yaml|yml)$'
NAME_PAT="$NAME_PAT"'|(^|/)\.?token$'

# Matches that are obviously documentation placeholders, not live credentials
# (e.g. the postgres://user:password@host line in a .env.example code block).
PLACEHOLDER_PAT='://(user|username|USER|USERNAME|myuser|dbuser|<[^>]*>|\$\{?[A-Za-z_]+\}?):(password|passwd|pass|PASSWORD|changeme|change-me|secret|xxx+|X+|\*+|<[^>]*>|\$\{?[A-Za-z_]+\}?)@'

fails=0
[ -f "$LIST" ] && [ -r "$LIST" ] || { echo 'secret-scan: file list cannot be read' >&2; exit 2; }

echo "=== FILENAME HITS ==="
if grep -Ei "$NAME_PAT" "$LIST"; then
  fails=$((fails + 1))
else
  echo "(none)"
fi

echo
echo "=== CONTENT HITS ==="
n=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  # Missing tracked files are deletions. Existing unreadable/special paths are
  # uncertainty, never proof that there are no credentials.
  [ -e "$f" ] || { [ ! -L "$f" ] && continue; }
  if [ ! -f "$f" ] || [ ! -r "$f" ]; then
    echo "secret-scan: cannot read $f" >&2
    fails=$((fails + 1)); continue
  fi
  # line numbers and a redacted shape only: this output travels into an alert channel
  matches="$(LC_ALL=C grep -aoEn "$CONTENT_PAT" -- "$f" 2>/dev/null)"
  scan_rc=$?
  if [ "$scan_rc" -gt 1 ]; then
    echo "secret-scan: cannot scan $f" >&2
    fails=$((fails + 1)); continue
  fi
  found="$(printf '%s\n' "$matches" | LC_ALL=C grep -avE "$PLACEHOLDER_PAT" \
           | LC_ALL=C sed -E 's/^([0-9]+:)(.{4}).*(.{2})$/\1\2…\3 [redacted]/')"
  if [ -n "$found" ]; then
    n=$((n + 1))
    echo "--- $f"
    printf '%s\n' "$found" | head -3
  fi
done < "$LIST"
[ "$n" -eq 0 ] && echo "(none)"
[ "$n" -eq 0 ] || fails=$((fails + 1))

echo
echo "=== SUMMARY: files with content hits: $n ==="

[ "$fails" -eq 0 ] || exit 1
exit 0
