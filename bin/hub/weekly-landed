MAX_TG_CARDS = 15           # landed names listed in the Telegram message
MAX_TABLE_ROWS = 60         # rows per Notion table block (request size guard)
MAX_LIST_PER_GROUP = 40     # slugs listed inside one owner-actions toggle
WHY_MAX = 240               # chars of "Why this matters" kept for the table


# --------------------------------------------------------------------------
# text hygiene
# --------------------------------------------------------------------------

def plain(text):
    """Normalize quoted card text for the report.

    Owner's rule: no em dashes anywhere. Card bodies (written by the judging
    model) carry em dashes, en dashes, non-breaking hyphens and curly quotes,
    so they are flattened here rather than trusted.
    """
    if not text:
        return ""
    out = str(text)
    out = out.replace("—", ", ").replace("–", ", ")
    out = out.replace("‑", "-").replace("‐", "-").replace("−", "-")
    out = out.replace("‘", "'").replace("’", "'")
    out = out.replace("“", '"').replace("”", '"')
    out = out.replace("…", "...").replace(" ", " ")
    out = re.sub(r"\s*,\s*,\s*", ", ", out)
    return re.sub(r"[ \t]+", " ", out).strip()


def html_escape(s):
    """Escape &, <, > for Telegram parse_mode=HTML (order matters: & first)."""
    return (s or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def clip(text, limit):
    text = text or ""
    return text if len(text) <= limit else text[: limit - 3].rstrip() + "..."


# --------------------------------------------------------------------------
# decisions.log
# --------------------------------------------------------------------------

def parse_ts(raw):
    """Parse '2026-08-10T08:14:14-0700'. Python 3.9's fromisoformat wants the
    offset punctuated, so the colon is inserted before handing it over."""
    raw = (raw or "").strip()
    m = re.match(r"^(.*[T ]\d{2}:\d{2}:\d{2})([+-]\d{2})(\d{2})$", raw)
    if m:
        raw = "%s%s:%s" % m.groups()
    try:
        return datetime.fromisoformat(raw)
    except ValueError:
        return None


def read_decisions(since):
    """Rows at or after `since`, newest last. Raises OSError if unreadable.

    Format (TSV, append-only): ts, verdict, file, actor, detail.
    Rows written before the actor column existed have 4 fields; those predate
    any 7-day window we report on, but they are handled rather than dropped.
    """
    rows = []
    with open(DECISIONS, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line.strip():
                continue
            parts = line.split("\t")
            if len(parts) < 3:
                continue
            ts = parse_ts(parts[0])
            if ts is None or ts < since:
                continue
            if len(parts) >= 5:
                actor, detail = parts[3], parts[4]
            else:
                actor, detail = "owner-cli", parts[3] if len(parts) > 3 else ""
            rows.append(
                {
                    "ts": ts,
                    "verdict": parts[1].strip(),
                    "file": parts[2].strip(),
                    "slug": re.sub(r"\.md$", "", parts[2].strip()),
                    "actor": actor.strip(),
                    "detail": detail.strip(),
                }
            )
    return rows


# --------------------------------------------------------------------------
# vault reads
# --------------------------------------------------------------------------

def card_path(slug):
    """Path of the trusted card for a slug, or None when it is not (or no
    longer) in knowledge/."""
    for sub in KNOWLEDGE_SUBS:
        p = os.path.join(KNOWLEDGE, sub, slug + ".md")
        if os.path.isfile(p):
            return p
    return None


def parse_frontmatter(text):
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end == -1:
        return {}, text
    fm = {}
    for line in text[4:end].splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            fm[k.strip()] = v.strip().strip('"')
    return fm, text[end + 4 :].lstrip("\n")


def read_card(slug):
    """type, why-this-matters, source, path for a promoted slug."""
    info = {"type": "", "why": "", "source": "", "path": ""}
    p = card_path(slug)
    if not p:
        return info
    info["path"] = os.path.relpath(p, VAULT)
    try:
        text = open(p, encoding="utf-8", errors="replace").read()
    except OSError:
        return info
    fm, body = parse_frontmatter(text)
    info["type"] = fm.get("type", "")
    info["source"] = fm.get("source", "")
    why = ""
    for line in body.splitlines():
        stripped = line.strip()
        if stripped.lower().startswith("**why this matters:**"):
            why = stripped.split("**", 2)[-1].lstrip(":").strip()
            if not why:
                why = re.sub(r"(?i)^\*\*why this matters:\*\*", "", stripped).strip()
            break
    if not why:
        for chunk in body.split("\n\n"):
            chunk = chunk.strip()
            if chunk and not chunk.startswith("#"):
                why = chunk.splitlines()[0].strip()
                break
    info["why"] = plain(why)
    return info


def type_from_detail(detail):
    """'knowledge/concepts/x.md: ...' -> 'concept'."""
    m = re.search(r"knowledge/(entities|concepts|syntheses)/", detail or "")
    if not m:
        return ""
    return {"entities": "entity", "concepts": "concept", "syntheses": "synthesis"}[
        m.group(1)
    ]


def card_type(slug, detail):
    """A landed card's type label, read where the card is now: knowledge/ while it
    stands, the lane's rejected/ once reverted. Falls back to its folder."""
    for p in (card_path(slug), os.path.join(LANE_DIR, "rejected", slug + ".md")):
        if p and os.path.isfile(p):
            try:
                fm, _ = parse_frontmatter(open(p, encoding="utf-8", errors="replace").read())
            except OSError:
                continue
            if fm.get("type"):
                return fm["type"]
    return type_from_detail(detail) or "unknown"


def revert_rates(rows):
    """[(type, landed, reverted)] for the cards the gear landed in `rows`, where
    reverted means a later `retired` verdict on the same card. Owner approvals
    are not auto-landings and are not counted. Types with none are absent."""
    landed, retired = {}, {}
    for r in rows:
        if r["actor"] == AUTO_PROMOTE_ACTOR and r["verdict"] == "approved":
            landed.setdefault(r["slug"], r)
        elif r["verdict"] == REVERT_VERDICT:
            retired.setdefault(r["slug"], []).append(r["ts"])
    counts = {}
    for slug, r in landed.items():
        c = counts.setdefault(card_type(slug, r["detail"]), [0, 0])
        c[0] += 1
        if any(t > r["ts"] for t in retired.get(slug, ())):
            c[1] += 1
    return [(k, n, rev) for k, (n, rev) in sorted(counts.items())]


def revert_rate_lines(rates):
    return [
        "%s: %d landed, %d reverted (%d%%)" % (k, n, rev, round(100.0 * rev / n))
        for k, n, rev in rates
    ]


def git(*args):
    try:
        cp = subprocess.run(
            ["git", "-C", VAULT] + list(args),
            capture_output=True,
            text=True,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return cp.stdout if cp.returncode == 0 else ""


def promotion_commit(relpath, when):
    """Short hash of the commit that landed `relpath`.

    Picks the commit touching the path whose author date sits closest to the
    decision timestamp: correct for a brand new card AND for an update landing
    over an existing one (where --diff-filter=A would return the original add).
    Falls back to the first-add commit, then to empty.
    """
    if not relpath:
        return ""
    out = git("log", "--format=%h%x1f%aI", "--max-count=200", "--", relpath)
    best, best_delta = "", None
    for line in out.splitlines():
        if "\x1f" not in line:
            continue
        h, iso = line.split("\x1f", 1)
        ts = parse_ts(iso.strip())
        if ts is None:
            continue
        delta = abs((ts - when).total_seconds())
        if best_delta is None or delta < best_delta:
            best, best_delta = h.strip(), delta
    if best:
        return best
    return git(
        "log", "-1", "--format=%h", "--diff-filter=A", "--", relpath
    ).strip()


def queued_flagged():
    """Proposals the screen or the taste flagged that QUEUED instead of being
    acted on: still sitting in proposals/, waiting for Owner."""
    present = set()
    try:
        present = {
            f[:-3] for f in os.listdir(PROPOSALS_DIR) if f.endswith(".md")
        }
    except OSError:
        return []
    flagged = {}
    try:
        meta = json.load(open(META_FILE, encoding="utf-8"))
        if isinstance(meta, dict):
            for slug, entry in meta.items():
                if slug in present and isinstance(entry, dict) and entry.get(
                    "screen_flagged"
                ):
                    flagged[slug] = plain(
                        entry.get("screen_reason") or "source screen flagged"
                    )
    except (OSError, ValueError):
        pass
    try:
        for line in open(INBOX_FILE, encoding="utf-8", errors="replace"):
            if "SCREENED" not in line:
                continue
            m = re.match(r"^- \*\*(?P<slug>.+?)\*\*", line.strip())
            if m and m.group("slug") in present:
                flagged.setdefault(
                    m.group("slug"), plain(line.split("SCREENED", 1)[-1].strip(" -—"))
                    or "source screen flagged",
                )
    except OSError:
        pass
    return sorted(flagged.items())


def pending_now():
    try:
        return int(json.load(open(STATUS_FILE, encoding="utf-8")).get("pending") or 0)
    except (OSError, ValueError, TypeError):
        return 0


