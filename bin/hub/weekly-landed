def _read_pointer(path, default):
    try:
        with open(path) as f:
            return f.read().strip() or default
    except OSError:
        return default


VAULT = _read_pointer(
    os.path.join(HOME, ".brain-root"), os.environ.get("SOVS_VAULT", "")
)
LANE_NAME = _read_pointer(os.path.join(HOME, ".curator-lane"), "archivist")
LANE_DIR = os.path.join(VAULT, "raw", "workspaces", LANE_NAME)
DECISIONS = os.path.join(LANE_DIR, "decisions.log")
PROPOSALS_DIR = os.path.join(LANE_DIR, "proposals")
META_FILE = os.path.join(PROPOSALS_DIR, ".meta.json")
INBOX_FILE = os.path.join(LANE_DIR, "INBOX.md")
STATUS_FILE = os.path.join(LANE_DIR, "status.json")
KNOWLEDGE = os.path.join(VAULT, "knowledge")
KNOWLEDGE_SUBS = ("entities", "concepts", "syntheses")
TG_SEND = os.path.join(HOME, "brain-bin", "cron-wrappers", "tg-send.sh")

NOTION_VERSION = "2026-03-11"
