#!/usr/bin/env python3
"""Symlink-safe entry point for the read-only MCP server (lib/sovereign_mcp.py)."""
from pathlib import Path
import sys

repository = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(repository / "lib"))

from sovereign_mcp import main  # noqa: E402

raise SystemExit(main(sys.argv[1:]))
