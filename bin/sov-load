#!/usr/bin/env python3
"""sov-load — assemble a context pack for a topic from the knowledge graph.

Walks the knowledge/ layer from an entry card, following [[links]] a few hops,
adds the always-on core cards, and prints the concatenated pack to stdout. A
project session reads this at the start to begin pre-briefed on the relevant
slice of the archive, instead of the owner re-explaining context every time.

Usage:
  sov-load <entry-slug> [--depth N] [--core a,b,c] [--root PATH] [--max N]

Config (per instance, NOT hardcoded — the mechanism is generic, the answers are yours).
Vault root resolves in order: --root, $BRAIN_ROOT, $SOVS_VAULT, the ~/.brain-root
pointer file, an ancestor dir containing knowledge/, else the current dir. Core slugs
resolve in order: --core, $BRAIN_CORE, the ~/.brain-core pointer file. So an agent can
just type `sov-load <topic>` from anywhere once the pointer files exist.
  BRAIN_ROOT / SOVS_VAULT   vault root
  BRAIN_CORE                csv of always-on slugs loaded with every pack (identity, voice, etc.)

Example:
  BRAIN_ROOT=~/vault BRAIN_CORE=me,how-to-work-with-me sov-load some-topic
  # or drop the path in ~/.brain-root and the csv in ~/.brain-core so it just works
"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import sys, os, re, argparse, glob, json, shutil, subprocess
from collections import deque

# Ships EMPTY: the mechanism is generic, the answers are yours. Per-brain aliases
# (spoken names -> canonical card slugs, e.g. "curator" -> "curator-architecture")
# live in <vault>/.brain-aliases.json or ~/.brain-aliases.json, never in this script.
DEFAULT_ALIASES = {}

def _readfile(p):
    from sovereign_config import pointer as instance_pointer
    return instance_pointer(p)

def _resolve_root():
    env = os.environ.get("BRAIN_ROOT") or os.environ.get("SOVS_VAULT")
    if env:
        return os.path.expanduser(env)
    pin = _readfile("~/.brain-root")
    if pin:
        return os.path.expanduser(pin)
    d = os.getcwd()                              # walk up for an ancestor archive
    while True:
        if os.path.isdir(os.path.join(d, "knowledge")):
            return d
        nd = os.path.dirname(d)
        if nd == d:
            return os.getcwd()
        d = nd

def _load_aliases(root):
    aliases = dict(DEFAULT_ALIASES)
    for p in [os.path.join(root, ".brain-aliases.json"), "~/.brain-aliases.json"]:
        raw = _readfile(p)
        if not raw:
            continue
        try:
            aliases.update({str(k): str(v) for k, v in json.loads(raw).items()})
        except Exception as e:
            sys.stderr.write(f"sov-load: ignored invalid alias file {p}: {e}\n")
    return aliases

ap = argparse.ArgumentParser()
ap.add_argument("entry", help="entry-card slug to start the traversal from")
ap.add_argument("--depth", type=int, default=2, help="link hops to follow (default 2)")
ap.add_argument("--core", default=os.environ.get("BRAIN_CORE") or _readfile("~/.brain-core") or "", help="csv of always-on slugs")
ap.add_argument("--root", default=_resolve_root())
ap.add_argument("--max", type=int, default=25, help="cap on cards in the pack")
a = ap.parse_args()

K = os.path.join(a.root, "knowledge")
ALIASES = _load_aliases(a.root)
requested_entry = a.entry
entry = ALIASES.get(requested_entry, requested_entry)

def card_path(slug):
    r = glob.glob(os.path.join(K, "**", slug + ".md"), recursive=True)
    return r[0] if r else None


def _tokens(x):
    return [t for t in re.split(r"[^a-z0-9]+", x.lower()) if t]


def _best_slug(term, slugs):
    """Rank candidate slugs by how much of the term they cover. Every token of the term
    must appear, then prefer the shortest match, so a general card beats a narrower one."""
    want = set(_tokens(term))
    if not want:
        return None
    scored = []
    for sl in slugs:
        have = set(_tokens(sl))
        hit = len(want & have)
        if hit == len(want):
            scored.append((0, len(have), sl))
        elif len(want) > 2 and hit == len(want) - 1:
            scored.append((1, len(have), sl))
    return sorted(scored)[0][2] if scored else None


def _obsidian_cli():
    """An Obsidian CLI, if this machine has one. Optional by design: the archive's own
    retrieval is filenames and links, and any index on top is disposable."""
    for c in (shutil.which("obsidian"), "/Applications/Obsidian.app/Contents/MacOS/obsidian-cli"):
        if c and os.path.exists(c):
            return c
    return None


def resolve_entry(term, root):
    """Turn a spoken topic into a real card slug.

    Exact slug wins. Then a deterministic match against the slugs on disk, which needs no
    index and no running app. Only if both miss does it ask Obsidian to search the trusted
    layer. Fails soft everywhere: any error, timeout, or missing CLI leaves the term as-is
    and the caller reports a core-only pack.
    """
    if card_path(term):
        return term, None
    slugs = [os.path.basename(x)[:-3] for x in glob.glob(os.path.join(K, "**", "*.md"), recursive=True)]
    hit = _best_slug(term, slugs)
    if hit:
        return hit, "slug match"
    cli = _obsidian_cli()
    if not cli:
        return term, None
    try:
        out = subprocess.run([cli, "vault=" + os.path.basename(root), "search",
                              "query=" + " ".join(_tokens(term)), "path=knowledge",
                              "limit=12", "format=json"],
                             capture_output=True, text=True, timeout=12).stdout.strip()
        hits = json.loads(out) if out.startswith("[") else []
    except Exception:
        return term, None
    found = [os.path.basename(h)[:-3] for h in hits if h.endswith(".md")]
    hit = _best_slug(term, found)
    if hit and card_path(hit):
        return hit, "obsidian search"
    # a hit that does not cover the term is worse than none: the caller says core-only
    # rather than handing an agent a confidently wrong slice
    return term, None

def links_in(path):
    txt = open(path, encoding="utf-8", errors="ignore").read()
    return sorted(set(re.findall(r'\[\[([a-z0-9-]+)\]\]', txt)))

# an unknown topic gets one chance to resolve before we fall back to a core-only pack
entry, resolved_by = resolve_entry(entry, a.root)

# breadth-first from the entry, following links up to --depth hops
order, seen, q = [], set(), deque([(entry, 0)])
while q and len(order) < a.max:
    slug, d = q.popleft()
    if slug in seen:
        continue
    p = card_path(slug)
    if not p:
        continue
    seen.add(slug); order.append(slug)
    if d < a.depth:
        for l in links_in(p):
            if l not in seen:
                q.append((l, d + 1))

# always-on core (loaded with every pack)
for c in [s.strip() for s in a.core.split(",") if s.strip()]:
    if c not in seen and card_path(c):
        seen.add(c); order.append(c)

missing_entry = not card_path(entry)
if missing_entry:
    sys.stderr.write(f"sov-load: no knowledge card for entry '{requested_entry}'; output is core-only\n")
elif entry != requested_entry:
    via = f" via {resolved_by}" if resolved_by else ""
    sys.stderr.write(f"sov-load: '{requested_entry}' -> '{entry}'{via}\n")

shown_entry = requested_entry if entry == requested_entry else f"{requested_entry} -> {entry}"
print(f"# Archive context pack — {shown_entry}")
if missing_entry:
    print("_Entry card missing. This is a core-only fallback pack, not full topic context._\n")
else:
    print(f"_{len(order)} cards from the knowledge layer. Read this before working: "
          f"it is the relevant slice of the archive, pre-loaded, so you start with full context._\n")
loaded = []
for slug in order:
    p = card_path(slug)
    if p:
        print(open(p, encoding="utf-8", errors="ignore").read().rstrip())
        print("\n----\n")
        loaded.append(slug)
# The session hook's receipt names the cards a session actually got, so the app can show
# a card the owner approved reaching a session. Off-band: the pack itself is unchanged.
if os.environ.get("SOV_LOAD_CARDS_FILE"):
    try:
        with open(os.environ["SOV_LOAD_CARDS_FILE"], "w", encoding="utf-8") as f:
            f.write("\n".join(loaded) + "\n")
    except OSError as e:
        sys.stderr.write(f"sov-load: card list not written: {e}\n")
